{
  "name": "@ankole/applet-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./types": "./src/types.ts",
    "./records": "./src/records.ts",
    "./viz": "./src/viz.ts",
    "./toolkits": {
      "types": "./src/toolkits/index.d.ts"
    },
    "./toolkits/*": {
      "types": "./src/toolkits/*.d.ts"
    },
    "./server": {
      "types": "./src/server.ts"
    }
  },
  "scripts": {
    "type-check": "bun check --noEmit",
    "test": "bun test ./test",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "big.js": "7.0.1"
  },
  "devDependencies": {
    "@types/big.js": "7.0.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.107.1",
    "i18next": "27.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
