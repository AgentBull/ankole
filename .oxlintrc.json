{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/devkit/src/oxlint/anti-slop/index.ts"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "globals": {
    "Bun": "readonly"
  },
  "ignorePatterns": [
    ".agents/**",
    "app/agent_computer/src/core/codex-runner/generated/**",
    "app/agent_computer/src/fabric/generated/**",
    "app/webapps/**/generated/**",
    "app/kernel/spreadsheet-wasm/ankole_spreadsheet_wasm.d.ts",
    "app/kernel/word-wasm/ankole_word_wasm.d.ts",
    "app/kernel/presentation-wasm/ankole_presentation_wasm.d.ts"
  ],
  "rules": {
    "curly": ["error", "multi-line"],
    "prefer-const": "error",
    "prefer-template": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-cond-assign": ["error", "always"],
    "no-unused-expressions": ["error", { "allowTernary": true, "allowShortCircuit": true }],
    "no-unused-vars": ["error", { "caughtErrors": "none", "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/no-explicit-any": "off",
    "typescript/no-non-null-assertion": "off",
    "typescript/no-unnecessary-type-constraint": "warn",
    "typescript/triple-slash-reference": "off",
    "dot-notation": "off",
    "unicorn/no-array-for-each": "off",
    "unicorn/filename-case": ["warn", { "case": "kebabCase" }],
    "oxc/no-accumulating-spread": "error",
    "anti-slop/global-data": "error",
    "anti-slop/max-ternary-depth": ["error", { "maxDepth": 3 }],
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-disabled-type-assertion-rules": "error",
    "anti-slop/no-module-mocking": [
      "error",
      { "allowSpecifierPatterns": ["\\?(?:.*&)?(?:worker|url|raw|inline)(?:[&=]|$)"] }
    ],
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-test-code-in-src": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.bench.ts", "**/*.bench.tsx"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.bench.ts",
        "**/*.bench.tsx",
        "**/test/**",
        "**/tests/**",
        "**/__tests__/**",
        "**/integration/**",
        "**/e2e/**",
        "**/compat/**",
        "libs/ankole-editor/upstream/tests/**"
      ],
      "rules": {
        "anti-slop/no-chained-type-assertions": "off"
      }
    },
    {
      "files": ["tools/devkit/**"],
      "rules": {
        "no-console": "off",
        "anti-slop/no-test-code-in-src": ["error", { "allowTestFiles": true }]
      }
    },
    {
      "files": ["app/agent_computer/src/**"],
      "rules": {
        "max-lines": ["warn", { "max": 700, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      "files": ["libs/applet-sdk/src/toolkits/*.d.ts"],
      "rules": {
        "unicorn/filename-case": "off"
      }
    },
    {
      "files": ["app/library/agent-plugins/**/tools/*.ts"],
      "rules": {
        "unicorn/filename-case": ["warn", { "cases": { "kebabCase": true, "snakeCase": true } }]
      }
    },
    {
      "files": ["**/*.astro"],
      "rules": {
        "unicorn/filename-case": ["warn", { "cases": { "kebabCase": true, "pascalCase": true } }]
      }
    }
  ]
}
