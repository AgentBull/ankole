#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CONTROL_PLANE_DIR="$ROOT_DIR/app/control_plane"
WORKER_IMAGE=""
POSTGRES_PORT="${POSTGRES_PORT:-5433}"

load_dotenv_file() {
  local file="$1"

  if [[ ! -f "$file" ]]; then
    return
  fi

  echo "[e2e] loading dotenv $file"
  set -a
  # These files are local test-only dotenv files. Product provider configuration
  # still comes from Web UI-created provider rows; this only feeds e2e fixtures.
  # shellcheck disable=SC1090
  source "$file"
  set +a
}

load_e2e_dotenv() {
  load_dotenv_file "$CONTROL_PLANE_DIR/.env.test"
  load_dotenv_file "$CONTROL_PLANE_DIR/.env.test.local"
  load_dotenv_file "$CONTROL_PLANE_DIR/.env.local"
}

load_e2e_dotenv

usage() {
  cat <<'EOF'
Usage: tools/e2e/run [--gate|--perf|--chaos|--real-provider|--real-llm|--brain-real-llm|--all]
                     [--providers=name[,name]] [--only=<mix test filter>]
                     [--no-build] [--no-services]

Runs the Ankole end-to-end suites from one entrypoint. Preflight resolves an
immutable published Worker image when it matches the current inputs, or builds
a content-addressed local image. It starts the devkit Postgres when the test
database port is unreachable.

Modes:
  --gate           Transport, main-flow, lifecycle, worker/computer, and
                   schedule suites (default).
  --perf           Concurrency/throughput baseline suite.
  --chaos          Chaos suite (worker kill, fabric restart, redelivery,
                   provider-send failures).
  --real-provider  AI Gateway real-provider smoke checks (needs API keys).
  --real-llm       Docker worker + real OpenRouter LLM suite (needs API key).
  --brain-real-llm Dedicated Brain acceptance suite through fake Feishu, the
                   real worker/OpenRouter, Brain RPC, PostgreSQL, and outbox.
                   It is intentionally not included in --all.
  --all            Gate + perf + chaos, then real-provider/real-llm for the
                   providers whose API keys are present.

Options:
  --providers=...  Provider groups for --real-provider:
                   openrouter,jina,google,available
  --only=VALUE     Forwarded to mix test as --only VALUE (suite modes only).
  --no-build       Fail instead of building a missing worker image.
  --no-services    Fail instead of starting the devkit Postgres.

Examples:
  tools/e2e/run
  tools/e2e/run --all
  tools/e2e/run --chaos
  tools/e2e/run --real-provider --providers=openrouter,jina
  tools/e2e/run --brain-real-llm
EOF
}

mode="gate"
providers="available"
only_filter=""
allow_build=1
allow_services=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --gate) mode="gate"; shift ;;
    --perf) mode="perf"; shift ;;
    --chaos) mode="chaos"; shift ;;
    --real-provider) mode="real-provider"; shift ;;
    --real-llm) mode="real-llm"; shift ;;
    --brain-real-llm) mode="brain-real-llm"; shift ;;
    --all) mode="all"; shift ;;
    --providers=*) providers="${1#--providers=}"; shift ;;
    --providers) providers="${2:?--providers requires a value}"; shift 2 ;;
    --only=*) only_filter="${1#--only=}"; shift ;;
    --only) only_filter="${2:?--only requires a value}"; shift 2 ;;
    --no-build) allow_build=0; shift ;;
    --no-services) allow_services=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 64
      ;;
  esac
done

log() { echo "[e2e] $*"; }

postgres_reachable() {
  (exec 3<>"/dev/tcp/127.0.0.1/$POSTGRES_PORT") 2>/dev/null && exec 3>&- && exec 3<&-
}

preflight_docker() {
  local output_file
  local resolver_args
  output_file="$(mktemp "${TMPDIR:-/tmp}/ankole-e2e-worker-image.XXXXXX")"
  resolver_args=(--scope complete --output "$output_file")
  if [[ "$allow_build" -ne 1 ]]; then
    resolver_args+=(--no-build)
  fi

  if ! (cd "$ROOT_DIR" && bun tools/devkit/src/local-worker-image.ts "${resolver_args[@]}"); then
    rm -f "$output_file"
    exit 1
  fi

  WORKER_IMAGE="$(tr -d '\r\n' < "$output_file")"
  rm -f "$output_file"
  if [[ -z "$WORKER_IMAGE" ]]; then
    echo "[e2e] Worker image resolver returned an empty image reference." >&2
    exit 1
  fi

  export ANKOLE_E2E_WORKER_IMAGE="$WORKER_IMAGE"
  log "using Worker image $WORKER_IMAGE"
}

preflight_postgres() {
  if postgres_reachable; then
    return
  fi

  if [[ "$allow_services" -ne 1 ]]; then
    echo "[e2e] Postgres on port $POSTGRES_PORT is unreachable and --no-services was given." >&2
    exit 1
  fi

  log "Postgres on port $POSTGRES_PORT unreachable; starting devkit services"
  (cd "$ROOT_DIR" && bun run services:start)

  for _attempt in $(seq 1 30); do
    if postgres_reachable; then
      return
    fi
    sleep 1
  done

  echo "[e2e] Postgres did not become reachable on port $POSTGRES_PORT." >&2
  exit 1
}

run_mix() {
  local task="$1"
  shift
  (cd "$CONTROL_PLANE_DIR" && mix "$task" "$@")
}

suite_args=()
if [[ -n "$only_filter" ]]; then
  suite_args+=(--only "$only_filter")
fi

run_gate() { run_mix e2e.gate "${suite_args[@]:+${suite_args[@]}}"; }
run_perf() { run_mix e2e.perf "${suite_args[@]:+${suite_args[@]}}"; }
run_chaos() { run_mix e2e.chaos "${suite_args[@]:+${suite_args[@]}}"; }

run_real_llm() {
  (cd "$CONTROL_PLANE_DIR" && ANKOLE_REAL_LLM_E2E=1 mix e2e.real_llm "${suite_args[@]:+${suite_args[@]}}")
}

run_brain_real_llm() {
  (
    local brain_test_database="ankole_test_brain_real_llm_$$"

    if [[ "$DATABASE_URL" =~ ^(.*/)[^/?]+(\?.*)?$ ]]; then
      export DATABASE_URL="${BASH_REMATCH[1]}${brain_test_database}${BASH_REMATCH[2]-}"
    else
      echo "[e2e] DATABASE_URL must include a database path for --brain-real-llm." >&2
      exit 1
    fi

    cd "$CONTROL_PLANE_DIR"
    trap 'MIX_ENV=test mix ecto.drop --quiet >/dev/null 2>&1 || true' EXIT

    MIX_ENV=test mix ecto.create --quiet
    MIX_ENV=test mix ecto.migrate --quiet
    MIX_ENV=test mix run -e '
      case Ankole.Plugins.Config.put_configured_enabled("lark-adapter", true) do
        {:ok, _enabled_ids} -> :ok
        {:error, reason} -> raise "failed to enable the Brain e2e Lark plugin: #{inspect(reason)}"
      end
    '

    MIX_ENV=test \
      ANKOLE_REAL_LLM_E2E=1 \
      mix test ../../tools/e2e/suites/lark_brain_real_llm_e2e_test.exs \
        --trace \
        "${suite_args[@]:+${suite_args[@]}}"
  )
}

run_real_provider() {
  run_mix e2e.ai_gateway_real_provider -- --providers="$providers"
}

has_openrouter_key() {
  [[ -n "${OPENROUTER_API_KEY:-}" ]] || [[ -n "${OPEN_ROUTER_API_KEY:-}" ]]
}

has_real_provider_env() {
  has_openrouter_key ||
    [[ -n "${JINA_API_KEY:-}" ]] ||
    [[ -n "${GOOGLE_AI_STUDIO_API_KEY:-}" ]]
}

require_openrouter_key() {
  if ! has_openrouter_key; then
    echo "[e2e] OPENROUTER_API_KEY or OPEN_ROUTER_API_KEY is required for $1." >&2
    exit 1
  fi
}

case "$mode" in
  gate)
    preflight_docker
    preflight_postgres
    run_gate
    ;;
  perf)
    preflight_docker
    preflight_postgres
    run_perf
    ;;
  chaos)
    preflight_docker
    preflight_postgres
    run_chaos
    ;;
  real-provider)
    preflight_postgres
    run_real_provider
    ;;
  real-llm)
    preflight_docker
    preflight_postgres
    run_real_llm
    ;;
  brain-real-llm)
    require_openrouter_key "--brain-real-llm"
    preflight_docker
    preflight_postgres
    run_brain_real_llm
    ;;
  all)
    preflight_docker
    preflight_postgres
    run_gate
    run_perf
    run_chaos
    if has_real_provider_env; then
      providers="available"
      run_real_provider
    else
      log "skipping AI Gateway real-provider e2e: no provider API keys are present"
    fi
    if has_openrouter_key; then
      run_real_llm
    else
      log "skipping real-LLM worker e2e: no OpenRouter API key is present"
    fi
    ;;
esac
