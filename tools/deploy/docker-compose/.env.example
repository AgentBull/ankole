# Public DNS name. Point it at this host before the first production start.
# ankole.localhost works for a local-only test and uses Caddy's local CA.
ANKOLE_HOST=ankole.example.com
ACME_EMAIL=admin@example.com

# Generate each value independently. The hexadecimal form is portable across
# database URLs, shells, and deployment configuration.
POSTGRES_PASSWORD=
ANKOLE_SECRET_BASE=
ANKOLE_RUNTIME_FABRIC_WORKER_AUTH_KEY=

# Optional capacity settings.
ANKOLE_DATABASE_POOL_SIZE=10
ANKOLE_POSTGRES_MAX_CONNECTIONS=300
ANKOLE_MAX_CONCURRENT_TURNS=9
ANKOLE_WORKER_ID=worker-local-1
ANKOLE_LOG_LEVEL=info

# The defaults follow the latest verified GitHub Container Registry image pair.
# Set both Ankole images to immutable digests together for controlled upgrades.
# ANKOLE_CONTROL_PLANE_IMAGE=ghcr.io/agentbull/ankole-agent-control-plane@sha256:...
# ANKOLE_WORKER_IMAGE=ghcr.io/agentbull/ankole-agent-computer-worker@sha256:...
# ANKOLE_POSTGRESQL_IMAGE=ghcr.io/agentbull/ankole-postgres-for-ankole@sha256:...
