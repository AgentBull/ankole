# Public DNS name. Point it at this host before the first production start.
# ankole.localhost works for a local-only test and uses Caddy's local CA.
ANKOLE_HOST=ankole.example.com
ACME_EMAIL=admin@example.com

# Generate each value independently. The hexadecimal form is portable across
# database URLs, shells, and deployment configuration.
POSTGRES_PASSWORD=
ANKOLE_SECRET_BASE=
# Distributed Erlang cookie of this deployment. Every pull of a published
# control-plane image holds the same built-in cookie.
RELEASE_COOKIE=

# Group ID of the Docker socket as containers see it. The control plane creates
# one Worker container per Agent through the socket. On Linux, read it with
# `stat -c %g /var/run/docker.sock`; with Docker Desktop on macOS it is 0.
ANKOLE_DOCKER_GID=
# ANKOLE_DOCKER_SOCKET=/var/run/docker.sock

# Optional capacity settings. Initial Worker settings are in worker-providers.yaml.
# After the first start, edit Worker providers in Console.
ANKOLE_DATABASE_POOL_SIZE=10
ANKOLE_POSTGRES_MAX_CONNECTIONS=300
ANKOLE_LOG_LEVEL=info

# Label in the names and labels of the Worker containers and Agent volumes.
# Do not change it after the first start: the control plane then does not find
# the Agent volumes and running Workers of the old label, and it can start a
# second Worker for an Agent.
# ANKOLE_WORKER_INSTALLATION=ankole

# The defaults pin a verified control-plane release and PostgreSQL digest.
# The control-plane image also fixes the matching Worker image.
# ANKOLE_CONTROL_PLANE_IMAGE=ghcr.io/agentbull/ankole-agent-control-plane@sha256:...
# ANKOLE_POSTGRESQL_IMAGE=ghcr.io/agentbull/ankole-postgres-for-ankole@sha256:...
