{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "ankoleSecretBase": { "type": "string" },
        "workerAuthKey": { "type": "string" },
        "releaseCookie": { "type": "string" },
        "databaseURL": { "type": "string" },
        "postgresqlPassword": { "type": "string" }
      }
    },
    "controlPlane": {
      "type": "object",
      "required": ["replicaCount", "image", "publicHost"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "distributionPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "clusterDomain": { "type": "string", "minLength": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 10 },
        "publicHost": { "type": "string", "minLength": 1 },
        "image": { "$ref": "#/$defs/image" }
      }
    },
    "runtimeFabric": {
      "type": "object",
      "required": ["port", "bindEndpoint"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "bindEndpoint": { "type": "string", "pattern": "^tcp://" }
      }
    },
    "worker": {
      "type": "object",
      "required": ["replicaCount", "image", "agents"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "runtimeFabricEndpoint": { "type": "string", "pattern": "^$|^(ws|wss|tcp)://" },
        "image": { "$ref": "#/$defs/image" },
        "agents": {
          "type": "object",
          "required": ["persistence"],
          "properties": {
            "persistence": {
              "type": "object",
              "required": ["accessModes", "size"],
              "properties": {
                "existingClaim": { "type": "string" },
                "storageClass": { "type": "string" },
                "accessModes": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "size": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "required": ["enabled", "image", "auth"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/$defs/image" },
        "auth": {
          "type": "object",
          "required": ["username", "database"],
          "properties": {
            "username": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
            },
            "database": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    }
  }
}
