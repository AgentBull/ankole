{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "ankoleSecretBase": {
          "type": "string"
        },
        "releaseCookie": {
          "type": "string"
        },
        "databaseURL": {
          "type": "string"
        },
        "postgresqlPassword": {
          "type": "string"
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "required": ["replicaCount", "image", "publicHost"],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "distributionPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "clusterDomain": {
          "type": "string",
          "minLength": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 10
        },
        "publicHost": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "worker": {
      "type": "object",
      "required": ["image", "localPods", "cache"],
      "properties": {
        "runtimeFabricEndpoint": {
          "type": "string",
          "pattern": "^$|^(ws|wss)://"
        },
        "installation": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,18}[a-z0-9])?$"
        },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "localPods": {
          "type": "boolean"
        },
        "runtimeClassName": {
          "type": "string"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "cache": {
          "type": "object",
          "required": ["type", "size"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["pvc", "emptyDir"]
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider_id", "kind", "display_name", "config"],
            "additionalProperties": false,
            "properties": {
              "provider_id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              },
              "config": {
                "type": "string"
              },
              "credentials": {
                "type": "object"
              },
              "legacy_agents": {
                "type": "boolean"
              },
              "is_default": {
                "type": "boolean"
              }
            }
          }
        },
        "providerConfig": {
          "type": "string"
        },
        "storage": {
          "type": "object"
        },
        "agents": {
          "type": "object"
        },
        "extraEnv": {
          "type": "object"
        },
        "idleReleaseAfter": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "livenessProbe": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "required": ["store"],
      "properties": {
        "store": {
          "type": "string",
          "enum": ["fs", "s3"]
        },
        "importAgentHomeClaim": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "s3": {
          "type": "object",
          "properties": {
            "bucket": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^$|^https?://"
            },
            "root": {
              "type": "string"
            }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "required": ["enabled", "image", "auth"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "auth": {
          "type": "object",
          "required": ["username", "database"],
          "properties": {
            "username": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
            },
            "database": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "workerDeniedCIDRs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    }
  }
}
