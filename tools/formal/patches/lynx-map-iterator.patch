diff --git a/Lean/Lynx/Modules/Elixir/Access.lean b/Lean/Lynx/Modules/Elixir/Access.lean
new file mode 100644
--- /dev/null
+++ b/Lean/Lynx/Modules/Elixir/Access.lean
@@ -0,0 +1,20 @@
+module
+public import Lynx.Term
+@[expose] public section
+namespace Elixir.Access
+open Lynx
+
+/-- The plain-map and nil cases of Elixir Access.get/3. Struct callbacks and
+keyword lists are outside this model and cannot complete a proof. -/
+def «get/3» (container key default : Term) : Except Exception Term :=
+  match container with
+  | .map entries =>
+    match Term.mapLookup entries (.atom "__struct__") with
+    | some _ => .error .exhausted
+    | none => .ok ((Term.mapLookup entries key).getD default)
+  | .atom "nil" => .ok default
+  | _ => .error .exhausted
+
+def «get/2» (container key : Term) : Except Exception Term :=
+  «get/3» container key (.atom "nil")
+end Elixir.Access
