diff --git a/Lean/Lynx/Modules/Erlang/maps.lean b/Lean/Lynx/Modules/Erlang/maps.lean
index 210f9d0..e5e3926 100644
--- a/Lean/Lynx/Modules/Erlang/maps.lean
+++ b/Lean/Lynx/Modules/Erlang/maps.lean
@@ -36,6 +36,25 @@ open Lynx
   | .map entries => .ok (Term.list ((Term.mapEntries entries).map fun entry => .tuple #[entry.1, entry.2]))
   | input => .error (.error (.tuple #[.atom "badmap", input]))
 
+/-- Keys enumerate the same visible entries as the unordered map iterator. -/
+@[expose] def «keys/1» : Term → Except Exception Term
+  | .map entries => .ok (Term.list ((Term.mapEntries entries).map Prod.fst))
+  | input => .error (.error (.tuple #[.atom "badmap", input]))
+
+/-- An opaque iterator over the visible map bindings. The enumeration order is
+that of `to_list/1`; callers must not depend on the VM's unspecified map order. -/
+@[expose] def «iterator/1» : Term → Except Exception Term
+  | .map entries => .ok (.cons (.integer 0) (.map entries))
+  | _ => .error (.error (.atom "badarg"))
+
+@[expose] def «next/1» : Term → Except Exception Term
+  | .cons (.integer 0) (.map entries) =>
+    .ok ((Term.mapEntries entries).foldr
+      (fun (key, value) tail => .tuple #[key, value, tail]) (.atom "none"))
+  | .tuple ⟨[key, value, tail]⟩ => .ok (.tuple #[key, value, tail])
+  | .atom "none" => .ok (.atom "none")
+  | _ => .error .exhausted
+
 /-- Fold over the visible bindings in the order `to_list/1` returns them.
 Unordered iterators from `iterator/1` fold like their map. Ordered and partially
 traversed iterators are not modeled, so folding them does not return. -/
