[pgdg-common]
name = PostgreSQL Common $releasever - $basearch
baseurl = https://download.postgresql.org/pub/repos/yum/common/redhat/rhel-9.8-$basearch
gpgcheck = 0
enabled = 1
module_hotfixes = 1

[pgdg18]
name = PostgreSQL 18 $releasever - $basearch
baseurl = https://download.postgresql.org/pub/repos/yum/18/redhat/rhel-9.8-$basearch
gpgcheck = 0
enabled = 1
module_hotfixes = 1
