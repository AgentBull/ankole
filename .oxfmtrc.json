{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "none",
  "semi": false,
  "arrowParens": "avoid",
  "bracketSameLine": true,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/db/meta/*.json",
    "app/webapps/openapi/*.json",
    "packages/native-addons/index.d.ts",
    "packages/native-addons/index.js",
    "packages/native-addons/main.js",
    "**/*.toml",
    "app/agent_computer/src/core/codex-runner/generated/protocol/**",
    "app/agent_computer/src/fabric/generated/**",
    "**/*.md",
    "**/*.mdx",
    "**/*.yaml",
    "**/*.yml",
    "app/control_plane/test/fixtures/**/*.json",
    "app/control_plane/priv/worker_provider_schemas/*.json",
    "app/kernel/proto/**/*.json",
    "app/kernel/test/vectors/**",
    "app/kernel/src/applet_runtime/bootstrap.js",
    "libs/ankole-editor/corpus/**",
    "libs/ankole-editor/upstream/fixtures/**"
  ]
}
