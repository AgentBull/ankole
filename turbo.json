{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "bun.lock",
    "tsconfig.base.json",
    "turbo.json",
    ".oxlintrc.json",
    ".oxfmtrc.json",
    "bunfig.toml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        "build/**",
        ".next/**",
        ".output/**",
        "priv/static/assets/**",
        "priv/static/cache_manifest.json"
      ]
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["type-check", "^type-check"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "fmt": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "fmt:check": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
