# syntax=docker/dockerfile:1.7

ARG MYSQL_VERSION=9.7.4
# Oracle does not publish arm64 MySQL client packages for Debian 13. Use the
# versioned official image as the source, and copy only the client executable.
FROM mysql:${MYSQL_VERSION} AS mysql-client-source

FROM oven/bun:1.4.4

WORKDIR /repo

ARG CLICKHOUSE_VERSION=26.9.25.15
ARG DEBIAN_FRONTEND=noninteractive
ARG DEBIAN_MIRROR=http://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
ARG MYSQL_VERSION
ARG POSTGRESQL_CLIENT_COMMON_VERSION=293.pgdg13+1
ARG POSTGRESQL_CLIENT_VERSION=18.6
ARG POSTGRESQL_MAJOR=18
ARG POSTGRESQL_PACKAGE_VERSION=18.6-1.pgdg13+2
ARG RUST_TOOLCHAIN=1.97.1
ARG PDF_INSPECTOR_VERSION=1.25.2
ARG TARGETARCH

ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_NET_RETRY=5
ENV CARGO_HTTP_TIMEOUT=120

RUN sed -i \
    -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
    -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
    /etc/apt/sources.list.d/debian.sources \
  && apt-get -o Acquire::Retries=5 update \
  && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    7zip \
    aria2 \
    bash \
    build-essential \
    ca-certificates \
    chromium-headless-shell \
    coreutils \
    curl \
    ffmpeg \
    file \
    fontconfig \
    ghostscript \
    gh \
    git \
    gnupg \
    grep \
    imagemagick \
    jq \
    less \
    lsof \
    openssh-client \
    pandoc \
    pkg-config \
    poppler-utils \
    procps \
    protobuf-compiler \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    qpdf \
    ripgrep \
    rsync \
    tini \
    tree \
    unrar-free \
    unzip \
    util-linux \
    weasyprint \
    xz-utils \
    zip \
    zstd \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /agents \
  && chmod 0775 /agents

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
  | sh -s -- -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
  && rustc --version \
  && cargo --version

# Build the same published release with the table-header geometry patch.
# The patch digest is part of the base recipe used by local image selection.
ADD --checksum=sha256:ef5970f05a55de82c8d6d6fd5f8ff162b50fc7828cc1fd0abd965abad6fcbc5b \
  https://static.crates.io/crates/pdf-inspector/pdf-inspector-${PDF_INSPECTOR_VERSION}.crate /tmp/pdf-inspector.crate
COPY app/agent_computer/scripts/pdf-inspector-1.25.2-tables.patch /tmp/pdf-inspector-tables.patch

RUN test "${PDF_INSPECTOR_VERSION}" = 1.25.2 \
  && echo "2c8f5b593492945f5ea080580ee67cf31cfd1fa322edadba0bf03d9225139da0  /tmp/pdf-inspector-tables.patch" | sha256sum -c - \
  && mkdir /tmp/pdf-inspector-source \
  && tar -xzf /tmp/pdf-inspector.crate --strip-components=1 -C /tmp/pdf-inspector-source \
  && cd /tmp/pdf-inspector-source \
  && git apply /tmp/pdf-inspector-tables.patch \
  && cargo install --path . --locked --root /usr/local --bin detect-pdf --bin pdf2md \
  && cd /repo \
  && rm -rf /tmp/pdf-inspector-source /tmp/pdf-inspector.crate /tmp/pdf-inspector-tables.patch \
    /root/.cargo/registry /root/.cargo/git \
  && gs -o /tmp/pdf-inspector-check.pdf -sDEVICE=pdfwrite -c showpage \
  && detect-pdf /tmp/pdf-inspector-check.pdf --json | jq -e '.pdf_type' >/dev/null \
  && test -x /usr/local/bin/pdf2md \
  && rm -f /tmp/pdf-inspector-check.pdf

RUN apt-get -o Acquire::Retries=5 update \
  && apt-get -o Acquire::Retries=5 install -y --no-install-recommends libicu-dev \
  && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh \
  && python3 -m venv /opt/ankole-python \
  && for attempt in 1 2 3; do \
    if /usr/local/bin/uv pip install --python /opt/ankole-python/bin/python \
      blake3 \
      colorlog \
      defusedxml \
      duckdb \
      imageio \
      ipykernel \
      jupyter-client \
      jupyter-server \
      jupyterlab \
      "markitdown[pptx]" \
      matplotlib \
      matplotlib-inline \
      nano-pdf \
      nbformat \
      numpy \
      omegaconf \
      opencv-python-headless \
      openpyxl \
      openvino \
      pandas \
      pillow \
      polars \
      pyarrow \
      pyclipper \
      pydantic \
      python-docx \
      python-pptx \
      pyyaml \
      requests \
      scipy \
      shapely \
      six \
      tqdm \
      websocket-client; then \
      break; \
    fi; \
    if [ "$attempt" = "3" ]; then exit 1; fi; \
    sleep $((attempt * 10)); \
  done \
  # rapidocr installs without dependency resolution: its manifest demands the
  # GUI opencv-python while the image carries opencv-python-headless, and its
  # remaining dependencies are on the list above. The pin also fixes the
  # ModelScope tag its model downloads resolve through.
  && /usr/local/bin/uv pip install --python /opt/ankole-python/bin/python \
    --no-deps rapidocr==3.9.2 \
  && find /opt/ankole-python/bin -maxdepth 1 -type f -perm /111 -exec ln -sf {} /usr/local/bin/ \; \
  && rm -f /usr/local/bin/python /usr/local/bin/python3 \
  && printf '%s\n' '#!/usr/bin/env sh' 'exec /opt/ankole-python/bin/python "$@"' > /usr/local/bin/python \
  && cp /usr/local/bin/python /usr/local/bin/python3 \
  && chmod +x /usr/local/bin/python /usr/local/bin/python3

ARG ANKOLE_FONTS_VERSION=v1-d3cec8d9a5f35613

# The public font release contains IBM Plex Sans SC, IBMPlexMonoSCHalf,
# ChillJinshuSong, and Fluent Emoji Color. Sans and mono include weights 300,
# 400, 500, 600, and 700. The serif family has no weight 600, so it includes
# weights 300, 400, 500, and 700. The release workflow converts the serif CFF
# files to TrueType files.
RUN set -eux; \
  font_assets_dir=/tmp/ankole-fonts; \
  font_assets_url="https://github.com/AgentBull/ankole-fonts/releases/download/${ANKOLE_FONTS_VERSION}"; \
  mkdir -p "${font_assets_dir}"; \
  for file in \
    ChillJinshuSongBold.ttf ChillJinshuSongLight.ttf ChillJinshuSongMedium.ttf ChillJinshuSongRegular.ttf \
    FluentEmojiColor.ttf \
    IBMPlexMonoSCHalf-Bold.ttf IBMPlexMonoSCHalf-Light.ttf IBMPlexMonoSCHalf-Medium.ttf \
    IBMPlexMonoSCHalf-Regular.ttf IBMPlexMonoSCHalf-SemiBold.ttf \
    IBMPlexSansSC-Bold.ttf IBMPlexSansSC-Light.ttf IBMPlexSansSC-Medium.ttf \
    IBMPlexSansSC-Regular.ttf IBMPlexSansSC-SemiBold.ttf \
    LICENSE-ChillJinshuSong.txt LICENSE-Fluent-Emoji-Color.txt \
    LICENSE-IBM-Plex-Mono-SC.txt LICENSE-IBM-Plex-Sans-SC.txt; do \
    curl -fsSL --retry 5 --retry-all-errors \
      "${font_assets_url}/${file}" -o "${font_assets_dir}/${file}"; \
  done; \
  plex_sc_dir=/usr/share/fonts/truetype/ibm-plex-sans-sc; \
  plex_mono_dir=/usr/share/fonts/truetype/ibm-plex-mono-sc; \
  chill_dir=/usr/share/fonts/truetype/chill-jinshu-song; \
  emoji_dir=/usr/share/fonts/truetype/fluent-emoji-color; \
  mkdir -p "${plex_sc_dir}" "${plex_mono_dir}" "${chill_dir}" "${emoji_dir}"; \
  install -m 0644 "${font_assets_dir}"/IBMPlexSansSC-*.ttf "${plex_sc_dir}/"; \
  install -m 0644 "${font_assets_dir}/LICENSE-IBM-Plex-Sans-SC.txt" "${plex_sc_dir}/license.txt"; \
  install -m 0644 "${font_assets_dir}"/IBMPlexMonoSCHalf-*.ttf "${plex_mono_dir}/"; \
  install -m 0644 "${font_assets_dir}/LICENSE-IBM-Plex-Mono-SC.txt" "${plex_mono_dir}/license.txt"; \
  install -m 0644 "${font_assets_dir}"/ChillJinshuSong*.ttf "${chill_dir}/"; \
  install -m 0644 "${font_assets_dir}/LICENSE-ChillJinshuSong.txt" "${chill_dir}/LICENSE"; \
  install -m 0644 "${font_assets_dir}/FluentEmojiColor.ttf" "${emoji_dir}/"; \
  install -m 0644 "${font_assets_dir}/LICENSE-Fluent-Emoji-Color.txt" "${emoji_dir}/LICENSE"; \
  printf '%s\n' \
    '<?xml version="1.0"?>' \
    '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">' \
    '<fontconfig>' \
    '  <alias binding="strong"><family>IBM Plex Sans</family><prefer><family>IBM Plex Sans SC</family></prefer></alias>' \
    '  <alias binding="strong"><family>IBM Plex Mono</family><prefer><family>IBMPlexMonoSCHalf</family></prefer></alias>' \
    '  <alias binding="strong"><family>ChillJinshuSong</family><prefer><family>寒蝉锦书宋</family></prefer></alias>' \
    '  <alias binding="strong"><family>emoji</family><prefer><family>Fluent Emoji Color</family></prefer></alias>' \
    '  <alias binding="strong"><family>sans-serif</family><prefer><family>IBM Plex Sans SC</family><family>Fluent Emoji Color</family></prefer></alias>' \
    '  <alias binding="strong"><family>serif</family><prefer><family>寒蝉锦书宋</family><family>Fluent Emoji Color</family></prefer></alias>' \
    '  <alias binding="strong"><family>monospace</family><prefer><family>IBMPlexMonoSCHalf</family><family>Fluent Emoji Color</family></prefer></alias>' \
    '</fontconfig>' \
    > /etc/fonts/conf.d/52-ankole-brand-fonts.conf; \
  fc-cache -f >/dev/null; \
  fc-match sans-serif | grep -F 'IBM Plex Sans SC'; \
  fc-match serif | grep -F 'ChillJinshuSong'; \
  fc-match monospace | grep -F 'IBMPlexMonoSCHalf'; \
  fc-match emoji | grep -F 'FluentEmojiColor'; \
  fc-match 'IBM Plex Sans' | grep -F 'IBM Plex Sans SC'; \
  fc-match 'IBM Plex Mono' | grep -F 'IBMPlexMonoSCHalf'; \
  fc-match 'ChillJinshuSong' | grep -F 'ChillJinshuSong'; \
  rm -rf "${font_assets_dir}"

# Bake the PP-OCRv6 medium models into the rapidocr package directory and prove
# the image-level OpenVINO path with one rendered-text round trip. The Agent
# Computer integration suite proves the same path through the OCR Skill. Keep
# the params aligned with app/library/skills/ocr/scripts/ocr.py.
RUN <<'OCR_SMOKE'
set -eu
cat > /tmp/ocr-smoke.py <<'PY'
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont
from rapidocr import EngineType, ModelType, OCRVersion, RapidOCR

font_path = sorted(Path("/usr/share/fonts/truetype/ibm-plex-sans-sc").glob("*.ttf"))[0]
image = Image.new("RGB", (860, 130), "white")
draw = ImageDraw.Draw(image)
draw.text((30, 30), "Ankole OCR 烟测 2026", font=ImageFont.truetype(str(font_path), 56), fill="black")
image.save("/tmp/ocr-smoke.png")

engine = RapidOCR(params={
    "Det.engine_type": EngineType.OPENVINO,
    "Det.ocr_version": OCRVersion.PPOCRV6,
    "Det.model_type": ModelType.MEDIUM,
    "Cls.engine_type": EngineType.OPENVINO,
    "Rec.engine_type": EngineType.OPENVINO,
    "Rec.ocr_version": OCRVersion.PPOCRV6,
    "Rec.model_type": ModelType.MEDIUM,
})
text = "".join(engine("/tmp/ocr-smoke.png", use_cls=True).txts or [])
assert "OCR" in text and "2026" in text, f"OCR smoke failed: {text!r}"
PY
python /tmp/ocr-smoke.py
rm -f /tmp/ocr-smoke.py /tmp/ocr-smoke.png
OCR_SMOKE

COPY --from=mysql-client-source /usr/bin/mysql /usr/local/bin/mysql

RUN set -eux; \
  case "${TARGETARCH:-$(uname -m)}" in \
    amd64|x86_64) \
      package_arch=amd64 ;; \
    arm64|aarch64) \
      package_arch=arm64 ;; \
    *) echo "Unsupported database client architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
  esac; \
  clickhouse_base_url=https://packages.clickhouse.com/deb/pool/main/c/clickhouse; \
  clickhouse_client="clickhouse-client_${CLICKHOUSE_VERSION}_${package_arch}.deb"; \
  clickhouse_common="clickhouse-common-static_${CLICKHOUSE_VERSION}_${package_arch}.deb"; \
  curl -fsSL --retry 5 --retry-all-errors "${clickhouse_base_url}/${clickhouse_client}" \
    -o "/tmp/${clickhouse_client}"; \
  curl -fsSL --retry 5 --retry-all-errors "${clickhouse_base_url}/${clickhouse_common}" \
    -o "/tmp/${clickhouse_common}"; \
  postgresql_base_url=https://apt.postgresql.org/pub/repos/apt; \
  libpq_package="libpq5_${POSTGRESQL_PACKAGE_VERSION}_${package_arch}.deb"; \
  postgresql_client="postgresql-client-${POSTGRESQL_MAJOR}_${POSTGRESQL_PACKAGE_VERSION}_${package_arch}.deb"; \
  postgresql_client_common="postgresql-client-common_${POSTGRESQL_CLIENT_COMMON_VERSION}_all.deb"; \
  curl -fsSL --retry 5 --retry-all-errors \
    "${postgresql_base_url}/pool/main/p/postgresql-${POSTGRESQL_MAJOR}/${libpq_package}" \
    -o "/tmp/${libpq_package}"; \
  curl -fsSL --retry 5 --retry-all-errors \
    "${postgresql_base_url}/pool/main/p/postgresql-${POSTGRESQL_MAJOR}/${postgresql_client}" \
    -o "/tmp/${postgresql_client}"; \
  curl -fsSL --retry 5 --retry-all-errors \
    "${postgresql_base_url}/pool/main/p/postgresql-common/${postgresql_client_common}" \
    -o "/tmp/${postgresql_client_common}"; \
  apt-get -o Acquire::Retries=5 update; \
  apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    groff \
    libncurses6 \
    "/tmp/${clickhouse_client}" \
    "/tmp/${clickhouse_common}" \
    "/tmp/${libpq_package}" \
    "/tmp/${postgresql_client}" \
    "/tmp/${postgresql_client_common}"; \
  clickhouse-client --version | grep -qF "ClickHouse client version ${CLICKHOUSE_VERSION}"; \
  mysql --version | grep -qF "Ver ${MYSQL_VERSION} "; \
  psql --version | grep -qF "psql (PostgreSQL) ${POSTGRESQL_CLIENT_VERSION}"; \
  ! command -v clickhouse-server; \
  ! command -v mysqld; \
  ! command -v postgres; \
  ! dpkg-query -W -f='${db:Status-Abbrev}' clickhouse-server 2>/dev/null | grep -q '^ii'; \
  ! dpkg-query -W -f='${db:Status-Abbrev}' "postgresql-${POSTGRESQL_MAJOR}" 2>/dev/null | grep -q '^ii'; \
  rm -rf /var/lib/apt/lists/* /tmp/*.deb

RUN rm -f /usr/local/bin/node /usr/local/bun-node-fallback-bin/node \
  && ! command -v node \
  && bun -e 'if (typeof Bun.TOML.stringify !== "function") throw new Error("Bun.TOML.stringify is required")'
