# syntax=docker/dockerfile:1.7

ARG MYSQL_VERSION=9.7.2
# Oracle does not publish arm64 MySQL client packages for Debian 13. Use the
# digest-pinned official image as the source, and copy only the client executable.
FROM mysql:${MYSQL_VERSION}@sha256:257388edf9c84dbc04c763625446d5f3fa6ed60d1b0873bc552c614ba0a7ab4e AS mysql-client-source

FROM oven/bun:canary

WORKDIR /repo

ARG AWS_CLI_VERSION=2.36.10
ARG CLICKHOUSE_VERSION=26.7.1.1315
ARG DEBIAN_FRONTEND=noninteractive
ARG DEBIAN_MIRROR=http://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
ARG KUBECTL_VERSION=v1.36.3
ARG MYSQL_VERSION
ARG POSTGRESQL_CLIENT_COMMON_VERSION=293.pgdg13+1
ARG POSTGRESQL_CLIENT_VERSION=18.4
ARG POSTGRESQL_MAJOR=18
ARG POSTGRESQL_PACKAGE_VERSION=18.4-1.pgdg13+1
ARG RUST_TOOLCHAIN=1.97.1
ARG CODEX_VERSION=0.146.0
ARG MCPORTER_VERSION=0.13.0
ARG MCPORTER_SHA256=e9d081aee5528ca6ac228fa0e385e768df7e52c756b6c0b6e17ef2b747de1ce9
ARG OFFICECLI_VERSION=v1.0.143
ARG PDF_INSPECTOR_VERSION=0.1.7
ARG TYPST_VERSION=v0.15.1
ARG TARGETARCH

ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_NET_RETRY=5
ENV CARGO_HTTP_TIMEOUT=120

RUN sed -i \
    -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
    -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
    /etc/apt/sources.list.d/debian.sources \
  && apt-get -o Acquire::Retries=5 update \
  && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    7zip \
    aria2 \
    bash \
    bubblewrap \
    build-essential \
    ca-certificates \
    chromium-headless-shell \
    coreutils \
    curl \
    ffmpeg \
    file \
    fontconfig \
    ghostscript \
    gh \
    git \
    gnupg \
    grep \
    imagemagick \
    jq \
    less \
    libzmq3-dev \
    libzmq5 \
    lsof \
    openssh-client \
    pandoc \
    pkg-config \
    poppler-utils \
    procps \
    protobuf-compiler \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    qpdf \
    ripgrep \
    rsync \
    tini \
    tree \
    unrar-free \
    unzip \
    util-linux \
    weasyprint \
    xz-utils \
    zip \
    zstd \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /agents \
  && chmod 0775 /agents

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
  | sh -s -- -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
  && rustc --version \
  && cargo --version

# pdf-inspector publishes no prebuilt binaries, so its `detect-pdf` and
# `pdf2md` CLIs build from crates.io here. `--root /usr/local` keeps them on
# the sandbox-visible PATH instead of /root/.cargo/bin. The CLIs have no
# `--version`, so the check classifies a generated PDF.
RUN cargo install pdf-inspector --version "${PDF_INSPECTOR_VERSION}" --locked --root /usr/local \
    --bin detect-pdf --bin pdf2md \
  && rm -rf /root/.cargo/registry /root/.cargo/git \
  && gs -o /tmp/pdf-inspector-check.pdf -sDEVICE=pdfwrite -c showpage \
  && detect-pdf /tmp/pdf-inspector-check.pdf --json | jq -e '.pdf_type' >/dev/null \
  && test -x /usr/local/bin/pdf2md \
  && rm -f /tmp/pdf-inspector-check.pdf

RUN set -eux; \
  mcporter_package="/tmp/mcporter-${MCPORTER_VERSION}.tgz"; \
  curl -fsSL --retry 3 --retry-delay 2 \
    "https://github.com/openclaw/mcporter/releases/download/v${MCPORTER_VERSION}/mcporter-${MCPORTER_VERSION}.tgz" \
    -o "$mcporter_package"; \
  printf '%s  %s\n' "$MCPORTER_SHA256" "$mcporter_package" | sha256sum -c -; \
  installed=0; \
  for attempt in 1 2 3; do \
    if bun add -g "@openai/codex@${CODEX_VERSION}" "$mcporter_package"; then installed=1; break; fi; \
    rm -rf /root/.bun/install/cache/* /tmp/bun-*; \
    sleep $((attempt * 5)); \
  done; \
  test "$installed" = 1; \
  rm -f /usr/local/bin/codex /usr/local/bin/mcporter; \
  printf '%s\n' '#!/usr/bin/env sh' 'exec /usr/local/bin/bun /root/.bun/install/global/node_modules/@openai/codex/bin/codex.js "$@"' > /usr/local/bin/codex; \
  printf '%s\n' '#!/usr/bin/env sh' 'exec /usr/local/bin/bun /root/.bun/install/global/node_modules/mcporter/dist/cli.js "$@"' > /usr/local/bin/mcporter; \
  chmod +x /usr/local/bin/codex /usr/local/bin/mcporter; \
  test "$(codex --version)" = "codex-cli ${CODEX_VERSION}"; \
  test "$(mcporter --version)" = "${MCPORTER_VERSION}"; \
  rm -f "$mcporter_package"

RUN apt-get -o Acquire::Retries=5 update \
  && apt-get -o Acquire::Retries=5 install -y --no-install-recommends libicu-dev \
  && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
  case "${TARGETARCH:-$(uname -m)}" in \
    amd64|x86_64) officecli_asset="officecli-linux-x64" ;; \
    arm64|aarch64) officecli_asset="officecli-linux-arm64" ;; \
    *) echo "Unsupported OfficeCLI architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
  esac; \
  officecli_base_url="https://github.com/iOfficeAI/OfficeCLI/releases/download/${OFFICECLI_VERSION}"; \
  curl -fsSL "${officecli_base_url}/SHA256SUMS" -o /tmp/officecli-SHA256SUMS; \
  curl -fsSL "${officecli_base_url}/${officecli_asset}" -o /usr/local/bin/officecli; \
  expected="$(awk -v asset="${officecli_asset}" '$2 == asset { print $1; exit }' /tmp/officecli-SHA256SUMS)"; \
  test -n "${expected}"; \
  printf '%s  %s\n' "${expected}" /usr/local/bin/officecli | sha256sum -c -; \
  chmod +x /usr/local/bin/officecli; \
  test "$(officecli --version)" = "${OFFICECLI_VERSION#v}"; \
  rm -f /tmp/officecli-SHA256SUMS

# Typst is not packaged for Debian trixie, so the pinned release binary is
# installed here. Its releases publish no checksum file, so the digests below
# are recorded from the pinned assets and must be updated with the version.
RUN set -eux; \
  case "${TARGETARCH:-$(uname -m)}" in \
    amd64|x86_64) \
      typst_asset="typst-x86_64-unknown-linux-musl"; \
      typst_sha256="a6d077d0a95eed5a2eba715b2dae06be954f624ccbf85758a03f389ded33118c" ;; \
    arm64|aarch64) \
      typst_asset="typst-aarch64-unknown-linux-musl"; \
      typst_sha256="5aa8d74a3d906e60ea12a66ac2f37f8eef1b14cbad7182a745e393a10c23dcee" ;; \
    *) echo "Unsupported Typst architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
  esac; \
  curl -fsSL "https://github.com/typst/typst/releases/download/${TYPST_VERSION}/${typst_asset}.tar.xz" \
    -o /tmp/typst.tar.xz; \
  printf '%s  %s\n' "${typst_sha256}" /tmp/typst.tar.xz | sha256sum -c -; \
  tar -xJf /tmp/typst.tar.xz -C /tmp; \
  install -m 0755 "/tmp/${typst_asset}/typst" /usr/local/bin/typst; \
  rm -rf /tmp/typst.tar.xz "/tmp/${typst_asset}"; \
  typst --version | grep -qF "typst ${TYPST_VERSION#v}"

RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh \
  && python3 -m venv /opt/ankole-python \
  && for attempt in 1 2 3; do \
    if /usr/local/bin/uv pip install --python /opt/ankole-python/bin/python \
      blake3 \
      colorlog \
      defusedxml \
      duckdb \
      imageio \
      ipykernel \
      jupyter-client \
      jupyter-server \
      jupyterlab \
      "markitdown[pptx]" \
      matplotlib \
      matplotlib-inline \
      nano-pdf \
      nbformat \
      numpy \
      omegaconf \
      opencv-python-headless \
      openpyxl \
      openvino \
      pandas \
      pillow \
      polars \
      pyarrow \
      pyclipper \
      pydantic \
      python-docx \
      python-pptx \
      pyyaml \
      requests \
      scipy \
      shapely \
      six \
      tqdm \
      websocket-client; then \
      break; \
    fi; \
    if [ "$attempt" = "3" ]; then exit 1; fi; \
    sleep $((attempt * 10)); \
  done \
  # rapidocr installs without dependency resolution: its manifest demands the
  # GUI opencv-python while the image carries opencv-python-headless, and its
  # remaining dependencies are on the list above. The pin also fixes the
  # ModelScope tag its model downloads resolve through.
  && /usr/local/bin/uv pip install --python /opt/ankole-python/bin/python \
    --no-deps rapidocr==3.9.2 \
  && find /opt/ankole-python/bin -maxdepth 1 -type f -perm /111 -exec ln -sf {} /usr/local/bin/ \; \
  && rm -f /usr/local/bin/python /usr/local/bin/python3 \
  && printf '%s\n' '#!/usr/bin/env sh' 'exec /opt/ankole-python/bin/python "$@"' > /usr/local/bin/python \
  && cp /usr/local/bin/python /usr/local/bin/python3 \
  && chmod +x /usr/local/bin/python /usr/local/bin/python3

ARG ANKOLE_FONTS_VERSION=v1-d3cec8d9a5f35613
ARG ANKOLE_FONTS_MANIFEST_SHA256=46ae2a33ba50258ef68d0d882c30f06356b09fe862d8acb655fceb4682ba5002

# The public font release contains IBM Plex Sans SC, IBMPlexMonoSCHalf,
# ChillJinshuSong, and Fluent Emoji Color. Sans and mono include weights 300,
# 400, 500, 600, and 700. The serif family has no weight 600, so it includes
# weights 300, 400, 500, and 700. The release workflow converts the serif CFF
# files to validated TrueType files. Pin both the release and its manifest.
RUN set -eux; \
  font_assets_dir=/tmp/ankole-fonts; \
  font_assets_url="https://github.com/AgentBull/ankole-fonts/releases/download/${ANKOLE_FONTS_VERSION}"; \
  mkdir -p "${font_assets_dir}"; \
  curl -fsSL --retry 5 --retry-all-errors \
    "${font_assets_url}/SHA256SUMS" -o "${font_assets_dir}/SHA256SUMS"; \
  printf '%s  %s\n' "${ANKOLE_FONTS_MANIFEST_SHA256}" "${font_assets_dir}/SHA256SUMS" \
    | sha256sum -c -; \
  while read -r _checksum file; do \
    curl -fsSL --retry 5 --retry-all-errors \
      "${font_assets_url}/${file}" -o "${font_assets_dir}/${file}"; \
  done < "${font_assets_dir}/SHA256SUMS"; \
  (cd "${font_assets_dir}" && sha256sum -c SHA256SUMS); \
  plex_sc_dir=/usr/share/fonts/truetype/ibm-plex-sans-sc; \
  plex_mono_dir=/usr/share/fonts/truetype/ibm-plex-mono-sc; \
  chill_dir=/usr/share/fonts/truetype/chill-jinshu-song; \
  emoji_dir=/usr/share/fonts/truetype/fluent-emoji-color; \
  mkdir -p "${plex_sc_dir}" "${plex_mono_dir}" "${chill_dir}" "${emoji_dir}"; \
  install -m 0644 "${font_assets_dir}"/IBMPlexSansSC-*.ttf "${plex_sc_dir}/"; \
  install -m 0644 "${font_assets_dir}/LICENSE-IBM-Plex-Sans-SC.txt" "${plex_sc_dir}/license.txt"; \
  install -m 0644 "${font_assets_dir}"/IBMPlexMonoSCHalf-*.ttf "${plex_mono_dir}/"; \
  install -m 0644 "${font_assets_dir}/LICENSE-IBM-Plex-Mono-SC.txt" "${plex_mono_dir}/license.txt"; \
  install -m 0644 "${font_assets_dir}"/ChillJinshuSong*.ttf "${chill_dir}/"; \
  install -m 0644 "${font_assets_dir}/LICENSE-ChillJinshuSong.txt" "${chill_dir}/LICENSE"; \
  install -m 0644 "${font_assets_dir}/FluentEmojiColor.ttf" "${emoji_dir}/"; \
  install -m 0644 "${font_assets_dir}/LICENSE-Fluent-Emoji-Color.txt" "${emoji_dir}/LICENSE"; \
  printf '%s\n' \
    '<?xml version="1.0"?>' \
    '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">' \
    '<fontconfig>' \
    '  <alias binding="strong"><family>IBM Plex Sans</family><prefer><family>IBM Plex Sans SC</family></prefer></alias>' \
    '  <alias binding="strong"><family>IBM Plex Mono</family><prefer><family>IBMPlexMonoSCHalf</family></prefer></alias>' \
    '  <alias binding="strong"><family>ChillJinshuSong</family><prefer><family>寒蝉锦书宋</family></prefer></alias>' \
    '  <alias binding="strong"><family>emoji</family><prefer><family>Fluent Emoji Color</family></prefer></alias>' \
    '  <alias binding="strong"><family>sans-serif</family><prefer><family>IBM Plex Sans SC</family><family>Fluent Emoji Color</family></prefer></alias>' \
    '  <alias binding="strong"><family>serif</family><prefer><family>寒蝉锦书宋</family><family>Fluent Emoji Color</family></prefer></alias>' \
    '  <alias binding="strong"><family>monospace</family><prefer><family>IBMPlexMonoSCHalf</family><family>Fluent Emoji Color</family></prefer></alias>' \
    '</fontconfig>' \
    > /etc/fonts/conf.d/52-ankole-brand-fonts.conf; \
  fc-cache -f >/dev/null; \
  fc-match sans-serif | grep -F 'IBM Plex Sans SC'; \
  fc-match serif | grep -F 'ChillJinshuSong'; \
  fc-match monospace | grep -F 'IBMPlexMonoSCHalf'; \
  fc-match emoji | grep -F 'FluentEmojiColor'; \
  fc-match 'IBM Plex Sans' | grep -F 'IBM Plex Sans SC'; \
  fc-match 'IBM Plex Mono' | grep -F 'IBMPlexMonoSCHalf'; \
  fc-match 'ChillJinshuSong' | grep -F 'ChillJinshuSong'; \
  rm -rf "${font_assets_dir}"

# Bake the PP-OCRv6 medium models into the rapidocr package directory and
# prove the OpenVINO path with one rendered-text round trip, so a Job never
# downloads models or discovers a broken engine at run time. Keep the params
# aligned with app/library/skills/ocr/scripts/ocr.py.
RUN <<'OCR_SMOKE'
set -eu
cat > /tmp/ocr-smoke.py <<'PY'
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont
from rapidocr import EngineType, ModelType, OCRVersion, RapidOCR

font_path = sorted(Path("/usr/share/fonts/truetype/ibm-plex-sans-sc").glob("*.ttf"))[0]
image = Image.new("RGB", (860, 130), "white")
draw = ImageDraw.Draw(image)
draw.text((30, 30), "Ankole OCR 烟测 2026", font=ImageFont.truetype(str(font_path), 56), fill="black")
image.save("/tmp/ocr-smoke.png")

engine = RapidOCR(params={
    "Det.engine_type": EngineType.OPENVINO,
    "Det.ocr_version": OCRVersion.PPOCRV6,
    "Det.model_type": ModelType.MEDIUM,
    "Cls.engine_type": EngineType.OPENVINO,
    "Rec.engine_type": EngineType.OPENVINO,
    "Rec.ocr_version": OCRVersion.PPOCRV6,
    "Rec.model_type": ModelType.MEDIUM,
})
text = "".join(engine("/tmp/ocr-smoke.png", use_cls=True).txts or [])
assert "OCR" in text and "2026" in text, f"OCR smoke failed: {text!r}"
PY
python /tmp/ocr-smoke.py
rm -f /tmp/ocr-smoke.py /tmp/ocr-smoke.png
OCR_SMOKE

RUN set -eux; \
  case "${TARGETARCH:-$(uname -m)}" in \
    amd64|x86_64) kubectl_arch=amd64 ;; \
    arm64|aarch64) kubectl_arch=arm64 ;; \
    *) echo "Unsupported kubectl architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
  esac; \
  kubectl_base_url="https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${kubectl_arch}"; \
  curl -fsSL --retry 5 --retry-all-errors "${kubectl_base_url}/kubectl" -o /tmp/kubectl; \
  curl -fsSL --retry 5 --retry-all-errors "${kubectl_base_url}/kubectl.sha256" -o /tmp/kubectl.sha256; \
  printf '%s  %s\n' "$(cat /tmp/kubectl.sha256)" /tmp/kubectl | sha256sum -c -; \
  install -m 0755 /tmp/kubectl /usr/local/bin/kubectl; \
  test "$(kubectl version --client -o json | jq -r '.clientVersion.gitVersion')" = "${KUBECTL_VERSION}"; \
  rm -f /tmp/kubectl /tmp/kubectl.sha256

RUN set -eux; \
  case "${TARGETARCH:-$(uname -m)}" in \
    amd64|x86_64) \
      aws_arch=x86_64; \
      aws_sha256=f6bf7f19f584a1b32b50217f357f2a5877204cf6f703fec8036cd774932383dd ;; \
    arm64|aarch64) \
      aws_arch=aarch64; \
      aws_sha256=8435364a5a09004a644340131c720e081823023f9c69d5fd15f9bc650fb662fc ;; \
    *) echo "Unsupported AWS CLI architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
  esac; \
  aws_asset="awscli-exe-linux-${aws_arch}-${AWS_CLI_VERSION}.zip"; \
  curl -fsSL --retry 5 --retry-all-errors "https://awscli.amazonaws.com/${aws_asset}" \
    -o /tmp/awscliv2.zip; \
  printf '%s  %s\n' "${aws_sha256}" /tmp/awscliv2.zip | sha256sum -c -; \
  unzip -q /tmp/awscliv2.zip -d /tmp; \
  /tmp/aws/install --install-dir /usr/local/aws-cli --bin-dir /usr/local/bin; \
  aws --version | grep -qF "aws-cli/${AWS_CLI_VERSION} "; \
  rm -rf /tmp/aws /tmp/awscliv2.zip

COPY --from=mysql-client-source /usr/bin/mysql /usr/local/bin/mysql

RUN set -eux; \
  case "${TARGETARCH:-$(uname -m)}" in \
    amd64|x86_64) \
      package_arch=amd64; \
      clickhouse_client_sha256=5f021b023591f48f0582a83a96832ad20686c512f53d5a2c510c3a64db8f08c4; \
      clickhouse_common_sha256=b1d03559c94d5d26209465290c04f1ec04a58f6d64d4f2ce00a6f0ad093c8b18; \
      libpq_sha256=2f06798a11648e09deeef9e38ec3da942b11681965efb8e07f1137fe0d44db7c; \
      postgresql_client_sha256=9c8e66b5a2ace8fa507290555c91559e3b740d2464b9645aba96632acef2b810 ;; \
    arm64|aarch64) \
      package_arch=arm64; \
      clickhouse_client_sha256=ae07092cc46e60674ddcb945129eb897b4c82930e26b76af7fa172ca7901111a; \
      clickhouse_common_sha256=f93dffd6353b436ddeae6bec09e70c3466b11d96357bec66a9f10f785a713b07; \
      libpq_sha256=fe77ee455e25c66102aacd23ef0d5598ca2ab7394f8449d4ded5e826cb8eee4b; \
      postgresql_client_sha256=d1575e3193c2678e16a0cb9a8a00b8f899522a26d55803c262fff9a5643d28f5 ;; \
    *) echo "Unsupported database client architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
  esac; \
  clickhouse_base_url=https://packages.clickhouse.com/deb/pool/main/c/clickhouse; \
  clickhouse_client="clickhouse-client_${CLICKHOUSE_VERSION}_${package_arch}.deb"; \
  clickhouse_common="clickhouse-common-static_${CLICKHOUSE_VERSION}_${package_arch}.deb"; \
  curl -fsSL --retry 5 --retry-all-errors "${clickhouse_base_url}/${clickhouse_client}" \
    -o "/tmp/${clickhouse_client}"; \
  curl -fsSL --retry 5 --retry-all-errors "${clickhouse_base_url}/${clickhouse_common}" \
    -o "/tmp/${clickhouse_common}"; \
  printf '%s  %s\n' \
    "${clickhouse_client_sha256}" "/tmp/${clickhouse_client}" \
    "${clickhouse_common_sha256}" "/tmp/${clickhouse_common}" \
    | sha256sum -c -; \
  postgresql_base_url=https://apt.postgresql.org/pub/repos/apt; \
  libpq_package="libpq5_${POSTGRESQL_PACKAGE_VERSION}_${package_arch}.deb"; \
  postgresql_client="postgresql-client-${POSTGRESQL_MAJOR}_${POSTGRESQL_PACKAGE_VERSION}_${package_arch}.deb"; \
  postgresql_client_common="postgresql-client-common_${POSTGRESQL_CLIENT_COMMON_VERSION}_all.deb"; \
  curl -fsSL --retry 5 --retry-all-errors \
    "${postgresql_base_url}/pool/main/p/postgresql-${POSTGRESQL_MAJOR}/${libpq_package}" \
    -o "/tmp/${libpq_package}"; \
  curl -fsSL --retry 5 --retry-all-errors \
    "${postgresql_base_url}/pool/main/p/postgresql-${POSTGRESQL_MAJOR}/${postgresql_client}" \
    -o "/tmp/${postgresql_client}"; \
  curl -fsSL --retry 5 --retry-all-errors \
    "${postgresql_base_url}/pool/main/p/postgresql-common/${postgresql_client_common}" \
    -o "/tmp/${postgresql_client_common}"; \
  printf '%s  %s\n' \
    "${libpq_sha256}" "/tmp/${libpq_package}" \
    "${postgresql_client_sha256}" "/tmp/${postgresql_client}" \
    '70da21264140dfb34680cfec52973c7f10b5c8e3c78699a52b04e870b3dee71b' "/tmp/${postgresql_client_common}" \
    | sha256sum -c -; \
  apt-get -o Acquire::Retries=5 update; \
  apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    groff \
    libncurses6 \
    "/tmp/${clickhouse_client}" \
    "/tmp/${clickhouse_common}" \
    "/tmp/${libpq_package}" \
    "/tmp/${postgresql_client}" \
    "/tmp/${postgresql_client_common}"; \
  clickhouse-client --version | grep -qF "ClickHouse client version ${CLICKHOUSE_VERSION}"; \
  mysql --version | grep -qF "Ver ${MYSQL_VERSION} "; \
  psql --version | grep -qF "psql (PostgreSQL) ${POSTGRESQL_CLIENT_VERSION}"; \
  ! command -v clickhouse-server; \
  ! command -v mysqld; \
  ! command -v postgres; \
  ! dpkg-query -W -f='${db:Status-Abbrev}' clickhouse-server 2>/dev/null | grep -q '^ii'; \
  ! dpkg-query -W -f='${db:Status-Abbrev}' "postgresql-${POSTGRESQL_MAJOR}" 2>/dev/null | grep -q '^ii'; \
  rm -rf /var/lib/apt/lists/* /tmp/*.deb

RUN rm -f /usr/local/bin/node /usr/local/bun-node-fallback-bin/node \
  && ! command -v node \
  && bun -e 'if (typeof Bun.TOML.stringify !== "function") throw new Error("Bun.TOML.stringify is required")'
