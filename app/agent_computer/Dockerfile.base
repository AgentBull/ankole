# syntax=docker/dockerfile:1.7

FROM oven/bun:1.3.14

WORKDIR /repo

ARG DEBIAN_FRONTEND=noninteractive
ARG DEBIAN_MIRROR=http://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
ARG RUST_TOOLCHAIN=1.96.1
ARG CODEX_VERSION=0.145.0
ARG OFFICECLI_VERSION=v1.0.141
ARG TYPST_VERSION=v0.15.1
ARG TARGETARCH

ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_NET_RETRY=5
ENV CARGO_HTTP_TIMEOUT=120

RUN sed -i \
    -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
    -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
    /etc/apt/sources.list.d/debian.sources \
  && apt-get -o Acquire::Retries=5 update \
  && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    7zip \
    aria2 \
    bash \
    bubblewrap \
    build-essential \
    ca-certificates \
    chromium-headless-shell \
    coreutils \
    curl \
    ffmpeg \
    file \
    fontconfig \
    ghostscript \
    gh \
    git \
    gnupg \
    grep \
    imagemagick \
    jq \
    less \
    libzmq3-dev \
    libzmq5 \
    lsof \
    openssh-client \
    pandoc \
    pkg-config \
    poppler-utils \
    procps \
    protobuf-compiler \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    qpdf \
    ripgrep \
    rsync \
    tini \
    tree \
    unrar-free \
    unzip \
    util-linux \
    weasyprint \
    xz-utils \
    zip \
    zstd \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /agents \
  && chmod 0775 /agents

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
  | sh -s -- -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
  && rustc --version \
  && cargo --version

RUN set -eux; \
  installed=0; \
  for attempt in 1 2 3; do \
    if bun add -g "@openai/codex@${CODEX_VERSION}"; then installed=1; break; fi; \
    rm -rf /root/.bun/install/cache/* /tmp/bun-*; \
    sleep $((attempt * 5)); \
  done; \
  test "$installed" = 1; \
  rm -f /usr/local/bin/codex; \
  printf '%s\n' '#!/usr/bin/env sh' 'exec /usr/local/bin/bun /root/.bun/install/global/node_modules/@openai/codex/bin/codex.js "$@"' > /usr/local/bin/codex; \
  chmod +x /usr/local/bin/codex; \
  test "$(codex --version)" = "codex-cli ${CODEX_VERSION}"

RUN apt-get -o Acquire::Retries=5 update \
  && apt-get -o Acquire::Retries=5 install -y --no-install-recommends libicu-dev \
  && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
  case "${TARGETARCH:-$(uname -m)}" in \
    amd64|x86_64) officecli_asset="officecli-linux-x64" ;; \
    arm64|aarch64) officecli_asset="officecli-linux-arm64" ;; \
    *) echo "Unsupported OfficeCLI architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
  esac; \
  officecli_base_url="https://github.com/iOfficeAI/OfficeCLI/releases/download/${OFFICECLI_VERSION}"; \
  curl -fsSL "${officecli_base_url}/SHA256SUMS" -o /tmp/officecli-SHA256SUMS; \
  curl -fsSL "${officecli_base_url}/${officecli_asset}" -o /usr/local/bin/officecli; \
  expected="$(awk -v asset="${officecli_asset}" '$2 == asset { print $1; exit }' /tmp/officecli-SHA256SUMS)"; \
  test -n "${expected}"; \
  printf '%s  %s\n' "${expected}" /usr/local/bin/officecli | sha256sum -c -; \
  chmod +x /usr/local/bin/officecli; \
  test "$(officecli --version)" = "${OFFICECLI_VERSION#v}"; \
  rm -f /tmp/officecli-SHA256SUMS

# Typst is not packaged for Debian trixie, so the pinned release binary is
# installed here. Its releases publish no checksum file, so the digests below
# are recorded from the pinned assets and must be updated with the version.
RUN set -eux; \
  case "${TARGETARCH:-$(uname -m)}" in \
    amd64|x86_64) \
      typst_asset="typst-x86_64-unknown-linux-musl"; \
      typst_sha256="a6d077d0a95eed5a2eba715b2dae06be954f624ccbf85758a03f389ded33118c" ;; \
    arm64|aarch64) \
      typst_asset="typst-aarch64-unknown-linux-musl"; \
      typst_sha256="5aa8d74a3d906e60ea12a66ac2f37f8eef1b14cbad7182a745e393a10c23dcee" ;; \
    *) echo "Unsupported Typst architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
  esac; \
  curl -fsSL "https://github.com/typst/typst/releases/download/${TYPST_VERSION}/${typst_asset}.tar.xz" \
    -o /tmp/typst.tar.xz; \
  printf '%s  %s\n' "${typst_sha256}" /tmp/typst.tar.xz | sha256sum -c -; \
  tar -xJf /tmp/typst.tar.xz -C /tmp; \
  install -m 0755 "/tmp/${typst_asset}/typst" /usr/local/bin/typst; \
  rm -rf /tmp/typst.tar.xz "/tmp/${typst_asset}"; \
  typst --version | grep -qF "typst ${TYPST_VERSION#v}"

RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh \
  && python3 -m venv /opt/ankole-python \
  && for attempt in 1 2 3; do \
    if /usr/local/bin/uv pip install --python /opt/ankole-python/bin/python \
      blake3 \
      defusedxml \
      duckdb \
      imageio \
      ipykernel \
      jupyter-client \
      jupyter-server \
      jupyterlab \
      "markitdown[pptx]" \
      matplotlib \
      matplotlib-inline \
      nano-pdf \
      nbformat \
      numpy \
      opencv-python-headless \
      openpyxl \
      pandas \
      pillow \
      polars \
      pyarrow \
      pydantic \
      python-docx \
      python-pptx \
      requests \
      scipy \
      websocket-client; then \
      break; \
    fi; \
    if [ "$attempt" = "3" ]; then exit 1; fi; \
    sleep $((attempt * 10)); \
  done \
  && find /opt/ankole-python/bin -maxdepth 1 -type f -perm /111 -exec ln -sf {} /usr/local/bin/ \; \
  && rm -f /usr/local/bin/python /usr/local/bin/python3 \
  && printf '%s\n' '#!/usr/bin/env sh' 'exec /opt/ankole-python/bin/python "$@"' > /usr/local/bin/python \
  && cp /usr/local/bin/python /usr/local/bin/python3 \
  && chmod +x /usr/local/bin/python /usr/local/bin/python3

ARG PLEX_SANS_SC_REF=%40ibm%2Fplex-sans-sc%401.1.0
ARG PLEX_MONO_SC_COMMIT=2e832144509b0bd3d933a045b411ff5f2bc9616f
ARG CHILL_JINSHU_SONG_VERSION=GBv2.0
ARG FLUENT_EMOJI_COMMIT=b7fc5ad4ceb3c7d665087040073d4b64490af96f
ARG OTF2TTF_VERSION=0.2
ARG FONTTOOLS_VERSION=4.63.0

# The three text families are IBM Plex Sans SC (sans), IBMPlexMonoSCHalf (mono),
# and ChillJinshuSong (serif); Fluent Emoji Color carries emoji. Sans and mono
# install Light 300, Regular 400, Medium 500, SemiBold 600, and Bold 700, because
# 600 is the visual identity's heading and emphasis weight. The serif release has
# no SemiBold, so it installs the other four, and a 600 request in serif text
# resolves to Bold rather than a synthetic face. Every installed face is
# TrueType, because an OpenType/CFF face has caused reader compatibility
# problems, so the serif OTF release is converted during the build. Debian
# packages none of these, so pin upstream files.
RUN set -eux; \
  plex_sc_dir=/usr/share/fonts/truetype/ibm-plex-sans-sc; \
  plex_sc_base="https://raw.githubusercontent.com/IBM/plex/${PLEX_SANS_SC_REF}/packages/plex-sans-sc/fonts/complete/ttf/hinted"; \
  mkdir -p "${plex_sc_dir}"; \
  printf '%s\n' \
    'd626327fe664ee2b360055d007c98954a73fa1f642b477e041d9158c4fec5b52  IBMPlexSansSC-Light.ttf' \
    '012e587c5a78d25f456057614b880fc7450b748c352573d8052245df2a71158a  IBMPlexSansSC-Regular.ttf' \
    '6e6a084fd3f43c2c6f6d662cbc4c7b09987bafd928c43e91c8e8f68c6ae01e31  IBMPlexSansSC-Medium.ttf' \
    '76706e94340ac068ec2d398dc2f387946c815a3610f35c41cc93a8f8097d6c6b  IBMPlexSansSC-SemiBold.ttf' \
    '3e94ef1df394eae336cc1bc98f2160b58e2cab186f47d820e4c808aef1f4e28f  IBMPlexSansSC-Bold.ttf' \
    '91c25c350d3cac39da2736d74f7ba37ef648f5237a4e330a240615bc8d8c4360  license.txt' \
    > /tmp/plex-sans-sc.sha256; \
  while read -r _checksum file; do \
    curl -fsSL --retry 5 --retry-all-errors "${plex_sc_base}/${file}" -o "${plex_sc_dir}/${file}"; \
  done < /tmp/plex-sans-sc.sha256; \
  (cd "${plex_sc_dir}" && sha256sum -c /tmp/plex-sans-sc.sha256); \
  plex_mono_dir=/usr/share/fonts/truetype/ibm-plex-mono-sc; \
  plex_mono_base="https://raw.githubusercontent.com/WuLaNaLashi/IBM-Plex-Mono-SC/${PLEX_MONO_SC_COMMIT}"; \
  mkdir -p "${plex_mono_dir}"; \
  printf '%s\n' \
    'b5a65141cfddcb8588fb529fdcb2bb745c965eb681a4c10454a7d2420ba153e6  half_merged/IBMPlexMonoSCHalf-Light.ttf' \
    '5787a22435e2df2df2750cba1ccfabd13f8928fe8508bd160a52cd766cb98178  half_merged/IBMPlexMonoSCHalf-Regular.ttf' \
    'e9841b143dc35f2236568a24406c715d541fb70dccb52147e27c2ad00e6a98d4  half_merged/IBMPlexMonoSCHalf-Medium.ttf' \
    '3ac880c94746a35c73b687200c398ed152d10e46af49610b63809b55f4c230f3  half_merged/IBMPlexMonoSCHalf-SemiBold.ttf' \
    '687a51a66e6541604df2b3637801f9bb24d740aca8fd52fe0f2fca4ac1a9f14a  half_merged/IBMPlexMonoSCHalf-Bold.ttf' \
    '91c25c350d3cac39da2736d74f7ba37ef648f5237a4e330a240615bc8d8c4360  license.txt' \
    > /tmp/plex-mono-sc.sha256; \
  while read -r _checksum file; do \
    curl -fsSL --retry 5 --retry-all-errors "${plex_mono_base}/${file}" -o "${plex_mono_dir}/$(basename "${file}")"; \
  done < /tmp/plex-mono-sc.sha256; \
  (cd "${plex_mono_dir}" && sed 's#half_merged/##' /tmp/plex-mono-sc.sha256 | sha256sum -c -); \
  chill_dir=/usr/share/fonts/truetype/chill-jinshu-song; \
  mkdir -p "${chill_dir}" /tmp/chill-otf; \
  curl -fsSL --retry 5 --retry-all-errors \
    "https://github.com/Warren2060/ChillJinshuSong/releases/download/${CHILL_JINSHU_SONG_VERSION}/ChillJinshuSong_v2.0.zip" \
    -o /tmp/chill.zip; \
  echo 'a5a066c1fdf47b275f17b17473f63800564f55da510206f775fdfd94ddb9fe5f  /tmp/chill.zip' | sha256sum -c -; \
  curl -fsSL --retry 5 --retry-all-errors \
    "https://raw.githubusercontent.com/Warren2060/ChillJinshuSong/master/LICENSE" -o "${chill_dir}/LICENSE"; \
  echo "027f6f68aa3c651a771d3368e7d1620acaeadfd5d00d23da44332565bc151869  ${chill_dir}/LICENSE" | sha256sum -c -; \
  unzip -j -q /tmp/chill.zip \
    '*/otf/ChillJinshuSongLight.otf' \
    '*/otf/ChillJinshuSongRegular.otf' \
    '*/otf/ChillJinshuSongMedium.otf' \
    '*/otf/ChillJinshuSongBold.otf' \
    -d /tmp/chill-otf; \
  python3 -m venv /tmp/otf2ttf-venv; \
  /tmp/otf2ttf-venv/bin/pip install --quiet --no-cache-dir \
    "otf2ttf==${OTF2TTF_VERSION}" "fonttools==${FONTTOOLS_VERSION}"; \
  for otf in /tmp/chill-otf/*.otf; do \
    /tmp/otf2ttf-venv/bin/otf2ttf -o "${chill_dir}/$(basename "${otf%.otf}").ttf" "${otf}"; \
  done; \
  test "$(ls -1 "${chill_dir}"/*.ttf | wc -l)" = 4; \
  emoji_dir=/usr/share/fonts/truetype/fluent-emoji-color; \
  emoji_base="https://raw.githubusercontent.com/tetunori/fluent-emoji-webfont/${FLUENT_EMOJI_COMMIT}"; \
  mkdir -p "${emoji_dir}"; \
  curl -fsSL --retry 5 --retry-all-errors "${emoji_base}/dist/FluentEmojiColor.ttf" \
    -o "${emoji_dir}/FluentEmojiColor.ttf"; \
  curl -fsSL --retry 5 --retry-all-errors "${emoji_base}/LICENSE" -o "${emoji_dir}/LICENSE"; \
  printf '%s\n' \
    '6292f3ff969d800d55486e01b293248ccd9ee71a17e4f9770b4abea13d9cad25  FluentEmojiColor.ttf' \
    'fb1246b39d87fbea480a9bca5ed27483fd13b95ee400de3b4277414132f847ee  LICENSE' \
    > /tmp/fluent-emoji.sha256; \
  (cd "${emoji_dir}" && sha256sum -c /tmp/fluent-emoji.sha256); \
  printf '%s\n' \
    '<?xml version="1.0"?>' \
    '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">' \
    '<fontconfig>' \
    '  <alias binding="strong"><family>IBM Plex Sans</family><prefer><family>IBM Plex Sans SC</family></prefer></alias>' \
    '  <alias binding="strong"><family>IBM Plex Mono</family><prefer><family>IBMPlexMonoSCHalf</family></prefer></alias>' \
    '  <alias binding="strong"><family>ChillJinshuSong</family><prefer><family>寒蝉锦书宋</family></prefer></alias>' \
    '  <alias binding="strong"><family>emoji</family><prefer><family>Fluent Emoji Color</family></prefer></alias>' \
    '  <alias binding="strong"><family>sans-serif</family><prefer><family>IBM Plex Sans SC</family><family>Fluent Emoji Color</family></prefer></alias>' \
    '  <alias binding="strong"><family>serif</family><prefer><family>寒蝉锦书宋</family><family>Fluent Emoji Color</family></prefer></alias>' \
    '  <alias binding="strong"><family>monospace</family><prefer><family>IBMPlexMonoSCHalf</family><family>Fluent Emoji Color</family></prefer></alias>' \
    '</fontconfig>' \
    > /etc/fonts/conf.d/52-ankole-brand-fonts.conf; \
  fc-cache -f >/dev/null; \
  fc-match sans-serif | grep -F 'IBM Plex Sans SC'; \
  fc-match serif | grep -F 'ChillJinshuSong'; \
  fc-match monospace | grep -F 'IBMPlexMonoSCHalf'; \
  fc-match emoji | grep -F 'FluentEmojiColor'; \
  fc-match 'IBM Plex Sans' | grep -F 'IBM Plex Sans SC'; \
  fc-match 'IBM Plex Mono' | grep -F 'IBMPlexMonoSCHalf'; \
  fc-match 'ChillJinshuSong' | grep -F 'ChillJinshuSong'; \
  rm -rf /tmp/plex-sans-sc.sha256 /tmp/plex-mono-sc.sha256 /tmp/fluent-emoji.sha256 \
    /tmp/chill.zip /tmp/chill-otf /tmp/otf2ttf-venv

RUN rm -f /usr/local/bin/node /usr/local/bun-node-fallback-bin/node \
  && ! command -v node \
  && bun --version >/dev/null
