+/// Match a complete row by column order when its measured boxes intersect
+/// the corresponding column lanes. Headers and numbers need not share a left edge.
+pub(crate) fn complete_row_columns(
+    columns: &[f32],
+    items: &[(usize, &TextItem)],
+) -> Option<Vec<(usize, usize)>> {
+    if columns.len() < 2 || items.len() != columns.len() {
+        return None;
+    }
+    let mut row = items.to_vec();
+    row.sort_by(|a, b| a.1.x.total_cmp(&b.1.x));
+    if row
+        .iter()
+        .any(|(_, item)| !item.advance_known || !item.width.is_finite() || item.width <= 0.0)
+        || row
+            .windows(2)
+            .any(|pair| pair[0].1.x + pair[0].1.width > pair[1].1.x)
+    {
+        return None;
+    }
+    for (col, (_, item)) in row.iter().enumerate() {
+        let left = if col == 0 {
+            columns[0] - (columns[1] - columns[0]) / 2.0
+        } else {
+            (columns[col - 1] + columns[col]) / 2.0
+        };
+        let right = if col + 1 == columns.len() {
+            columns[col] + (columns[col] - columns[col - 1]) / 2.0
+        } else {
+            (columns[col] + columns[col + 1]) / 2.0
+        };
+        if item.x + item.width < left || item.x > right {
+            return None;
+        }
+    }
+    Some(
+        row.into_iter()
+            .enumerate()
+            .map(|(col, (idx, _))| (idx, col))
+            .collect(),
+    )
+}
