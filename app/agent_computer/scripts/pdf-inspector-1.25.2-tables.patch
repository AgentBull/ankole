+    fn complete_rows_keep_columns_with_different_text_alignment() {
+        let columns = vec![50.0, 130.0, 412.0, 516.0];
+        let mut items = vec![
+            make_item("Item", 50.0, 730.0, 10.0),
+            make_item("Description", 130.0, 730.0, 10.0),
+            make_item("Quantity", 340.0, 730.0, 10.0),
+            make_item("Amount", 440.0, 730.0, 10.0),
+        ];
+        fn indexed(items: &[TextItem]) -> Vec<(usize, &TextItem)> {
+            items.iter().enumerate().collect()
+        }
+        assert_eq!(
+            complete_row_columns(&columns, &indexed(&items)),
+            Some(vec![(0, 0), (1, 1), (2, 2), (3, 3)])
