 #[op2(async)]
+pub async fn op_user_worker_retire(
+  state: Rc<RefCell<OpState>>,
+  #[string] key: String,
+) -> Result<(), AnyError> {
+  let msg_tx = {
+    state
+      .borrow()
+      .borrow::<mpsc::UnboundedSender<UserWorkerMsgs>>()
+      .clone()
+  };
+  let (tx, rx) = oneshot::channel();
+  msg_tx.send(UserWorkerMsgs::Retire(Uuid::parse_str(&key)?, tx))?;
+  rx.await?;
+  Ok(())
+}
+
