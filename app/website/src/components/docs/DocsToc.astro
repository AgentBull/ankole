---
import type { MarkdownHeading } from 'astro'
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/utils'

interface Props {
	lang: Locale
	headings: MarkdownHeading[]
}

const { lang, headings } = Astro.props
const toc = headings.filter(h => h.depth === 2 || h.depth === 3)
---

{
	toc.length > 0 && (
		<aside class="hidden lg:sticky lg:top-14 lg:max-h-[calc(100vh-3.5rem)] lg:self-start lg:overflow-y-auto lg:py-10 xl:block">
			<nav aria-label={t(lang, 'docs.toc.title')}>
				<h2 class="px-3 text-xs font-semibold uppercase tracking-widest text-muted-foreground">
					{t(lang, 'docs.toc.title')}
				</h2>
				<ul class="mt-2 list-none space-y-0.5 border-l border-border p-0">
					{toc.map(heading => (
						<li>
							<a
								href={`#${heading.slug}`}
								class:list={[
									'block py-1 text-sm text-muted-foreground no-underline transition-colors hover:text-foreground',
									heading.depth === 3 ? 'pl-7' : 'pl-3'
								]}
							>
								{heading.text}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</aside>
	)
}
