---
import { RiGithubFill, RiMenuLine } from '@remixicon/react'
import logo from '../assets/logo.svg'
import { ANKOLE_AI_URL, GITHUB_URL, getSiteTitle } from '../consts'
import type { Locale } from '../i18n/config'
import { localePath, t } from '../i18n/utils'
import ThemeToggle from './ThemeToggle'

interface Props {
	lang: Locale
}

const { lang } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const pathname = Astro.url.pathname
const siteTitle = getSiteTitle(lang)
const mobileMenuId = `site-nav-toggle-${lang}`

const docsHref = localePath(lang, 'docs')
const docsActive = pathname.startsWith(`${base}/${lang}/docs`)

const navLinkClass =
	'inline-flex h-9 items-center px-3 text-sm text-fg-secondary no-underline transition-colors hover:bg-layer-03 hover:text-fg-primary'
const navLinkActiveClass = 'text-fg-primary'
---

<header class="sticky top-0 z-40 border-b border-border-subtle bg-page">
	<div class="mx-auto flex h-14 max-w-7xl items-center gap-2 px-4 sm:px-6">
		<a href={localePath(lang)} class="flex shrink-0 items-center gap-2 no-underline">
			<img src={logo.src} alt="" width="24" height="24" class="size-6" />
			<span class="text-base font-semibold tracking-tight text-fg-primary">{siteTitle}</span>
		</a>

		<nav class="ml-6 hidden items-center gap-1 sm:flex">
			<a href={docsHref} class:list={[navLinkClass, docsActive && navLinkActiveClass]}>{t(lang, 'nav.docs')}</a>
			<a href={GITHUB_URL} target="_blank" rel="noreferrer" class={navLinkClass}>
				<RiGithubFill className="mr-1.5 size-4" />
				{t(lang, 'nav.github')}
			</a>
			<a href={ANKOLE_AI_URL} target="_blank" rel="noreferrer" class={navLinkClass}>{t(lang, 'nav.ankoleAi')}</a>
		</nav>

		<div class="ml-auto flex shrink-0 items-center gap-1">
			<ThemeToggle
				client:load
				labelDark={t(lang, 'nav.theme.toDark')}
				labelLight={t(lang, 'nav.theme.toLight')}
			/>

			<label
				for={mobileMenuId}
				class="inline-flex size-9 cursor-pointer items-center justify-center text-fg-secondary transition-colors hover:bg-layer-03 hover:text-fg-primary sm:hidden"
			>
				<span class="sr-only">{t(lang, 'nav.menu')}</span>
				<RiMenuLine className="size-5" aria-hidden="true" />
			</label>
		</div>
	</div>

	<input id={mobileMenuId} type="checkbox" class="peer sr-only" />
	<nav class="hidden border-t border-border-subtle peer-checked:block sm:hidden">
		<div class="flex flex-col px-4 py-2">
			<a href={docsHref} class:list={[navLinkClass, docsActive && navLinkActiveClass]}>{t(lang, 'nav.docs')}</a>
			<a href={GITHUB_URL} target="_blank" rel="noreferrer" class={navLinkClass}>
				<RiGithubFill className="mr-1.5 size-4" />
				{t(lang, 'nav.github')}
			</a>
			<a href={ANKOLE_AI_URL} target="_blank" rel="noreferrer" class={navLinkClass}>{t(lang, 'nav.ankoleAi')}</a>
		</div>
	</nav>
</header>
