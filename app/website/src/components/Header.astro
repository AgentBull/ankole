---
import { RiGithubFill, RiMenuLine } from '@remixicon/react'
import logo from '../assets/logo.svg'
import { GITHUB_URL, getSiteTitle } from '../consts'
import { LOCALE_LABELS, LOCALES, type Locale } from '../i18n/config'
import { localePath, t } from '../i18n/utils'
import LanguageDropdown from './LanguageDropdown'
import ThemeToggle from './ThemeToggle'

interface Props {
	lang: Locale
}

const { lang } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const pathname = Astro.url.pathname
const pathWithoutLang = pathname.replace(new RegExp(`^${base}/${lang}(/|$)`), '/')
const siteTitle = getSiteTitle(lang)
const mobileMenuId = `site-nav-toggle-${lang}`

const docsHref = localePath(lang, 'docs')
const docsActive = pathname.startsWith(`${base}/${lang}/docs`)

const localeItems = LOCALES.map(locale => ({
	href: `${base}/${locale}${pathWithoutLang === '/' ? '/' : pathWithoutLang}`,
	label: LOCALE_LABELS[locale],
	active: locale === lang
}))

const navLinkClass =
	'inline-flex h-9 items-center px-3 text-sm text-muted-foreground no-underline transition-colors hover:bg-muted hover:text-foreground'
const navLinkActiveClass = 'text-foreground'
---

<header class="sticky top-0 z-40 border-b border-border bg-background">
	<div class="mx-auto flex h-14 max-w-7xl items-center gap-2 px-4 sm:px-6">
		<a href={localePath(lang)} class="flex shrink-0 items-center gap-2 no-underline">
			<img src={logo.src} alt="" width="24" height="24" class="size-6" />
			<span class="text-base font-semibold tracking-tight text-foreground">{siteTitle}</span>
		</a>

		<nav class="ml-6 hidden items-center gap-1 sm:flex">
			<a href={docsHref} class:list={[navLinkClass, docsActive && navLinkActiveClass]}>{t(lang, 'nav.docs')}</a>
			<a href={GITHUB_URL} target="_blank" rel="noreferrer" class={navLinkClass}>
				<RiGithubFill className="mr-1.5 size-4" />
				{t(lang, 'nav.github')}
			</a>
		</nav>

		<div class="ml-auto flex shrink-0 items-center gap-1">
			<LanguageDropdown client:load label={t(lang, 'nav.languages')} items={localeItems} />
			<ThemeToggle
				client:load
				labelDark={t(lang, 'nav.theme.toDark')}
				labelLight={t(lang, 'nav.theme.toLight')}
			/>

			<label
				for={mobileMenuId}
				class="inline-flex size-9 cursor-pointer items-center justify-center text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:hidden"
			>
				<span class="sr-only">{t(lang, 'nav.menu')}</span>
				<RiMenuLine className="size-5" aria-hidden="true" />
			</label>
		</div>
	</div>

	<input id={mobileMenuId} type="checkbox" class="peer sr-only" />
	<nav class="hidden border-t border-border peer-checked:block sm:hidden">
		<div class="flex flex-col px-4 py-2">
			<a href={docsHref} class:list={[navLinkClass, docsActive && navLinkActiveClass]}>{t(lang, 'nav.docs')}</a>
			<a href={GITHUB_URL} target="_blank" rel="noreferrer" class={navLinkClass}>
				<RiGithubFill className="mr-1.5 size-4" />
				{t(lang, 'nav.github')}
			</a>
		</div>
	</nav>
</header>
