---
/**
 * Sends the site root to the default locale.
 */
import { DEFAULT_LOCALE } from '../i18n/config'
import { localePath, t } from '../i18n/utils'

const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const target = localePath(DEFAULT_LOCALE)
// Agents that fetch the site root do not run the redirect script, so the page names the index.
const llmsIndexUrl = new URL(`${base}/llms.txt`, Astro.site).href
---

<!doctype html>
<html>
	<head>
		<meta charset="utf-8" />
		<title>Redirecting…</title>
		<script is:inline define:vars={{ target }}>
			window.location.replace(target)
		</script>
		<noscript>
			<meta http-equiv="refresh" content={`0;url=${target}`} />
		</noscript>
		<link rel="alternate" type="text/plain" title="LLM index" href={llmsIndexUrl} />
	</head>
	<body>
		<p>{t(DEFAULT_LOCALE, 'agent.directive.site', { index: llmsIndexUrl })}</p>
	</body>
</html>
