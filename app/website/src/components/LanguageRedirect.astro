---
/**
 * Client-side language detection and redirect.
 * Used on non-prefixed URLs to redirect to /{lang}/...
 */
import { DEFAULT_LOCALE } from '../i18n/config'
import { t } from '../i18n/utils'

interface Props {
	/** The path after the lang prefix, e.g. "docs" */
	path?: string
}
const { path = '' } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const targetPath = path ? `/${path}/` : '/'
// Agents that fetch the site root do not run the redirect script, so the page names the index.
const llmsIndexUrl = new URL(`${base}/llms.txt`, Astro.site).href
---

<!doctype html>
<html>
	<head>
		<meta charset="utf-8" />
		<title>Redirecting…</title>
		<script is:inline define:vars={{ base, targetPath }}>
			;(function () {
				var map = { en: 'en-US', zh: 'zh-Hans-CN', ja: 'ja-JP', ko: 'ko-KR' }
				var langs = (navigator.languages || [navigator.language || 'en']).map(function (l) {
					return l.split('-')[0].toLowerCase()
				})
				var lang = 'en-US'
				for (var i = 0; i < langs.length; i++) {
					if (map[langs[i]]) {
						lang = map[langs[i]]
						break
					}
				}
				window.location.replace(`${base}/${lang}${targetPath}`)
			})()
		</script>
		<noscript>
			<meta http-equiv="refresh" content={`0;url=${base}/en-US${targetPath}`} />
		</noscript>
		<link rel="alternate" type="text/plain" title="LLM index" href={llmsIndexUrl} />
	</head>
	<body>
		<p>{t(DEFAULT_LOCALE, 'agent.directive.site', { index: llmsIndexUrl })}</p>
	</body>
</html>
