---
import {
	RiComputerLine,
	RiDashboardLine,
	RiDatabase2Line,
	RiGroupLine,
	RiPlugLine,
	RiTimeLine
} from '@remixicon/react'
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/utils'
import Reveal from '../Reveal'
import Section from './Section.astro'
import SectionHeading from './SectionHeading.astro'

interface Props {
	lang: Locale
}

const { lang } = Astro.props

const cards = [
	{ icon: RiPlugLine, key: 'sources' },
	{ icon: RiGroupLine, key: 'agents' },
	{ icon: RiTimeLine, key: 'sessions' },
	{ icon: RiDatabase2Line, key: 'context' },
	{ icon: RiDashboardLine, key: 'control' },
	{ icon: RiComputerLine, key: 'computer' }
].map(({ icon, key }) => ({
	icon,
	title: t(lang, `features.${key}.title`),
	body: t(lang, `features.${key}.body`)
}))
---

<Section tone="raised">
	<SectionHeading
		index="03"
		eyebrow={t(lang, 'section.features')}
		title={t(lang, 'features.title')}
		subtitle={t(lang, 'features.subtitle')}
	/>

	<div class="mt-14 grid gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
		{
			cards.map((card, index) => (
				<Reveal client:visible={{ rootMargin: '200px' }} delay={(index % 3) * 0.06} className="bg-background">
					<div class="group relative h-full p-8">
						<span
							class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-brand-60 transition-transform duration-200 ease-[var(--ease-productive)] group-hover:scale-x-100 dark:bg-brand-40"
							aria-hidden="true"
						/>
						<div class="flex size-11 items-center justify-center bg-brand-60/10 text-brand-60 transition-colors duration-200 ease-[var(--ease-productive)] group-hover:bg-brand-60 group-hover:text-white dark:bg-brand-40/15 dark:text-brand-40 dark:group-hover:bg-brand-50">
							<card.icon className="size-5" aria-hidden="true" />
						</div>
						<h3 class="mt-6 text-base font-semibold text-foreground">{card.title}</h3>
						<p class="mt-3 text-sm leading-6 text-muted-foreground">{card.body}</p>
					</div>
				</Reveal>
			))
		}
	</div>
</Section>
