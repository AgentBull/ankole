---
import {
	RiComputerLine,
	RiDashboardLine,
	RiDatabase2Line,
	RiGroupLine,
	RiPlugLine,
	RiTimeLine
} from '@remixicon/react'
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/utils'

interface Props {
	lang: Locale
}

const { lang } = Astro.props

const cards = [
	{ icon: RiPlugLine, key: 'sources' },
	{ icon: RiGroupLine, key: 'agents' },
	{ icon: RiTimeLine, key: 'sessions' },
	{ icon: RiDatabase2Line, key: 'context' },
	{ icon: RiDashboardLine, key: 'control' },
	{ icon: RiComputerLine, key: 'computer' }
].map(({ icon, key }) => ({
	icon,
	title: t(lang, `features.${key}.title`),
	body: t(lang, `features.${key}.body`)
}))
---

<section class="border-b border-border bg-background-secondary">
	<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
		<h2 class="text-3xl font-semibold tracking-tight text-foreground">{t(lang, 'features.title')}</h2>
		<p class="mt-3 max-w-2xl text-muted-foreground">{t(lang, 'features.subtitle')}</p>
		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				cards.map(card => (
					<div class="border border-border bg-background p-6">
						<div class="flex size-10 items-center justify-center bg-brand-60/10 text-brand-60 dark:bg-brand-40/15 dark:text-brand-40">
							<card.icon className="size-5" aria-hidden="true" />
						</div>
						<h3 class="mt-4 text-base font-semibold text-foreground">{card.title}</h3>
						<p class="mt-2 text-sm leading-6 text-muted-foreground">{card.body}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
