---
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/utils'
import Reveal from '../Reveal.astro'
import Section from './Section.astro'
import SectionHeading from './SectionHeading.astro'

interface Props {
	lang: Locale
}

const { lang } = Astro.props

/*
 * The ledger is the section, not an illustration of it. A reader asking "does a
 * correction actually stick?" gets the answer by looking at four of them, each with
 * the date it landed and where it came from. The first row is the rule the hero
 * conversation creates, so the page shows a rule being born and then filed.
 */
const rules = ['r1', 'r2', 'r3', 'r4'].map(key => ({
	date: t(lang, `compounding.${key}.date`),
	rule: t(lang, `compounding.${key}.rule`),
	from: t(lang, `compounding.${key}.from`)
}))

---

<Section>
	<SectionHeading
		index="05"
		eyebrow={t(lang, 'section.compounding')}
		title={t(lang, 'compounding.title')}
		subtitle={t(lang, 'compounding.body')}
		wide
	/>

	{/*
	 * The ledger has no frame. A border would have set its contents on an axis of their
	 * own, twenty-one pixels inside the one the heading stands on; hairlines group the
	 * rows just as well and cost the page nothing in alignment.
	 */}
	<Reveal class="mt-16">
		<p class="flex items-baseline gap-3 border-b border-border pb-3">
			<span class="text-xs font-medium text-foreground">{t(lang, 'compounding.ledger.title')}</span>
			<span class="ml-auto font-mono text-[11px] text-fg-quaternary">
				{t(lang, 'compounding.ledger.count')}
			</span>
		</p>
		{/*
		 * The rules arrive one at a time as the ledger comes into view. The section claims
		 * corrections pile up, so the entrance piles them up rather than dropping four rows
		 * in at once — the motion states the argument the copy makes.
		 */}
		<ol class="list-none p-0">
			{
				rules.map((entry, index) => (
					<li class="record border-b border-border/60">
						<Reveal
							step={index}
							class="grid grid-cols-[3.5rem_minmax(0,1fr)] gap-x-6 py-5 sm:grid-cols-[5rem_minmax(0,1fr)]"
						>
							<span class="font-mono text-[11px] leading-7 text-fg-quaternary tabular-nums">
								{entry.date}
							</span>
							<span>
								<span class="block leading-7 text-foreground">{entry.rule}</span>
								<span class="record-quiet mt-1 block text-xs leading-5 text-fg-quaternary">
									{entry.from}
								</span>
							</span>
						</Reveal>
					</li>
				))
			}
		</ol>
	</Reveal>

	{/*
	 * What happens to a rule after it lands. Told as prose, not another grid: section 04
	 * already lists what makes a colleague different, so this section answers the one
	 * question the ledger raises — why a correction stays corrected. The argument runs
	 * log, adjudication, objective; the closing paragraph steps up to full foreground.
	 */}
	<p class="mt-16 font-mono text-xs tracking-[0.12em] text-fg-quaternary uppercase">
		{t(lang, 'compounding.after')}
	</p>

	<div class="mt-6 max-w-2xl space-y-6">
		<Reveal>
			<p class="leading-8 text-muted-foreground">{t(lang, 'compounding.log.p1')}</p>
		</Reveal>
		<Reveal step={1}>
			<p class="leading-8 text-muted-foreground">{t(lang, 'compounding.log.p2')}</p>
		</Reveal>
		<Reveal step={2}>
			<p class="leading-8 text-foreground">{t(lang, 'compounding.log.p3')}</p>
		</Reveal>
	</div>

	<Reveal class="mt-16">
		<div class="border-t border-border pt-8">
			<h3 class="max-w-2xl text-xl font-semibold text-balance text-foreground">
				{t(lang, 'compounding.proof.title')}
			</h3>
			<p class="mt-4 max-w-2xl leading-8 text-muted-foreground">{t(lang, 'compounding.proof.body')}</p>
		</div>
	</Reveal>
</Section>
