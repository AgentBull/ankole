---
import { buttonVariants } from '@ankole/uikit/components/button'
import { RiArrowRightLine, RiGithubFill } from '@remixicon/react'
import { GITHUB_URL } from '../../consts'
import type { Locale } from '../../i18n/config'
import { localePath, t } from '../../i18n/utils'

interface Props {
	lang: Locale
}

const { lang } = Astro.props
---

<section class="border-b border-border">
	<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-32">
		<span
			class="inline-flex items-center gap-2 border border-border px-3 py-1 text-xs font-medium tracking-wide text-muted-foreground"
		>
			<span class="size-1.5 bg-brand-60 dark:bg-brand-40" aria-hidden="true"></span>
			{t(lang, 'hero.badge')}
		</span>
		<h1 class="mt-6 max-w-3xl text-4xl font-semibold tracking-tight text-foreground sm:text-6xl">
			{t(lang, 'hero.title')}
		</h1>
		<p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
			{t(lang, 'hero.subtitle')}
		</p>
		<div class="mt-10 flex flex-wrap items-center gap-3">
			<a href={localePath(lang, 'docs/quickstart')} class={buttonVariants({ size: 'lg' })}>
				{t(lang, 'hero.cta.primary')}
				<RiArrowRightLine />
			</a>
			<a href={GITHUB_URL} target="_blank" rel="noreferrer" class={buttonVariants({ variant: 'outline', size: 'lg' })}>
				<RiGithubFill />
				{t(lang, 'hero.cta.secondary')}
			</a>
		</div>
	</div>
</section>
