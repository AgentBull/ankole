---
import { buttonVariants } from '@ankole/uikit/components/button'
import { RiArrowRightLine, RiGithubFill } from '@remixicon/react'
import { GITHUB_URL } from '../../consts'
import type { Locale } from '../../i18n/config'
import { localePath, t } from '../../i18n/utils'
import HeroThread from './HeroThread.astro'

interface Props {
	lang: Locale
}

const { lang } = Astro.props

/** Runtime names, kept literal in every locale. */
const STACK = ['Elixir · OTP', 'Rust kernel', 'Bun · TypeScript', 'PostgreSQL', 'ZeroMQ', 'Apache-2.0']
---

<section class="relative overflow-hidden border-b border-border">
	<div
		class="grid-field pointer-events-none absolute inset-0 [mask-image:radial-gradient(80%_60%_at_20%_0%,black,transparent)]"
		aria-hidden="true"
	>
	</div>
	<div class="brand-plane pointer-events-none absolute inset-0" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6">
		{/*
		 * The two columns sit on different baselines on purpose. A centred pair reads
		 * as a diagram; an offset pair gives the eye a diagonal to travel and leaves
		 * the white space an uneven shape, which is the point of it.
		 */}
		<div
			class="grid gap-12 border-x border-border/70 px-4 pt-16 pb-14 sm:px-8 sm:pt-20 lg:grid-cols-[1.15fr_minmax(0,23.5rem)] lg:gap-16 lg:pt-24 lg:pb-20"
		>
			<div class="lg:pr-6">
				{/* No pulse. A dot beating forever next to a licence label says nothing, and
				    spending motion there costs the beats that do carry meaning. */}
				<span
					class="inline-flex items-center gap-2.5 border border-border bg-background/60 px-3 py-1.5 font-mono text-xs text-muted-foreground backdrop-blur-sm"
				>
					<span class="size-1.5 bg-brand-60 dark:bg-brand-40" aria-hidden="true"></span>
					{t(lang, 'hero.badge')}
				</span>

				{/* Each line is a separate string, so every locale controls its own break. */}
				<h1
					class="mt-8 text-[2.125rem] leading-[1.06] font-semibold tracking-tight text-foreground sm:text-6xl sm:leading-[1.02] lg:text-[4.75rem]"
				>
					<span class="block">{t(lang, 'hero.title.line1')}</span>
					<span class="block">{t(lang, 'hero.title.line2')}</span>
				</h1>

				<p class="mt-8 max-w-lg text-base leading-8 text-muted-foreground sm:text-lg">
					{t(lang, 'hero.subtitle')}
				</p>

				<div class="mt-10 flex flex-wrap items-center gap-3">
					<a href={localePath(lang, 'docs/quickstart')} class={buttonVariants({ size: 'lg' })}>
						{t(lang, 'hero.cta.primary')}
						<RiArrowRightLine />
					</a>
					<a
						href={GITHUB_URL}
						target="_blank"
						rel="noreferrer"
						class={buttonVariants({ variant: 'outline', size: 'lg' })}
					>
						<RiGithubFill />
						{t(lang, 'hero.cta.secondary')}
					</a>
				</div>
			</div>

			<div class="lg:mt-20">
				<HeroThread lang={lang} />
			</div>
		</div>
	</div>

	<div class="relative border-t border-border bg-background/50 backdrop-blur-sm">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<ul
				class="flex list-none flex-wrap items-center gap-x-8 gap-y-2 border-x border-border/70 px-4 py-4 font-mono text-xs text-fg-tertiary sm:px-8"
			>
				<li class="text-muted-foreground">{t(lang, 'hero.stack.label')}</li>
				{STACK.map(item => <li>{item}</li>)}
			</ul>
		</div>
	</div>
</section>
