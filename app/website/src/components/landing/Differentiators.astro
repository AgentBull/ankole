---
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/utils'

interface Props {
	lang: Locale
}

const { lang } = Astro.props

const items = ['shared', 'identity', 'sessions', 'context', 'control'].map(key => ({
	title: t(lang, `differentiators.${key}.title`),
	body: t(lang, `differentiators.${key}.body`)
}))
---

<section class="border-b border-border">
	<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
		<h2 class="text-3xl font-semibold tracking-tight text-foreground">{t(lang, 'differentiators.title')}</h2>
		<p class="mt-3 max-w-2xl text-muted-foreground">{t(lang, 'differentiators.subtitle')}</p>
		<ol class="mt-12 list-none border-t border-border p-0">
			{
				items.map((item, index) => (
					<li class="grid gap-2 border-b border-border py-6 sm:grid-cols-[4rem_1fr_2fr] sm:gap-8">
						<span class="font-mono text-sm leading-7 text-brand-60 dark:text-brand-40">
							{String(index + 1).padStart(2, '0')}
						</span>
						<h3 class="text-base font-semibold leading-7 text-foreground">{item.title}</h3>
						<p class="leading-7 text-muted-foreground">{item.body}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
