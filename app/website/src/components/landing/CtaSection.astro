---
import { buttonVariants } from '@ankole/uikit/components/button'
import { RiArrowRightLine, RiGithubFill } from '@remixicon/react'
import { GITHUB_URL } from '../../consts'
import type { Locale } from '../../i18n/config'
import { localePath, t } from '../../i18n/utils'

interface Props {
	lang: Locale
}

const { lang } = Astro.props
---

<section>
	<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24">
		<div class="border border-border bg-background-secondary p-8 sm:p-16">
			<h2 class="max-w-2xl text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">{t(lang, 'cta.title')}</h2>
			<p class="mt-4 max-w-2xl text-muted-foreground">{t(lang, 'cta.body')}</p>
			<div class="mt-8 flex flex-wrap items-center gap-3">
				<a href={localePath(lang, 'docs/quickstart')} class={buttonVariants({ size: 'lg' })}>
					{t(lang, 'cta.primary')}
					<RiArrowRightLine />
				</a>
				<a
					href={GITHUB_URL}
					target="_blank"
					rel="noreferrer"
					class={buttonVariants({ variant: 'outline', size: 'lg' })}
				>
					<RiGithubFill />
					{t(lang, 'cta.secondary')}
				</a>
			</div>
		</div>
	</div>
</section>
