---
import { buttonVariants } from '@ankole/uikit/components/button'
import { RiArrowRightLine, RiGithubFill } from '@remixicon/react'
import { GITHUB_URL } from '../../consts'
import type { Locale } from '../../i18n/config'
import { localePath, t } from '../../i18n/utils'
import Reveal from '../Reveal.astro'

interface Props {
	lang: Locale
}

const { lang } = Astro.props
---

{/*
 * The closing statement stands on the page axis like every heading above it. It used to
 * sit inside a padded panel, which pushed its title sixty-four pixels inboard of every
 * other title on the page — the one element that broke the column the whole page reads
 * down. The plane and the grid stay as a full-bleed ground behind it, and the type is
 * given the most air on the page, because this is where the reader either acts or leaves.
 */}
<section class="relative overflow-hidden">
	<div
		class="grid-field pointer-events-none absolute inset-0 [mask-image:radial-gradient(70%_80%_at_100%_50%,black,transparent)]"
		aria-hidden="true"
	>
	</div>
	<div class="brand-plane pointer-events-none absolute inset-0" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6">
		<div class="border-x border-border px-4 py-28 sm:px-8 sm:py-36">
			<Reveal variant="wipe">
				<h2
					class="max-w-3xl text-balance text-4xl leading-tight font-semibold tracking-tight text-foreground sm:text-6xl"
				>
					{t(lang, 'cta.title')}
				</h2>
				<p class="mt-8 max-w-xl leading-8 text-muted-foreground">{t(lang, 'cta.body')}</p>
				<div class="mt-12 flex flex-wrap items-center gap-3">
					<a href={localePath(lang, 'docs/quickstart')} class={buttonVariants({ size: 'lg' })}>
						{t(lang, 'cta.primary')}
						<RiArrowRightLine />
					</a>
					<a
						href={GITHUB_URL}
						target="_blank"
						rel="noreferrer"
						class={buttonVariants({ variant: 'outline', size: 'lg' })}
					>
						<RiGithubFill />
						{t(lang, 'cta.secondary')}
					</a>
				</div>
			</Reveal>
		</div>
	</div>
</section>
