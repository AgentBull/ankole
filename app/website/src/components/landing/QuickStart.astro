---
import type { Locale } from '../../i18n/config'
import { localePath, t } from '../../i18n/utils'
import QuickStartTabs from './QuickStartTabs'

interface Props {
	lang: Locale
}

const { lang } = Astro.props

const labels = {
	source: t(lang, 'quickstart.tabs.source'),
	docker: t(lang, 'quickstart.tabs.docker'),
	kubernetes: t(lang, 'quickstart.tabs.kubernetes'),
	copy: t(lang, 'quickstart.copy'),
	copied: t(lang, 'quickstart.copied'),
	sourceNote: t(lang, 'quickstart.source.note'),
	dockerNote: t(lang, 'quickstart.docker.note'),
	k8sBody: t(lang, 'quickstart.k8s.body'),
	k8sLink: t(lang, 'quickstart.k8s.link')
}
---

<section class="border-b border-border bg-background-secondary">
	<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
		<h2 class="text-3xl font-semibold tracking-tight text-foreground">{t(lang, 'quickstart.title')}</h2>
		<p class="mt-3 max-w-2xl text-muted-foreground">{t(lang, 'quickstart.subtitle')}</p>
		<div class="mt-8 max-w-3xl">
			<QuickStartTabs client:load labels={labels} installHref={localePath(lang, 'docs/installation')} />
		</div>
	</div>
</section>
