---
import type { Locale } from '../../i18n/config'
import { localePath, t } from '../../i18n/utils'
import QuickStartTabs from './QuickStartTabs'
import Section from './Section.astro'
import SectionHeading from './SectionHeading.astro'

interface Props {
	lang: Locale
}

const { lang } = Astro.props

const labels = {
	source: t(lang, 'quickstart.tabs.source'),
	docker: t(lang, 'quickstart.tabs.docker'),
	kubernetes: t(lang, 'quickstart.tabs.kubernetes'),
	copy: t(lang, 'quickstart.copy'),
	copied: t(lang, 'quickstart.copied'),
	sourceNote: t(lang, 'quickstart.source.note'),
	dockerNote: t(lang, 'quickstart.docker.note'),
	k8sBody: t(lang, 'quickstart.k8s.body'),
	k8sLink: t(lang, 'quickstart.k8s.link')
}
const deploymentHref = `${localePath(lang, 'docs/quickstart')}#deployment`
---

<Section tone="raised">
	<div class="grid gap-12 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-16">
		<SectionHeading
			index="02"
			eyebrow={t(lang, 'section.quickstart')}
			title={t(lang, 'quickstart.title')}
			subtitle={t(lang, 'quickstart.subtitle')}
		/>
		<div class="min-w-0">
			<QuickStartTabs client:visible labels={labels} deploymentHref={deploymentHref} />
		</div>
	</div>
</Section>
