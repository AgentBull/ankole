---
import { BrainRegular, CompassNorthwestRegular, GlobeRegular, PeopleRegular, PersonVoiceRegular, ShieldKeyholeRegular, SparkleRegular, TimerRegular } from '@ankole/uikit/icons'
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/utils'
import Reveal from '../Reveal.astro'
import Section from './Section.astro'
import SectionHeading from './SectionHeading.astro'

interface Props {
	lang: Locale
}

const { lang } = Astro.props

const read = (key: string) => ({
	title: t(lang, `capabilities.${key}.title`),
	body: t(lang, `capabilities.${key}.body`)
})

/*
 * Two capabilities carry the argument and six support it. Printing all eight at one
 * size in one boxed grid asks the reader to weigh them equally, which is the wrong
 * answer and reads as a spec sheet.
 */
const lead = [
	{ icon: TimerRegular, ...read('async') },
	{ icon: PersonVoiceRegular, ...read('tacit') }
]

const rest = [
	{ icon: BrainRegular, ...read('brain') },
	{ icon: CompassNorthwestRegular, ...read('research') },
	{ icon: GlobeRegular, ...read('browser') },
	{ icon: SparkleRegular, ...read('skills') },
	{ icon: PeopleRegular, ...read('multi') },
	{ icon: ShieldKeyholeRegular, ...read('enterprise') }
]
---

<Section tone="raised">
	<SectionHeading
		index="04"
		eyebrow={t(lang, 'section.capabilities')}
		title={t(lang, 'capabilities.title')}
		subtitle={t(lang, 'capabilities.subtitle')}
	/>

	<div class="mt-16 grid gap-x-16 gap-y-12 md:grid-cols-2">
		{
			lead.map((card, index) => (
				<Reveal step={index}>
					<div class="group border-t-2 border-brand-60 pt-6 dark:border-brand-40">
						<card.icon
							className="size-7 text-brand-60 transition-transform duration-300 ease-[var(--ease-productive)] group-hover:-translate-y-0.5 dark:text-brand-40"
							aria-hidden="true"
						/>
						<h3 class="mt-5 text-2xl font-semibold text-balance text-foreground">{card.title}</h3>
						<p class="mt-4 leading-8 text-muted-foreground">{card.body}</p>
					</div>
				</Reveal>
			))
		}
	</div>

	<div class="mt-20 grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
		{
			rest.map((card, index) => (
				<Reveal step={index % 3}>
					<div class="border-t border-border pt-5">
						<div class="flex items-center gap-2.5">
							<card.icon
								className="size-4 shrink-0 text-brand-60 dark:text-brand-40"
								aria-hidden="true"
							/>
							<h3 class="text-base font-semibold text-foreground">{card.title}</h3>
						</div>
						<p class="mt-3 text-sm leading-6 text-muted-foreground">{card.body}</p>
					</div>
				</Reveal>
			))
		}
	</div>
</Section>
