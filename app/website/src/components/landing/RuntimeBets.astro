---
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/utils'

interface Props {
	lang: Locale
}

const { lang } = Astro.props

const bets = ['actors', 'otp', 'fabric', 'computer', 'ledger'].map(key => ({
	title: t(lang, `bets.${key}.title`),
	body: t(lang, `bets.${key}.body`)
}))
---

<section class="border-b border-border bg-background-secondary">
	<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
		<h2 class="text-3xl font-semibold tracking-tight text-foreground">{t(lang, 'bets.title')}</h2>
		<p class="mt-3 max-w-3xl text-muted-foreground">{t(lang, 'bets.subtitle')}</p>
		<div class="mt-12 grid gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
			{
				bets.map((bet, index) => (
					<div class="bg-background p-6 first:sm:col-span-2 lg:first:col-span-1">
						<span class="font-mono text-sm text-brand-60 dark:text-brand-40">
							{String(index + 1).padStart(2, '0')}
						</span>
						<h3 class="mt-2 text-base font-semibold text-foreground">{bet.title}</h3>
						<p class="mt-2 text-sm leading-6 text-muted-foreground">{bet.body}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
