---
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/utils'
import Reveal from '../Reveal.astro'
import Section from './Section.astro'
import SectionHeading from './SectionHeading.astro'

interface Props {
	lang: Locale
}

const { lang } = Astro.props

const bets = ['actors', 'otp', 'fabric', 'computer', 'ledger'].map(key => ({
	title: t(lang, `bets.${key}.title`),
	body: t(lang, `bets.${key}.body`)
}))
---

<Section>
	<SectionHeading
		index="05"
		eyebrow={t(lang, 'section.bets')}
		title={t(lang, 'bets.title')}
		subtitle={t(lang, 'bets.subtitle')}
		wide
	/>

	{/*
	 * Set tighter than the difference statements above. Five bets read as reference rather
	 * than argument, so they take a denser rhythm on the same axis — the page changes pace
	 * between sections instead of printing one cell shape from top to bottom.
	 */}
	<ol class="mt-16 list-none p-0">
		{
			bets.map((bet, index) => (
				<li class="record border-t border-border py-6">
					<Reveal
						step={index}
						class="grid gap-x-12 gap-y-2 lg:grid-cols-[3rem_minmax(0,20rem)_minmax(0,1fr)]"
					>
						<span class="font-mono text-xs leading-7 text-brand-60 tabular-nums dark:text-brand-40">
							{String(index + 1).padStart(2, '0')}
						</span>
						<h3 class="text-base leading-7 font-semibold text-balance text-foreground">{bet.title}</h3>
						<p class="record-quiet max-w-xl text-sm leading-7 text-muted-foreground">{bet.body}</p>
					</Reveal>
				</li>
			))
		}
	</ol>
</Section>
