---
import {
	RiAlarmWarningLine,
	RiCodeSSlashLine,
	RiCustomerService2Line,
	RiSearchEyeLine,
	RiTestTubeLine
} from '@remixicon/react'
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/utils'
import Reveal from '../Reveal'
import Section from './Section.astro'
import SectionHeading from './SectionHeading.astro'

interface Props {
	lang: Locale
}

const { lang } = Astro.props

const cases = [
	{ icon: RiCodeSSlashLine, key: 'coding' },
	{ icon: RiCustomerService2Line, key: 'customerSuccess' },
	{ icon: RiSearchEyeLine, key: 'research' },
	{ icon: RiTestTubeLine, key: 'qa' },
	{ icon: RiAlarmWarningLine, key: 'operations' }
].map(({ icon, key }) => ({
	icon,
	title: t(lang, `usecases.${key}.title`),
	body: t(lang, `usecases.${key}.body`)
}))
---

<Section>
	<SectionHeading
		index="04"
		eyebrow={t(lang, 'section.usecases')}
		title={t(lang, 'usecases.title')}
		subtitle={t(lang, 'usecases.subtitle')}
		wide
	/>

	<div class="mt-14 grid gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
		{
			cases.map((item, index) => (
				<Reveal client:visible={{ rootMargin: '200px' }} delay={(index % 3) * 0.06} className="bg-background">
					<div class="group h-full p-8">
						<div class="flex items-center gap-3">
							<item.icon
								className="size-5 shrink-0 text-brand-60 transition-transform duration-200 ease-[var(--ease-productive)] group-hover:translate-x-0.5 dark:text-brand-40"
								aria-hidden="true"
							/>
							<h3 class="text-base font-semibold text-foreground">{item.title}</h3>
						</div>
						<p class="mt-4 text-sm leading-6 text-muted-foreground">{item.body}</p>
					</div>
				</Reveal>
			))
		}
		<Reveal client:visible={{ rootMargin: '200px' }} delay={0.12} className="bg-brand-60 dark:bg-brand-70">
			<figure class="relative m-0 flex h-full items-center overflow-hidden p-8">
				<div
					class="grid-field pointer-events-none absolute inset-0 opacity-25 [--grid-line:rgb(255_255_255/0.5)]"
					aria-hidden="true"
				>
				</div>
				<blockquote class="relative m-0 font-serif text-lg leading-8 text-white italic">
					{t(lang, 'usecases.quote')}
				</blockquote>
			</figure>
		</Reveal>
	</div>
</Section>
