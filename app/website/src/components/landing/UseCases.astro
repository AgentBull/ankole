---
import {
	RiAlarmWarningLine,
	RiCodeSSlashLine,
	RiCustomerService2Line,
	RiSearchEyeLine,
	RiTestTubeLine
} from '@remixicon/react'
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/utils'

interface Props {
	lang: Locale
}

const { lang } = Astro.props

const cases = [
	{ icon: RiCodeSSlashLine, key: 'coding' },
	{ icon: RiCustomerService2Line, key: 'customerSuccess' },
	{ icon: RiSearchEyeLine, key: 'research' },
	{ icon: RiTestTubeLine, key: 'qa' },
	{ icon: RiAlarmWarningLine, key: 'operations' }
].map(({ icon, key }) => ({
	icon,
	title: t(lang, `usecases.${key}.title`),
	body: t(lang, `usecases.${key}.body`)
}))
---

<section class="border-b border-border">
	<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
		<h2 class="max-w-3xl text-3xl font-semibold tracking-tight text-foreground">{t(lang, 'usecases.title')}</h2>
		<p class="mt-3 max-w-2xl text-muted-foreground">{t(lang, 'usecases.subtitle')}</p>
		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				cases.map(item => (
					<div class="border border-border p-6">
						<div class="flex items-center gap-3">
							<item.icon className="size-5 shrink-0 text-brand-60 dark:text-brand-40" aria-hidden="true" />
							<h3 class="text-base font-semibold text-foreground">{item.title}</h3>
						</div>
						<p class="mt-3 text-sm leading-6 text-muted-foreground">{item.body}</p>
					</div>
				))
			}
			<div class="flex items-center border border-brand-60/30 bg-brand-60/5 p-6 dark:border-brand-40/30 dark:bg-brand-40/10">
				<p class="text-base font-medium leading-7 text-foreground">{t(lang, 'usecases.quote')}</p>
			</div>
		</div>
	</div>
</section>
