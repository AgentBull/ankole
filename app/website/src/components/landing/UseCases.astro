---
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/utils'
import Reveal from '../Reveal.astro'
import Section from './Section.astro'
import SectionHeading from './SectionHeading.astro'

interface Props {
	lang: Locale
}

const { lang } = Astro.props

/*
 * Each function produces inspectable work and has an outcome measure.
 * The third column separates autonomous labor from an open-ended chat.
 */
const functions = ['marketing', 'research', 'seo', 'regulatory', 'patent', 'audit'].map(key => ({
	title: t(lang, `usecases.${key}.title`),
	deliverable: t(lang, `usecases.${key}.deliverable`),
	metric: t(lang, `usecases.${key}.metric`)
}))

const columns = {
	function: t(lang, 'usecases.col.function'),
	deliverable: t(lang, 'usecases.col.deliverable'),
	metric: t(lang, 'usecases.col.metric')
}

const ROW = 'gap-x-8 gap-y-1 sm:grid sm:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)_minmax(0,1fr)]'
---

<Section>
	<SectionHeading
		index="03"
		eyebrow={t(lang, 'section.usecases')}
		title={t(lang, 'usecases.title')}
		subtitle={t(lang, 'usecases.subtitle')}
		wide
	/>

	<div class="mt-14">
		<div
			class:list={[
				ROW,
				'hidden border-b border-border pb-3 font-mono text-[11px] tracking-[0.12em] text-fg-quaternary uppercase sm:grid'
			]}
		>
			<span>{columns.function}</span>
			<span>{columns.deliverable}</span>
			<span>{columns.metric}</span>
		</div>

		<ol class="list-none border-t border-border p-0 sm:border-t-0">
			{
				functions.map((businessFunction, index) => (
					<li class="record border-b border-border">
						<Reveal step={index} class={`${ROW} py-6`}>
							<h3 class="text-base font-semibold text-foreground">{businessFunction.title}</h3>
							<p class="record-quiet mt-1 text-sm leading-6 text-muted-foreground sm:mt-0">
								{businessFunction.deliverable}
							</p>
							{/* The outcome measure is the payload, so it is the only coloured item in the row. */}
							<p class="mt-1 text-sm leading-6 text-brand-60 sm:mt-0 dark:text-brand-40">
								{businessFunction.metric}
							</p>
						</Reveal>
					</li>
				))
			}
		</ol>

		<Reveal>
			{/*
			 * Optical margin alignment. 「 carries 11px of empty box before its ink at this
			 * size, so a quote whose box aligns with the rows above reads as indented. It
			 * hangs by that much and the first real character lands on the axis. The Latin
			 * “ costs a single pixel, so it is left alone rather than nudged for symmetry.
			 */}
			<blockquote
				class:list={[
					'm-0 mt-10 border-l-2 border-brand-60 pl-6 text-lg leading-8 text-foreground dark:border-brand-40',
					(lang === 'zh-Hans-CN' || lang === 'ja-JP') && '[text-indent:-0.61em]'
				]}
			>
				{t(lang, 'usecases.quote')}
			</blockquote>
		</Reveal>
	</div>
</Section>
