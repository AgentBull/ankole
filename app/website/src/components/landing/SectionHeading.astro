---
import Reveal from '../Reveal.astro'

interface Props {
	/** Two-digit section index, shown with the eyebrow label. */
	index: string
	eyebrow: string
	title: string
	subtitle?: string
	/** Give the title a wider measure when it is a full statement. */
	wide?: boolean
}

const { index, eyebrow, title, subtitle, wide = false } = Astro.props
---

<Reveal>
	{/*
	 * No decorative rule before the index. It pushed the eyebrow text off the axis that
	 * the title, the subtitle, and every row below stand on, and one shared left edge is
	 * worth more than the ornament.
	 */}
	<p class="flex items-baseline gap-3 font-mono text-xs tracking-[0.14em] uppercase">
		<span class="text-brand-60 tabular-nums dark:text-brand-40">{index}</span>
		<span class="text-muted-foreground">{eyebrow}</span>
	</p>
	<h2
		class:list={[
			'mt-6 text-balance text-3xl font-semibold tracking-tight text-foreground sm:text-4xl',
			wide ? 'max-w-4xl' : 'max-w-2xl'
		]}
	>
		{title}
	</h2>
	{/* Prose runs to about 36 CJK characters: long enough to read, short enough to return. */}
	{subtitle && <p class="mt-5 max-w-xl leading-8 text-muted-foreground">{subtitle}</p>}
</Reveal>
