---
import Capabilities from '../../components/landing/Capabilities.astro'
import Compounding from '../../components/landing/Compounding.astro'
import CtaSection from '../../components/landing/CtaSection.astro'
import Difference from '../../components/landing/Difference.astro'
import Hero from '../../components/landing/Hero.astro'
import QuickStart from '../../components/landing/QuickStart.astro'
import RuntimeBets from '../../components/landing/RuntimeBets.astro'
import UseCases from '../../components/landing/UseCases.astro'
import { getSiteDescription, getSiteTitle } from '../../consts'
import { isValidLocale, LOCALES, type Locale } from '../../i18n/config'
import BaseLayout from '../../layouts/BaseLayout.astro'

export function getStaticPaths() {
	return LOCALES.map(lang => ({ params: { lang } }))
}

const { lang } = Astro.params
if (!isValidLocale(lang)) return Astro.redirect('/')
const locale = lang as Locale
---

<BaseLayout lang={locale} title={getSiteTitle(locale)} description={getSiteDescription(locale)} path="">
	<Hero lang={locale} />
	<Capabilities lang={locale} />
	<QuickStart lang={locale} />
	<UseCases lang={locale} />
	<Difference lang={locale} />
	<Compounding lang={locale} />
	<RuntimeBets lang={locale} />
	<CtaSection lang={locale} />
</BaseLayout>
