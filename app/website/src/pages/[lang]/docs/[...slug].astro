---
import { getCollection, render } from 'astro:content'
import { isValidLocale, type Locale } from '../../../i18n/config'
import DocsLayout from '../../../layouts/DocsLayout.astro'
import { buildDocsNav, docsRouteParams, fallbackNotice, localizedEntry } from '../../../lib/docs-model'

export async function getStaticPaths() {
	return docsRouteParams(await getCollection('docs')).map(params => ({ params }))
}

const { lang, slug } = Astro.params
if (!isValidLocale(lang)) return Astro.redirect('/')
const locale = lang as Locale

const docs = await getCollection('docs')
const entry = localizedEntry(docs, slug, locale)
if (!entry) return Astro.redirect(`/${locale}/docs/`)

const { Content, headings } = await render(entry)
const { sections, flat } = buildDocsNav(docs, locale)
const index = flat.findIndex(item => item.slug === slug)
const prev = index > 0 ? flat[index - 1] : undefined
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : undefined
---

<DocsLayout
	lang={locale}
	title={entry.data.title}
	description={entry.data.description}
	path={`docs/${slug}`}
	headings={headings}
	sections={sections}
	currentSlug={slug}
	prev={prev}
	next={next}
	fallbackNotice={fallbackNotice(entry, locale)}
>
	<Content />
</DocsLayout>
