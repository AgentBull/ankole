---
import AgentDirective from '../components/AgentDirective.astro'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { BCP47, type Locale } from '../i18n/config'
import { t } from '../i18n/utils'

interface Props {
	lang: Locale
	title: string
	description: string
	/** Path after /{lang}/, used for canonical and hreflang links. */
	path?: string
	/**
	 * Site path of this page's Markdown version, when the page has one. Such a page places its own
	 * AgentDirective inside the article, where text extractors keep it.
	 */
	markdownPath?: string
}

const { lang, title, description, path = '', markdownPath } = Astro.props
---

<!doctype html>
<html lang={BCP47[lang]}>
	<head>
		<BaseHead title={title} description={description} lang={lang} path={path} markdownPath={markdownPath} />
		<noscript>
			<style>
				/* Entrances start hidden. Without scripts they never play, so show them. */
				[data-reveal] {
					opacity: 1 !important;
					transform: none !important;
					clip-path: none !important;
				}
			</style>
		</noscript>
	</head>
	<body class="bg-background font-sans text-foreground antialiased">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
		>
			{t(lang, 'a11y.skipToContent')}
		</a>
		{!markdownPath && <AgentDirective lang={lang} />}
		<Header lang={lang} />
		<div id="main-content">
			<slot />
		</div>
		<Footer lang={lang} />
	</body>
</html>
