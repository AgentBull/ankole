{
  "name": "@ankole/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun run scripts/check-motion-css.mjs && bun run scripts/check-internal-links.mjs",
    "preview": "astro preview",
    "type-check": "astro check",
    "lint": "bun --bun oxlint . --ignore-pattern '.astro/**' --ignore-pattern 'dist/**'",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "@ankole/uikit": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.4.12",
    "intl-messageformat": "^12.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.5",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "typescript": "6.0.3",
    "vite": "^8.3.8"
  }
}
