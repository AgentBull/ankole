  "description": "Tool to retrieve a list of jobs for a specified pipeline within a project. Use this when you need to inspect the status or details of jobs associated with a particular CI/CD pipeline.",
  "inputSchema": {
    "properties": {
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "The ID or URL-encoded path of the project.",
        "examples": [123, "yourgroup%2Fyourproject"],
        "title": "Id"
      },
      "include_retried": {
        "default": false,
        "description": "Include retried jobs in the response. Defaults to false.",
        "title": "Include Retried",
        "type": "boolean"
      },
      "page": {
        "description": "Page number for pagination (1-based).",
        "examples": [1],
        "minimum": 1,
        "title": "Page",
        "type": "integer"
      },
      "per_page": {
        "description": "Number of items per page for pagination (max 100).",
        "examples": [20],
        "maximum": 100,
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      },
      "pipeline_id": {
        "description": "The ID of the pipeline.",
        "examples": [456],
        "title": "Pipeline Id",
        "type": "integer"
      },
      "scope": {
        "anyOf": [
          {
            "enum": [
              "canceled",
              "canceling",
              "created",
              "failed",
              "manual",
              "pending",
              "preparing",
              "running",
              "scheduled",
              "skipped",
              "success",
              "waiting_for_resource"
            ],
            "type": "string"
          },
          {
            "items": {
              "enum": [
                "canceled",
                "canceling",
                "created",
                "failed",
                "manual",
                "pending",
                "preparing",
                "running",
                "scheduled",
                "skipped",
                "success",
                "waiting_for_resource"
              ],
              "type": "string"
            },
            "type": "array"
          }
        ],
        "description": "The scope of jobs to show. Can be a single status or a list of statuses. If not provided, all jobs are returned.",
        "examples": ["running", ["success", "failed"]],
        "title": "Scope"
      }
    },
    "required": ["id", "pipeline_id"],
