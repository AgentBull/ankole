{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "Retrieves a list of merge requests from across all accessible projects based on scope and filters. Use this action when you need to query merge requests at the instance or user level (not scoped to a specific project), such as finding all merge requests created by a user, assigned to a user, or awaiting review. By default returns merge requests created by the authenticated user; use scope=all to retrieve all accessible merge requests.",
  "inputSchema": {
    "properties": {
      "non_archived": {
        "description": "Return merge requests from non-archived projects only. Default is true.",
        "examples": [true],
        "title": "Non Archived",
        "type": "boolean"
      },
      "environment": {
        "description": "Returns merge requests deployed to the given environment.",
        "examples": ["production"],
        "title": "Environment",
        "type": "string"
      },
      "assignee_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "Returns merge requests assigned to the given user ID. Use string 'None' for unassigned merge requests or 'Any' for merge requests with an assignee.",
        "examples": [456, "None", "Any"],
        "title": "Assignee Id"
      },
      "not_filter": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        },
        "description": "Returns merge requests that do not match the parameters supplied. Accepts: labels, milestone, author_id, author_username, assignee_id, assignee_username, reviewer_id, reviewer_username, my_reaction_emoji.",
        "examples": [
          {
            "labels": "bug",
            "milestone": "v1.0"
          }
        ],
        "title": "Not Filter",
        "type": "object"
      },
      "author_username": {
        "description": "Returns merge requests created by the given username. Mutually exclusive with author_id.",
        "examples": ["john_doe"],
        "title": "Author Username",
        "type": "string"
      },
      "reviewer_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "Returns merge requests which have the user as a reviewer with the given user ID. Use string 'None' for merge requests with no reviewers or 'Any' for merge requests with any reviewer. Mutually exclusive with reviewer_username.",
        "examples": [789, "None", "Any"],
        "title": "Reviewer Id"
      },
      "with_merge_status_recheck": {
        "description": "If true, this projection requests (but does not guarantee) an asynchronous recalculation of the merge_status field.",
        "examples": [false],
        "title": "With Merge Status Recheck",
        "type": "boolean"
      },
      "merge_user_id": {
        "description": "Returns merge requests merged by the user with the given user ID. Mutually exclusive with merge_user_username. Introduced in GitLab 17.0.",
        "examples": [111],
        "title": "Merge User Id",
        "type": "integer"
      },
      "updated_after": {
        "description": "Returns merge requests updated on or after the given time. Expected in ISO 8601 format.",
        "examples": ["2019-03-15T08:00:00Z"],
        "format": "date-time",
        "title": "Updated After",
        "type": "string"
      },
      "draft": {
        "description": "Filter merge requests by draft status. True returns draft merge requests, False returns non-draft merge requests.",
        "examples": [false],
        "title": "Draft",
        "type": "boolean"
      },
      "reviewer_username": {
        "description": "Returns merge requests which have the user as a reviewer with the given username. Mutually exclusive with reviewer_id.",
        "examples": ["reviewer_user"],
        "title": "Reviewer Username",
        "type": "string"
      },
      "created_before": {
        "description": "Returns merge requests created on or before the given time. Expected in ISO 8601 format.",
        "examples": ["2019-03-16T08:00:00Z"],
        "format": "date-time",
        "title": "Created Before",
        "type": "string"
      },
      "approver_ids": {
        "description": "Returns merge requests which have all the users with the given IDs as individual approvers. Use None for merge requests without approvers or Any for merge requests with an approver. Premium and Ultimate only.",
        "examples": [[10, 20]],
        "items": {
          "type": "integer"
        },
        "title": "Approver Ids[]",
        "type": "array"
      },
      "view": {
        "const": "simple",
        "description": "If simple, returns the iid, URL, title, description, and basic state of merge request.",
        "examples": ["simple"],
        "title": "View",
        "type": "string"
      },
      "my_reaction_emoji": {
        "description": "Returns merge requests reacted by the authenticated user by the given emoji. Use None for merge requests not given a reaction or Any for merge requests given at least one reaction.",
        "examples": ["thumbsup"],
        "title": "My Reaction Emoji",
        "type": "string"
      },
      "order_by": {
        "description": "Returns requests ordered by the specified field. Default is created_at.",
        "enum": [
          "created_at",
          "updated_at",
          "merged_at",
          "label_priority",
          "priority",
          "milestone_due",
          "popularity",
          "title"
        ],
        "examples": ["updated_at"],
        "title": "Order By",
        "type": "string"
      },
      "deployed_before": {
        "description": "Returns merge requests deployed before the given date/time. Expected in ISO 8601 format.",
        "examples": ["2019-03-16T08:00:00Z"],
        "format": "date-time",
        "title": "Deployed Before",
        "type": "string"
      },
      "with_labels_details": {
        "description": "If true, response returns more details for each label in labels field: name, color, description, description_html, text_color. Default is false.",
        "examples": [true],
        "title": "With Labels Details",
        "type": "boolean"
      },
      "per_page": {
        "default": 25,
        "description": "The number of results per page. Defaults to 25.",
        "examples": [25],
        "title": "Per Page",
        "type": "integer"
      },
      "wip": {
        "description": "Filter merge requests by work-in-progress status. Deprecated, use draft parameter instead.",
        "enum": ["yes", "no"],
        "examples": ["no"],
        "title": "Wip",
        "type": "string"
      },
      "merge_user_username": {
        "description": "Returns merge requests merged by the user with the given username. Mutually exclusive with merge_user_id. Introduced in GitLab 17.0.",
        "examples": ["merger_user"],
        "title": "Merge User Username",
        "type": "string"
      },
      "scope": {
        "description": "Limit results by scope. Defaults to created_by_me. Use 'all' to see all merge requests across the instance (requires appropriate permissions).",
        "enum": ["created_by_me", "assigned_to_me", "reviews_for_me", "all"],
        "examples": ["all"],
        "title": "Scope",
        "type": "string"
      },
      "created_after": {
        "description": "Returns merge requests created on or after the given time. Expected in ISO 8601 format.",
        "examples": ["2019-03-15T08:00:00Z"],
        "format": "date-time",
        "title": "Created After",
        "type": "string"
      },
      "target_branch": {
        "description": "Returns merge requests with the given target branch.",
        "examples": ["main"],
        "title": "Target Branch",
        "type": "string"
      },
      "author_id": {
        "description": "Returns merge requests created by the given user ID. Mutually exclusive with author_username.",
        "examples": [123],
        "title": "Author Id",
        "type": "integer"
      },
      "assignee_username": {
        "description": "Returns merge requests assigned to the given username(s). Array parameter.",
        "examples": [["jane_doe"]],
        "items": {
          "type": "string"
        },
        "title": "Assignee Username[]",
        "type": "array"
      },
      "approved_by_ids": {
        "description": "Returns merge requests approved by all the users with the given IDs (up to 5 users). Use None for merge requests with no approvals or Any for merge requests with an approval. Premium and Ultimate only.",
        "examples": [[1, 2, 3]],
        "items": {
          "type": "integer"
        },
        "title": "Approved By Ids[]",
        "type": "array"
      },
      "milestone": {
        "description": "Returns merge requests for a specific milestone. Use None for merge requests with no milestone or Any for merge requests that have an assigned milestone.",
        "examples": ["v1.0"],
        "title": "Milestone",
        "type": "string"
      },
      "labels": {
        "description": "Returns merge requests matching a comma-separated list of labels. Use None to list all merge requests with no labels or Any to list all merge requests with at least one label. Predefined names are case-insensitive.",
        "examples": ["bug,critical"],
        "title": "Labels",
        "type": "string"
      },
      "deployed_after": {
        "description": "Returns merge requests deployed after the given date/time. Expected in ISO 8601 format.",
        "examples": ["2019-03-15T08:00:00Z"],
        "format": "date-time",
        "title": "Deployed After",
        "type": "string"
      },
      "state": {
        "description": "Filter merge requests by state. Defaults to all if not specified.",
        "enum": ["opened", "closed", "locked", "merged", "all"],
        "examples": ["opened"],
        "title": "State",
        "type": "string"
      },
      "sort": {
        "description": "Returns requests sorted in the specified order. Default is desc.",
        "enum": ["asc", "desc"],
        "examples": ["asc"],
        "title": "Sort",
        "type": "string"
      },
      "in": {
        "description": "Modify the scope of the search attribute. Options: title, description, or title,description (both). If not specified, searches both by default.",
        "enum": ["title", "description", "title,description"],
        "examples": ["title"],
        "title": "In",
        "type": "string"
      },
      "search": {
        "description": "Search merge requests against their title and description.",
        "examples": ["fix login bug"],
        "title": "Search",
        "type": "string"
      },
      "page": {
        "description": "The page of results to return. Defaults to 1.",
        "examples": [1],
        "title": "Page",
        "type": "integer"
      },
      "updated_before": {
        "description": "Returns merge requests updated on or before the given time. Expected in ISO 8601 format.",
        "examples": ["2019-03-16T08:00:00Z"],
        "format": "date-time",
        "title": "Updated Before",
        "type": "string"
      },
      "source_branch": {
        "description": "Returns merge requests with the given source branch.",
        "examples": ["feature-branch"],
        "title": "Source Branch",
        "type": "string"
      },
      "approved_by_usernames": {
        "description": "Returns merge requests approved by all the users with the given usernames (up to 5 users). Premium and Ultimate only.",
        "examples": [["user1", "user2"]],
        "items": {
          "type": "string"
        },
        "title": "Approved By Usernames[]",
        "type": "array"
      }
    },
    "title": "ListMergeRequestsRequest",
    "type": "object"
  },
