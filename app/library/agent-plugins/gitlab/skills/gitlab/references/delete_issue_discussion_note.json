{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Permanently delete an existing note from an issue discussion. See https://docs.gitlab.com/api/discussions/#delete-an-issue-thread-note.",
  "inputSchema": {
    "properties": {
      "discussion_id": {
        "description": "ID of the discussion containing the note.",
        "title": "Discussion Id",
        "type": "string"
      },
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*(/[A-Za-z0-9_][A-Za-z0-9_.\\-]*)*$",
            "type": "string"
          }
        ],
        "description": "Project ID or unencoded namespace/project path.",
        "title": "Id"
      },
      "issue_iid": {
        "description": "Project-local IID of the issue.",
        "title": "Issue Iid",
        "type": "integer"
      },
      "note_id": {
        "description": "ID of the discussion note to delete.",
        "title": "Note Id",
        "type": "integer"
      }
    },
    "required": ["id", "issue_iid", "discussion_id", "note_id"],
    "title": "DeleteIssueDiscussionNoteRequest",
    "type": "object"
  },
  "name": "delete_issue_discussion_note",
  "outputSchema": {
    "$defs": {
      "DeleteIssueDiscussionNoteResponse": {
        "additionalProperties": true,
        "properties": {
          "success": {
            "description": "Whether the issue discussion note was deleted.",
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": ["success"],
        "title": "DeleteIssueDiscussionNoteResponse",
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "$ref": "#/$defs/DeleteIssueDiscussionNoteResponse",
        "description": "Data from the action execution",
        "title": "Data"
      }
    },
    "required": ["result"],
    "type": "object"
  }
}
