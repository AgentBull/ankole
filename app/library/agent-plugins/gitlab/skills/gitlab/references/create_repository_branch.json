        "title": "Branch Name",
        "type": "string"
      },
      "project_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "The ID or URL-encoded path of the project.",
        "examples": ["5", "group_name/project_name"],
        "title": "Project Id"
      },
      "ref": {
        "description": "The branch name or commit SHA to create the new branch from.",
        "examples": ["main", "develop", "a1b2c3d4e5f6"],
        "title": "Ref",
        "type": "string"
      }
    },
    "required": ["project_id", "branch_name", "ref"],
