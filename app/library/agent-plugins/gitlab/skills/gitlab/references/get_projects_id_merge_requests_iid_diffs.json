{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "Lists diff version metadata for a GitLab merge request, including commit SHAs, state and creation time.",
  "inputSchema": {
    "properties": {
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "The ID or URL-encoded path of the project.",
        "examples": [123, "namespace/project-name"],
        "title": "Id"
      },
      "merge_request_iid": {
        "description": "The internal ID of the merge request.",
        "examples": [42],
        "title": "Merge Request Iid",
        "type": "integer"
      }
    },
    "required": ["id", "merge_request_iid"],
    "title": "GetProjectsIdMergeRequestsIidDiffsRequest",
    "type": "object"
  },
  "name": "get_projects_id_merge_requests_iid_diffs",
  "outputSchema": {
