{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "List one page of pipelines for a merge request. Follow next_page to retrieve additional results.",
  "inputSchema": {
    "properties": {
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*(/[A-Za-z0-9_][A-Za-z0-9_.\\-]*)*$",
            "type": "string"
          }
        ],
        "description": "Project ID or unencoded namespaced project path.",
        "title": "Id"
      },
      "merge_request_iid": {
        "description": "Project-local internal ID of the merge request.",
        "title": "Merge Request Iid",
        "type": "integer"
      },
      "page": {
        "description": "Page number, starting at 1.",
        "minimum": 1,
        "title": "Page",
        "type": "integer"
      },
      "per_page": {
        "description": "Results per page (maximum 100).",
        "maximum": 100,
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      }
    },
    "required": ["id", "merge_request_iid"],
    "title": "ListMergeRequestPipelinesRequest",
    "type": "object"
  },
  "name": "list_merge_request_pipelines",
  "outputSchema": {
    "$defs": {
      "ListMergeRequestPipelinesResponse": {
        "properties": {
          "next_page": {
            "description": "Next page number from GitLab, or null on the last page.",
            "title": "Next Page",
            "type": "integer"
          },
          "pipelines": {
            "description": "Pipelines for the merge request on this page.",
            "items": {
              "$ref": "#/$defs/MergeRequestPipeline"
            },
            "title": "Pipelines",
            "type": "array"
          }
        },
        "required": ["pipelines"],
        "title": "ListMergeRequestPipelinesResponse",
        "type": "object"
      },
      "MergeRequestPipeline": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "description": "Pipeline ID.",
            "title": "Id",
            "type": "integer"
          },
          "ref": {
            "description": "Branch or tag ref of the pipeline.",
            "title": "Ref",
            "type": "string"
          },
          "sha": {
            "description": "Commit SHA of the pipeline.",
            "title": "Sha",
            "type": "string"
          },
          "status": {
            "description": "Pipeline status.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["id"],
        "title": "MergeRequestPipeline",
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "$ref": "#/$defs/ListMergeRequestPipelinesResponse",
        "description": "Data from the action execution",
        "title": "Data"
      }
    },
    "required": ["result"],
    "type": "object"
  }
}
