        "title": "Include Diverged Commits Count",
        "type": "boolean"
      },
      "include_rebase_in_progress": {
        "description": "If true, response includes whether a rebase operation is in progress.",
        "examples": [false],
        "title": "Include Rebase In Progress",
        "type": "boolean"
      },
      "merge_request_iid": {
        "description": "Internal ID of the merge request.",
        "examples": [42],
        "title": "Merge Request Iid",
        "type": "integer"
      },
      "render_html": {
        "description": "If true, response includes rendered HTML for title and description.",
        "examples": [true],
        "title": "Render Html",
        "type": "boolean"
      }
    },
    "required": ["id", "merge_request_iid"],
    "title": "GetProjectMergeRequestRequest",
    "type": "object"
  },
