{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Updates an existing merge request in a GitLab project (title, description, assignees, reviewers, labels, state, etc.). Use this action when you need to modify merge request details, manage assignees/reviewers, update labels, close/reopen merge requests, or configure merge settings like squash or auto-removal of source branch. This action is idempotent and can be called multiple times with the same parameters.",
  "inputSchema": {
    "properties": {
      "add_labels": {
        "description": "Comma-separated label names to add without affecting existing labels.",
        "examples": ["documentation"],
        "title": "Add Labels",
        "type": "string"
      },
      "allow_collaboration": {
        "description": "Allow commits from members who can merge to the target branch.",
        "examples": [true],
        "title": "Allow Collaboration",
        "type": "boolean"
      },
      "allow_maintainer_to_push": {
        "description": "Allow maintainers of the target project to push to the merge request branch (deprecated, use allow_collaboration).",
        "examples": [true],
        "title": "Allow Maintainer To Push",
        "type": "boolean"
      },
      "assignee_id": {
        "description": "Assignee user ID. Set to 0 to unassign.",
        "examples": [123],
        "title": "Assignee Id",
        "type": "integer"
      },
      "assignee_ids": {
        "description": "Array of user IDs to assign. Set to empty array to unassign all assignees.",
        "examples": [[123, 456]],
        "items": {
          "type": "integer"
        },
        "title": "Assignee Ids",
        "type": "array"
      },
      "description": {
        "description": "Description of the merge request.",
        "examples": ["This MR updates the authentication flow to support OAuth2."],
        "title": "Description",
        "type": "string"
      },
      "discussion_locked": {
        "description": "Flag indicating if the discussion is locked. Only project members can comment when locked.",
        "examples": [false],
        "title": "Discussion Locked",
        "type": "boolean"
      },
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "The ID or URL-encoded path of the project.",
        "examples": ["123", "group_name/project_name"],
        "title": "Id"
      },
      "labels": {
        "description": "Comma-separated label names to replace the entire label set. Set to empty string to remove all labels.",
        "examples": ["bug,critical"],
        "title": "Labels",
        "type": "string"
      },
      "merge_request_iid": {
        "description": "Internal ID of the merge request to update.",
        "examples": [42],
        "title": "Merge Request Iid",
        "type": "integer"
      },
      "milestone_id": {
        "description": "ID of milestone to assign. Set to 0 to unassign milestone.",
        "examples": [5],
        "title": "Milestone Id",
        "type": "integer"
      },
      "remove_labels": {
        "description": "Comma-separated label names to remove from the merge request.",
        "examples": ["wontfix"],
        "title": "Remove Labels",
        "type": "string"
      },
      "remove_source_branch": {
        "description": "Flag indicating if the source branch should be removed after merge.",
        "examples": [true],
        "title": "Remove Source Branch",
        "type": "boolean"
      },
      "reviewer_ids": {
        "description": "Array of user IDs to set as reviewers. Set to empty array to unassign all reviewers.",
        "examples": [[789, 101]],
        "items": {
          "type": "integer"
        },
        "title": "Reviewer Ids",
        "type": "array"
      },
      "squash": {
        "description": "Squash commits into a single commit when merging.",
        "examples": [true],
        "title": "Squash",
        "type": "boolean"
      },
      "state_event": {
        "description": "State event to perform. Use 'close' to close the merge request or 'reopen' to reopen it.",
        "enum": ["close", "reopen"],
        "title": "State Event",
        "type": "string"
      },
      "target_branch": {
        "description": "Target branch for the merge request.",
        "examples": ["main", "master"],
        "title": "Target Branch",
        "type": "string"
      },
      "title": {
        "description": "Title of the merge request.",
        "examples": ["Update authentication flow"],
        "title": "Title",
        "type": "string"
      }
    },
    "required": ["id", "merge_request_iid"],
    "title": "UpdateMergeRequestRequest",
    "type": "object"
  },
