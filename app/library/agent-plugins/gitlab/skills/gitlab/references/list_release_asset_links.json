{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "List asset links from a project release identified by its tag. Returns link IDs, names, URLs, and link types, not downloaded asset content.",
  "inputSchema": {
    "properties": {
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*(/[A-Za-z0-9_][A-Za-z0-9_.\\-]*)*$",
            "type": "string"
          }
        ],
        "description": "Project ID or unencoded namespace/project path.",
        "title": "Id"
      },
      "tag_name": {
        "description": "Tag associated with the release, unencoded.",
        "title": "Tag Name",
        "type": "string"
      }
    },
    "required": ["id", "tag_name"],
    "title": "ListReleaseAssetLinksRequest",
    "type": "object"
  },
  "name": "list_release_asset_links",
  "outputSchema": {
    "$defs": {
      "ListReleaseAssetLinksResponse": {
        "properties": {
          "links": {
            "description": "Asset links from the release.",
            "items": {
              "$ref": "#/$defs/ReleaseAssetLink"
            },
            "title": "Links",
            "type": "array"
          }
        },
        "required": ["links"],
        "title": "ListReleaseAssetLinksResponse",
        "type": "object"
      },
      "ReleaseAssetLink": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "description": "Asset link ID.",
            "title": "Id",
            "type": "integer"
          },
          "link_type": {
            "description": "Asset link type.",
            "title": "Link Type",
            "type": "string"
          },
          "name": {
            "description": "Asset link name.",
            "title": "Name",
            "type": "string"
          },
          "url": {
            "description": "Asset URL.",
            "title": "Url",
            "type": "string"
          }
        },
        "title": "ReleaseAssetLink",
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "$ref": "#/$defs/ListReleaseAssetLinksResponse",
        "description": "Data from the action execution",
        "title": "Data"
      }
    },
    "required": ["result"],
    "type": "object"
  }
}
