{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "List one page of merge requests blocked by the specified merge request. Returns dependency relationships with blocking and blocked merge request details. Follow next_page to retrieve additional results.",
  "inputSchema": {
    "properties": {
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*(/[A-Za-z0-9_][A-Za-z0-9_.\\-]*)*$",
            "type": "string"
          }
        ],
        "description": "Project ID or unencoded namespaced project path.",
        "title": "Id"
      },
      "merge_request_iid": {
        "description": "Project-local internal ID of the blocking merge request.",
        "title": "Merge Request Iid",
        "type": "integer"
      },
      "page": {
        "description": "Page number, starting at 1.",
        "minimum": 1,
        "title": "Page",
        "type": "integer"
      },
      "per_page": {
        "description": "Results per page (maximum 100).",
        "maximum": 100,
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      }
    },
    "required": ["id", "merge_request_iid"],
    "title": "ListBlockedMergeRequestsRequest",
    "type": "object"
  },
  "name": "list_blocked_merge_requests",
