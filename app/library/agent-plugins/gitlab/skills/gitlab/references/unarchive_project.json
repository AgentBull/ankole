            "description": "HTTP clone URL.",
            "title": "Http Url To Repo",
            "type": "string"
          },
          "id": {
            "description": "Unarchived project ID.",
            "title": "Id",
            "type": "integer"
          },
          "import_error": {
            "description": "Import error, if any.",
            "title": "Import Error",
            "type": "string"
          },
          "last_activity_at": {
            "description": "Last activity timestamp.",
            "title": "Last Activity At",
            "type": "string"
          },
          "merge_commit_template": {
