{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Unarchive a GitLab project to restore active use. Requires administrator access or the Owner role on the project. Idempotent: unarchiving an already unarchived project does not change it.",
  "inputSchema": {
    "properties": {
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*(/[A-Za-z0-9_][A-Za-z0-9_.\\-]*)*$",
            "type": "string"
          }
        ],
        "description": "Project ID or unencoded namespace/project path to unarchive.",
        "title": "Id"
      }
    },
    "required": ["id"],
    "title": "UnarchiveProjectRequest",
    "type": "object"
  },
  "name": "unarchive_project",
  "outputSchema": {
    "$defs": {
      "ProjectNamespace": {
        "additionalProperties": true,
        "properties": {
          "avatar_url": {
            "description": "Namespace avatar URL.",
            "title": "Avatar Url",
            "type": "string"
          },
          "full_path": {
            "description": "Full namespace path.",
            "title": "Full Path",
            "type": "string"
          },
          "id": {
            "description": "Namespace ID.",
            "title": "Id",
            "type": "integer"
          },
          "kind": {
            "description": "Namespace kind, group or user.",
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "description": "Namespace name.",
            "title": "Name",
            "type": "string"
          },
          "parent_id": {
            "description": "Parent namespace ID.",
            "title": "Parent Id",
            "type": "integer"
          },
          "path": {
            "description": "Namespace path.",
            "title": "Path",
            "type": "string"
          },
          "web_url": {
            "description": "Namespace web URL.",
            "title": "Web Url",
            "type": "string"
          }
        },
        "title": "ProjectNamespace",
        "type": "object"
      },
      "UnarchiveProjectResponse": {
        "additionalProperties": true,
        "properties": {
          "archived": {
            "description": "Whether the project is archived.",
            "title": "Archived",
            "type": "boolean"
          },
          "avatar_url": {
            "description": "Project avatar URL.",
            "title": "Avatar Url",
            "type": "string"
          },
          "created_at": {
            "description": "Creation timestamp.",
            "title": "Created At",
