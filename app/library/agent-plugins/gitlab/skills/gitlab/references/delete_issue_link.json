            "title": "Web Url",
            "type": "string"
          }
        },
        "required": ["id"],
        "title": "IssueUser",
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "$ref": "#/$defs/DeleteIssueLinkResponse",
        "description": "Data from the action execution",
        "title": "Data"
      }
