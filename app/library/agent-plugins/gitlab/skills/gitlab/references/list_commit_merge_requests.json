{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "List one page of merge requests associated with a commit. Returns the merge request that originally introduced the commit. Optionally filter by state and follow next_page for more results.",
  "inputSchema": {
    "properties": {
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*(/[A-Za-z0-9_][A-Za-z0-9_.\\-]*)*$",
            "type": "string"
          }
        ],
        "description": "Project ID or unencoded namespace/project path.",
        "title": "Id"
      },
      "page": {
        "description": "Page number, starting at 1.",
        "minimum": 1,
        "title": "Page",
        "type": "integer"
      },
      "per_page": {
        "description": "Results per page (maximum 100).",
        "maximum": 100,
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      },
      "sha": {
        "description": "Commit SHA.",
        "title": "Sha",
        "type": "string"
      },
      "state": {
        "description": "Filter by merge request state; omit to include all states.",
        "enum": ["opened", "closed", "locked", "merged"],
        "title": "State",
        "type": "string"
      }
    },
    "required": ["id", "sha"],
    "title": "ListCommitMergeRequestsRequest",
    "type": "object"
  },
  "name": "list_commit_merge_requests",
  "outputSchema": {
    "$defs": {
      "CommitMergeRequest": {
        "additionalProperties": true,
        "properties": {
          "assignee": {
            "$ref": "#/$defs/CommitMergeRequestUser",
            "description": "Assigned user.",
            "title": "Assignee"
          },
          "author": {
            "$ref": "#/$defs/CommitMergeRequestUser",
            "description": "Author.",
            "title": "Author"
          },
          "created_at": {
            "description": "Creation timestamp.",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "description": "Merge request description.",
            "title": "Description",
            "type": "string"
          },
          "discussion_locked": {
            "description": "Discussion lock flag.",
            "title": "Discussion Locked",
            "type": "boolean"
          },
          "downvotes": {
            "description": "Downvote count.",
            "title": "Downvotes",
            "type": "integer"
          },
          "draft": {
            "description": "Whether the merge request is a draft.",
            "title": "Draft",
            "type": "boolean"
          },
          "force_remove_source_branch": {
            "description": "Whether source branch removal is forced.",
            "title": "Force Remove Source Branch",
            "type": "boolean"
          },
          "id": {
            "description": "Global merge request ID.",
            "title": "Id",
            "type": "integer"
          },
          "iid": {
            "description": "Project-local merge request ID.",
            "title": "Iid",
            "type": "integer"
          },
          "labels": {
            "description": "Label names.",
            "items": {
              "type": "string"
            },
            "title": "Labels",
            "type": "array"
          },
          "merge_commit_sha": {
            "description": "Merge commit SHA, or null.",
            "title": "Merge Commit Sha",
            "type": "string"
          },
          "merge_status": {
            "description": "Merge status.",
            "title": "Merge Status",
            "type": "string"
          },
          "merge_when_pipeline_succeeds": {
            "description": "Whether to merge when the pipeline succeeds.",
            "title": "Merge When Pipeline Succeeds",
            "type": "boolean"
          },
          "milestone": {
            "$ref": "#/$defs/CommitMergeRequestMilestone",
            "description": "Milestone.",
            "title": "Milestone"
          },
          "project_id": {
            "description": "Project containing the merge request.",
            "title": "Project Id",
            "type": "integer"
          },
          "sha": {
            "description": "Merge request head SHA.",
            "title": "Sha",
            "type": "string"
          },
          "should_remove_source_branch": {
            "description": "Whether to remove the source branch after merging.",
            "title": "Should Remove Source Branch",
            "type": "boolean"
          },
          "source_branch": {
            "description": "Source branch name.",
            "title": "Source Branch",
            "type": "string"
          },
          "source_project_id": {
            "description": "Source project ID.",
            "title": "Source Project Id",
            "type": "integer"
          },
          "squash_commit_sha": {
            "description": "Squash commit SHA, or null.",
            "title": "Squash Commit Sha",
            "type": "string"
          },
          "state": {
            "description": "Merge request state.",
            "title": "State",
            "type": "string"
          },
          "target_branch": {
            "description": "Target branch name.",
            "title": "Target Branch",
            "type": "string"
          },
          "target_project_id": {
            "description": "Target project ID.",
            "title": "Target Project Id",
            "type": "integer"
          },
          "time_stats": {
            "$ref": "#/$defs/CommitMergeRequestTimeStats",
            "description": "Time tracking statistics.",
            "title": "Time Stats"
          },
          "title": {
            "description": "Merge request title.",
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "description": "Last update timestamp.",
            "title": "Updated At",
            "type": "string"
          },
          "upvotes": {
            "description": "Upvote count.",
            "title": "Upvotes",
            "type": "integer"
          },
          "user_notes_count": {
            "description": "User note count.",
            "title": "User Notes Count",
            "type": "integer"
          },
          "web_url": {
            "description": "Merge request web URL.",
            "title": "Web Url",
            "type": "string"
          },
          "work_in_progress": {
            "description": "Work-in-progress flag.",
            "title": "Work In Progress",
            "type": "boolean"
          }
        },
        "required": ["id", "iid", "project_id", "title", "state"],
        "title": "CommitMergeRequest",
        "type": "object"
      },
      "CommitMergeRequestMilestone": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "description": "Milestone ID.",
            "title": "Id",
            "type": "integer"
          },
          "iid": {
            "description": "Project-local milestone ID.",
            "title": "Iid",
            "type": "integer"
          },
          "title": {
            "description": "Milestone title.",
            "title": "Title",
            "type": "string"
          }
        },
        "required": ["id"],
        "title": "CommitMergeRequestMilestone",
        "type": "object"
      },
      "CommitMergeRequestTimeStats": {
        "additionalProperties": true,
        "properties": {
          "human_time_estimate": {
            "description": "Readable time estimate.",
            "title": "Human Time Estimate",
            "type": "string"
          },
          "human_total_time_spent": {
            "description": "Readable time spent.",
            "title": "Human Total Time Spent",
            "type": "string"
          },
          "time_estimate": {
            "description": "Estimated time in seconds.",
            "title": "Time Estimate",
            "type": "integer"
          },
          "total_time_spent": {
            "description": "Time spent in seconds.",
            "title": "Total Time Spent",
            "type": "integer"
          }
        },
        "title": "CommitMergeRequestTimeStats",
        "type": "object"
      },
      "CommitMergeRequestUser": {
        "additionalProperties": true,
        "properties": {
          "avatar_url": {
            "description": "User avatar URL.",
            "title": "Avatar Url",
            "type": "string"
          },
          "id": {
            "description": "User ID.",
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "description": "User display name.",
            "title": "Name",
            "type": "string"
          },
          "state": {
            "description": "User account state.",
            "title": "State",
            "type": "string"
          },
          "username": {
            "description": "Username.",
            "title": "Username",
            "type": "string"
          },
          "web_url": {
            "description": "User profile URL.",
            "title": "Web Url",
            "type": "string"
          }
        },
        "required": ["id"],
        "title": "CommitMergeRequestUser",
        "type": "object"
      },
      "ListCommitMergeRequestsResponse": {
        "properties": {
          "merge_requests": {
            "description": "One page of merge requests associated with the commit.",
            "items": {
              "$ref": "#/$defs/CommitMergeRequest"
            },
            "title": "Merge Requests",
            "type": "array"
          },
          "next_page": {
            "description": "Next page number from GitLab, or null on the last page.",
            "title": "Next Page",
            "type": "integer"
          }
        },
        "required": ["merge_requests"],
        "title": "ListCommitMergeRequestsResponse",
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "$ref": "#/$defs/ListCommitMergeRequestsResponse",
        "description": "Data from the action execution",
        "title": "Data"
      }
    },
    "required": ["result"],
    "type": "object"
  }
}
