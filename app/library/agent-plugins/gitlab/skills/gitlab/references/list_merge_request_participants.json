{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "List one page of participants for a merge request. Follow next_page to retrieve additional results.",
  "inputSchema": {
    "properties": {
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*(/[A-Za-z0-9_][A-Za-z0-9_.\\-]*)*$",
            "type": "string"
          }
        ],
        "description": "Project ID or unencoded namespaced project path.",
        "title": "Id"
      },
      "merge_request_iid": {
        "description": "Project-local internal ID of the merge request.",
        "title": "Merge Request Iid",
        "type": "integer"
      },
      "page": {
        "description": "Page number, starting at 1.",
        "minimum": 1,
        "title": "Page",
        "type": "integer"
      },
      "per_page": {
        "description": "Results per page (maximum 100).",
        "maximum": 100,
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      }
    },
    "required": ["id", "merge_request_iid"],
    "title": "ListMergeRequestParticipantsRequest",
    "type": "object"
  },
  "name": "list_merge_request_participants",
  "outputSchema": {
    "$defs": {
      "ListMergeRequestParticipantsResponse": {
        "properties": {
          "next_page": {
            "description": "Next page number from GitLab, or null on the last page.",
            "title": "Next Page",
            "type": "integer"
          },
          "participants": {
            "description": "Users participating in the merge request on this page.",
            "items": {
              "$ref": "#/$defs/MergeRequestParticipant"
            },
            "title": "Participants",
            "type": "array"
          }
        },
        "required": ["participants"],
        "title": "ListMergeRequestParticipantsResponse",
        "type": "object"
      },
      "MergeRequestParticipant": {
        "additionalProperties": true,
        "properties": {
          "avatar_url": {
            "description": "User avatar URL, if available.",
            "title": "Avatar Url",
            "type": "string"
          },
          "id": {
            "description": "User ID.",
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "description": "User's display name.",
            "title": "Name",
            "type": "string"
          },
          "state": {
            "description": "User account state.",
            "title": "State",
            "type": "string"
          },
          "username": {
            "description": "User's username.",
            "title": "Username",
            "type": "string"
          },
          "web_url": {
            "description": "User profile URL.",
            "title": "Web Url",
            "type": "string"
          }
        },
        "required": ["id", "name", "username"],
        "title": "MergeRequestParticipant",
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "$ref": "#/$defs/ListMergeRequestParticipantsResponse",
        "description": "Data from the action execution",
        "title": "Data"
      }
    },
    "required": ["result"],
    "type": "object"
  }
}
