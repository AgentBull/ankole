{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Creates a new merge request in a GitLab project to propose changes from a source branch into a target branch. Use this action when you need to create a merge request for code review, feature integration, or bug fixes. This action requires both the source and target branches to exist in the project.",
  "inputSchema": {
    "properties": {
      "allow_collaboration": {
        "description": "Allow commits from members who can merge to the target branch.",
        "examples": [true],
        "title": "Allow Collaboration",
        "type": "boolean"
      },
      "allow_maintainer_to_push": {
        "description": "Deprecated. Use allow_collaboration instead. Allows commits from maintainers who can merge to the target branch.",
        "examples": [true],
        "title": "Allow Maintainer To Push",
        "type": "boolean"
      },
      "assignee_id": {
        "description": "The ID of the user to assign the merge request to. Use assignee_ids for multiple assignees.",
        "examples": [42],
        "title": "Assignee Id",
        "type": "integer"
      },
      "assignee_ids": {
        "description": "The IDs of users to assign the merge request to. Premium and Ultimate only.",
        "examples": [[42, 123]],
        "items": {
          "type": "integer"
        },
        "title": "Assignee Ids",
        "type": "array"
      },
      "description": {
        "description": "The description of the merge request. Supports Markdown formatting.",
        "examples": ["This MR adds a new authentication feature that..."],
        "title": "Description",
        "type": "string"
      },
      "id": {
        "description": "The ID or URL-encoded path of the project.",
        "examples": ["12345", "my-group/my-project"],
        "title": "Id",
        "type": "string"
      },
      "labels": {
        "description": "Comma-separated label names to assign to the merge request.",
        "examples": ["bug,critical", "feature,enhancement"],
        "title": "Labels",
        "type": "string"
      },
      "milestone_id": {
        "description": "The global ID of a milestone to associate with the merge request.",
        "examples": [5],
        "title": "Milestone Id",
        "type": "integer"
      },
      "remove_source_branch": {
        "description": "Automatically remove the source branch when the merge request is merged.",
        "examples": [true],
        "title": "Remove Source Branch",
        "type": "boolean"
      },
      "reviewer_ids": {
        "description": "The IDs of users to set as reviewers of the merge request. Premium and Ultimate only.",
        "examples": [[42, 123]],
        "items": {
          "type": "integer"
        },
        "title": "Reviewer Ids",
        "type": "array"
      },
      "source_branch": {
        "description": "The source branch containing the changes to be merged.",
        "examples": ["feature-branch", "bugfix/issue-123"],
        "title": "Source Branch",
        "type": "string"
      },
      "squash": {
        "description": "Squash commits into a single commit when merging.",
        "examples": [true],
        "title": "Squash",
        "type": "boolean"
      },
      "target_branch": {
        "description": "The target branch into which the changes will be merged.",
        "examples": ["main", "develop"],
        "title": "Target Branch",
        "type": "string"
      },
      "target_project_id": {
        "description": "The target project ID. Useful when creating merge requests across forks.",
        "examples": [456],
        "title": "Target Project Id",
        "type": "integer"
      },
      "title": {
        "description": "The title of the merge request.",
        "examples": ["Add new feature", "Fix authentication bug"],
        "title": "Title",
        "type": "string"
      }
    },
    "required": ["id", "source_branch", "target_branch", "title"],
    "title": "CreateMergeRequestRequest",
    "type": "object"
  },
