{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Cherry-pick a commit onto a project branch, creating a new commit. Set dry_run to true to check whether it applies cleanly without committing. Conflicts and empty changesets fail rather than creating a commit.",
  "inputSchema": {
    "properties": {
      "branch": {
        "description": "Name of the target branch.",
        "title": "Branch",
        "type": "string"
      },
      "dry_run": {
        "description": "If true, test applying the cherry-pick without committing changes. Defaults to false on GitLab.",
        "title": "Dry Run",
        "type": "boolean"
      },
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*(/[A-Za-z0-9_][A-Za-z0-9_.\\-]*)*$",
            "type": "string"
          }
        ],
        "description": "Project ID or unencoded namespace/project path.",
        "title": "Id"
      },
      "message": {
        "description": "Custom commit message for the new commit.",
        "title": "Message",
        "type": "string"
      },
      "sha": {
        "description": "Hash of the commit to cherry-pick.",
        "title": "Sha",
        "type": "string"
      }
    },
    "required": ["id", "sha", "branch"],
    "title": "CherryPickCommitRequest",
    "type": "object"
  },
  "name": "cherry_pick_commit",
  "outputSchema": {
    "$defs": {
      "CherryPickCommitResponse": {
        "additionalProperties": true,
        "properties": {
          "author_email": {
            "description": "Original commit author's email.",
            "title": "Author Email",
            "type": "string"
          },
          "author_name": {
            "description": "Original commit author's name.",
            "title": "Author Name",
            "type": "string"
          },
          "authored_date": {
            "description": "Date when the original commit was authored.",
            "title": "Authored Date",
            "type": "string"
          },
          "committed_date": {
            "description": "Date when the cherry-picked commit was committed.",
            "title": "Committed Date",
            "type": "string"
          },
          "committer_email": {
            "description": "Cherry-pick committer's email.",
            "title": "Committer Email",
            "type": "string"
          },
          "committer_name": {
            "description": "Cherry-pick committer's name.",
            "title": "Committer Name",
            "type": "string"
          },
          "created_at": {
            "description": "Date when the cherry-picked commit was created.",
            "title": "Created At",
            "type": "string"
          },
          "dry_run": {
            "const": "success",
            "description": "Successful dry-run result, returned instead of a commit.",
            "title": "Dry Run",
            "type": "string"
          },
          "id": {
            "description": "SHA of the cherry-picked commit.",
            "title": "Id",
            "type": "string"
          },
          "message": {
            "description": "Full commit message.",
            "title": "Message",
            "type": "string"
          },
          "parent_ids": {
            "description": "Parent commit SHAs.",
            "items": {
              "type": "string"
            },
            "title": "Parent Ids",
            "type": "array"
          },
          "short_id": {
            "description": "Short SHA of the new commit.",
            "title": "Short Id",
            "type": "string"
          },
          "title": {
            "description": "Title of the commit message.",
            "title": "Title",
            "type": "string"
          },
          "web_url": {
            "description": "Web URL of the new commit.",
            "title": "Web Url",
            "type": "string"
          }
        },
        "title": "CherryPickCommitResponse",
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "$ref": "#/$defs/CherryPickCommitResponse",
        "description": "Data from the action execution",
        "title": "Data"
      }
    },
    "required": ["result"],
    "type": "object"
  }
}
