{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "List one page of releases for projects in a group. Use simple for limited release fields and sort for ascending or descending order. Follow next_page for additional pages. The group endpoint has no order_by parameter. Current GitLab documentation lists Free, Premium, and Ultimate availability, with no Premium-only limitation stated.",
  "inputSchema": {
    "properties": {
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*(/[A-Za-z0-9_][A-Za-z0-9_.\\-]*)*$",
            "type": "string"
          }
        ],
        "description": "Group ID or unencoded namespace/group path.",
        "title": "Id"
      },
      "page": {
        "description": "Page number, starting at 1.",
        "minimum": 1,
        "title": "Page",
        "type": "integer"
      },
      "per_page": {
        "description": "Results per page (maximum 100).",
        "maximum": 100,
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      },
      "simple": {
        "description": "Return only limited fields for each release; defaults to false.",
        "title": "Simple",
        "type": "boolean"
      },
      "sort": {
        "description": "Sort direction; defaults to descending (desc).",
        "enum": ["asc", "desc"],
        "title": "Sort",
        "type": "string"
      }
    },
    "required": ["id"],
    "title": "ListGroupReleasesRequest",
    "type": "object"
  },
  "name": "list_group_releases",
  "outputSchema": {
