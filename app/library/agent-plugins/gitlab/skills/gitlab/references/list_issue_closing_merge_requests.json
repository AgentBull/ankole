            "type": "string"
          }
        ],
        "description": "Project ID or unencoded namespace/project path.",
        "title": "Id"
      },
      "issue_iid": {
        "description": "Internal ID of the issue within the project.",
        "title": "Issue Iid",
        "type": "integer"
      },
      "page": {
        "description": "Page number, starting at 1.",
        "minimum": 1,
        "title": "Page",
        "type": "integer"
      },
      "per_page": {
        "description": "Results per page (maximum 100).",
        "maximum": 100,
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      }
    },
    "required": ["id", "issue_iid"],
