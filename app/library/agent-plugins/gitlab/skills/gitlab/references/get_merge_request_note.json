{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "Retrieve one existing merge request note by its ID without modifying it. See https://docs.gitlab.com/api/notes/#retrieve-a-merge-request-note.",
  "inputSchema": {
    "properties": {
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*(/[A-Za-z0-9_][A-Za-z0-9_.\\-]*)*$",
            "type": "string"
          }
        ],
        "description": "Project ID or unencoded namespace/project path.",
        "title": "Id"
      },
      "merge_request_iid": {
        "description": "Project-local merge request IID.",
        "title": "Merge Request Iid",
        "type": "integer"
      },
      "note_id": {
        "description": "ID of the merge request note to retrieve.",
        "title": "Note Id",
        "type": "integer"
      }
    },
    "required": ["id", "merge_request_iid", "note_id"],
    "title": "GetMergeRequestNoteRequest",
    "type": "object"
  },
  "name": "get_merge_request_note",
  "outputSchema": {
    "$defs": {
      "GetMergeRequestNoteResponse": {
        "additionalProperties": true,
        "properties": {
          "attachment": {
            "description": "Attachment URL, if any.",
            "title": "Attachment",
            "type": "string"
          },
          "author": {
            "$ref": "#/$defs/MergeRequestNoteAuthor",
            "description": "Author of the note.",
            "title": "Author"
          },
          "body": {
            "description": "Note content.",
            "title": "Body",
            "type": "string"
          },
          "confidential": {
            "description": "Deprecated confidentiality flag; use internal instead.",
            "title": "Confidential",
            "type": "boolean"
          },
          "created_at": {
            "description": "Note creation timestamp.",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "description": "Note ID.",
            "title": "Id",
            "type": "integer"
          },
          "internal": {
            "description": "Whether the note is internal.",
            "title": "Internal",
            "type": "boolean"
          },
          "noteable_id": {
            "description": "Global numeric merge request ID as a precision-preserving decimal string.",
            "title": "Noteable Id",
            "type": "string"
          },
          "noteable_iid": {
            "description": "Project-local merge request IID.",
            "title": "Noteable Iid",
            "type": "integer"
          },
          "noteable_type": {
            "description": "Type of the note's parent resource.",
            "title": "Noteable Type",
            "type": "string"
          },
          "project_id": {
            "description": "ID of the project containing the note.",
            "title": "Project Id",
            "type": "integer"
          },
          "resolvable": {
            "description": "Whether the note is resolvable.",
            "title": "Resolvable",
            "type": "boolean"
          },
          "system": {
            "description": "Whether GitLab generated this system note.",
            "title": "System",
            "type": "boolean"
          },
          "updated_at": {
            "description": "Note last update timestamp.",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "body",
          "author",
          "created_at",
          "updated_at",
          "system",
          "noteable_id",
          "noteable_type",
          "project_id"
        ],
        "title": "GetMergeRequestNoteResponse",
        "type": "object"
      },
      "MergeRequestNoteAuthor": {
        "additionalProperties": true,
        "properties": {
          "avatar_url": {
            "description": "Author's avatar URL.",
            "title": "Avatar Url",
            "type": "string"
          },
          "created_at": {
            "description": "Account creation timestamp.",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "description": "Author's email, when available.",
            "title": "Email",
            "type": "string"
          },
          "id": {
            "description": "Author's user ID.",
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "description": "Author's display name.",
            "title": "Name",
            "type": "string"
          },
          "state": {
            "description": "Author account state.",
            "title": "State",
            "type": "string"
          },
          "username": {
            "description": "Author's username.",
            "title": "Username",
            "type": "string"
          },
          "web_url": {
            "description": "Author's profile URL.",
            "title": "Web Url",
            "type": "string"
          }
        },
        "required": ["id", "username", "name"],
        "title": "MergeRequestNoteAuthor",
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "$ref": "#/$defs/GetMergeRequestNoteResponse",
        "description": "Data from the action execution",
        "title": "Data"
      }
    },
    "required": ["result"],
    "type": "object"
  }
}
