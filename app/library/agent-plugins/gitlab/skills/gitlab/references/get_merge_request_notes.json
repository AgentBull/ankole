{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "Fetches one page of comments on a specific merge request.",
  "inputSchema": {
    "properties": {
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "The ID or URL-encoded path of the project.",
        "examples": [123, "group/project-name"],
        "title": "Id"
      },
      "merge_request_iid": {
        "description": "Internal ID of the merge request.",
        "examples": [1],
        "title": "Merge Request Iid",
        "type": "integer"
      },
      "page": {
        "description": "Page number to retrieve.",
        "examples": [1],
        "minimum": 1,
        "title": "Page",
        "type": "integer"
      },
      "per_page": {
        "description": "Number of notes per page (max 100).",
        "examples": [20],
        "maximum": 100,
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      }
    },
    "required": ["id", "merge_request_iid"],
    "title": "GetMergeRequestNotesRequest",
    "type": "object"
  },
  "name": "get_merge_request_notes",
  "outputSchema": {
    "$defs": {
      "Author": {
        "properties": {
          "avatar_url": {
            "description": "Avatar URL of the author.",
            "title": "Avatar Url",
            "type": "string"
          },
          "id": {
            "description": "User ID of the author.",
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "description": "Name of the author.",
            "title": "Name",
            "type": "string"
          },
          "state": {
            "description": "State of the author account (e.g., 'active').",
            "title": "State",
            "type": "string"
          },
          "username": {
            "description": "Username of the author.",
            "title": "Username",
            "type": "string"
          },
          "web_url": {
            "description": "Web URL of the author's profile.",
            "title": "Web Url",
            "type": "string"
          }
        },
        "required": ["id", "username", "name", "state", "web_url"],
        "title": "Author",
        "type": "object"
      },
      "GetMergeRequestNotesResponse": {
        "properties": {
          "notes": {
            "description": "List of notes (comments) on the merge request.",
            "items": {
              "$ref": "#/$defs/Note"
            },
            "title": "Notes",
            "type": "array"
          }
        },
        "required": ["notes"],
        "title": "GetMergeRequestNotesResponse",
        "type": "object"
      },
      "Note": {
        "properties": {
          "_links": {
            "$ref": "#/$defs/NoteLinks",
            "title": " Links"
          },
          "attachment": {
            "description": "URL of any attachment.",
            "title": "Attachment",
            "type": "string"
          },
          "author": {
            "$ref": "#/$defs/Author",
            "description": "Author of the note.",
            "title": "Author"
          },
          "body": {
            "description": "Content of the note.",
            "title": "Body",
            "type": "string"
          },
          "created_at": {
            "description": "Creation timestamp (ISO 8601).",
            "title": "Created At",
            "type": "string"
          },
          "discussion_id": {
            "description": "ID of the discussion this note is part of.",
            "title": "Discussion Id",
            "type": "string"
          },
          "id": {
            "description": "ID of the note.",
            "title": "Id",
            "type": "integer"
          },
          "noteable_id": {
            "description": "ID of the merge request this note belongs to.",
            "title": "Noteable Id",
            "type": "integer"
          },
          "noteable_type": {
            "description": "Type of the noteable entity.",
            "title": "Noteable Type",
            "type": "string"
          },
          "position": {
            "$ref": "#/$defs/Position",
            "description": "Position details for diff notes.",
            "title": "Position"
          },
          "resolvable": {
            "description": "Whether this note is resolvable.",
            "title": "Resolvable",
            "type": "boolean"
          },
          "resolved": {
            "description": "Whether this note has been resolved.",
            "title": "Resolved",
            "type": "boolean"
          },
          "system": {
            "description": "Whether it's a system note.",
            "title": "System",
            "type": "boolean"
          },
          "updated_at": {
            "description": "Update timestamp (ISO 8601).",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "body", "author", "created_at", "updated_at", "system", "noteable_id", "noteable_type"],
        "title": "Note",
        "type": "object"
      },
      "NoteLinks": {
        "properties": {
          "self": {
            "description": "API endpoint URL for this note.",
            "title": "Self",
            "type": "string"
          }
        },
        "required": ["self"],
        "title": "NoteLinks",
        "type": "object"
      },
      "Position": {
        "properties": {
          "base_sha": {
            "description": "Base commit SHA for the position.",
            "title": "Base Sha",
            "type": "string"
          },
          "head_sha": {
            "description": "Head commit SHA for the position.",
            "title": "Head Sha",
            "type": "string"
          },
          "new_line": {
            "description": "Line number in the new file.",
            "title": "New Line",
            "type": "integer"
          },
          "new_path": {
            "description": "New file path in the diff context.",
            "title": "New Path",
            "type": "string"
          },
          "old_line": {
            "description": "Line number in the old file.",
            "title": "Old Line",
            "type": "integer"
          },
          "old_path": {
            "description": "Old file path in the diff context.",
            "title": "Old Path",
            "type": "string"
          },
          "position_type": {
            "description": "Type of the position (e.g., 'text').",
            "title": "Position Type",
            "type": "string"
          },
          "start_sha": {
            "description": "Start commit SHA for the position.",
            "title": "Start Sha",
            "type": "string"
          }
        },
        "required": ["position_type", "base_sha", "start_sha", "head_sha", "old_path", "new_path"],
        "title": "Position",
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "$ref": "#/$defs/GetMergeRequestNotesResponse",
        "description": "Data from the action execution",
        "title": "Data"
      }
    },
    "required": ["result"],
    "type": "object"
  }
}
