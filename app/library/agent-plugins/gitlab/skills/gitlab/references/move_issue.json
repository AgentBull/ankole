{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Moves an issue from one project to another in GitLab. The issue receives a new IID and project_id in the destination project. Use this action when you need to relocate an issue to a different project, such as when reorganizing work or transferring issues between team projects. If equivalent labels or milestones exist in the destination project, they are automatically assigned to the moved issue.",
  "inputSchema": {
    "properties": {
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "The global ID or URL-encoded path of the source project (e.g., '12345', 'my-group/my-project').",
        "examples": ["12345", "my-group/my-project"],
        "title": "Id"
      },
      "issue_iid": {
        "description": "The internal ID of the project's issue to move.",
        "examples": [42],
        "title": "Issue Iid",
        "type": "integer"
      },
      "to_project_id": {
        "description": "The ID of the destination project where the issue will be moved.",
        "examples": [67890],
        "title": "To Project Id",
        "type": "integer"
      }
    },
    "required": ["id", "issue_iid", "to_project_id"],
    "title": "MoveIssueRequest",
    "type": "object"
  },
  "name": "move_issue",
  "outputSchema": {
