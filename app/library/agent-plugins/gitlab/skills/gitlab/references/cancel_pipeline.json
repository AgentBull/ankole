    "properties": {
      "pipeline_id": {
        "description": "The ID of the pipeline to cancel.",
        "examples": [456],
        "title": "Pipeline Id",
        "type": "integer"
      },
      "project_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "The ID or URL-encoded path of the project.",
        "examples": ["123", "group_name/project_name"],
        "title": "Project Id"
      }
    },
    "required": ["project_id", "pipeline_id"],
    "title": "CancelPipelineRequest",
    "type": "object"
  },
  "name": "cancel_pipeline",
