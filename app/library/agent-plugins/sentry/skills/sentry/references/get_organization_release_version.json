{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "Retrieves detailed information, including optional health data and statistics, for a specific release version within a Sentry organization.",
  "inputSchema": {
    "description": "Request schema for `GetOrganizationReleaseVersion`",
    "properties": {
      "adoptionStages": {
        "description": "Include information about the release's adoption stages.",
        "examples": ["true", "false"],
        "title": "Adoption Stages",
        "type": "boolean"
      },
      "health": {
        "description": "Include health data (e.g., crash rates, session statistics) with release details.",
        "examples": ["true", "false"],
        "title": "Health",
        "type": "boolean"
      },
      "healthStatsPeriod": {
        "description": "Enumeration of time periods for release health statistics.",
        "enum": ["14d", "1d", "1h", "24h", "2d", "30d", "48h", "7d", "90d"],
        "examples": ["1h", "1d", "24h", "2d", "7d", "14d", "30d", "48h", "90d"],
        "title": "HealthstatsperiodEnm",
        "type": "string"
      },
      "organization_id_or_slug": {
        "description": "The unique identifier (ID) or human-readable slug of the Sentry organization.",
        "examples": ["my-org-slug", "sentry"],
        "title": "Organization Id Or Slug",
        "type": "string"
      },
      "project_id": {
        "description": "ID of a specific project to scope release details; if omitted, details may cover multiple projects.",
        "examples": ["54321"],
        "title": "Project Id",
        "type": "string"
      },
      "query": {
        "description": "Filter data for this release using Sentry's search syntax (e.g., to find specific events). See Sentry documentation for syntax. Example from Sentry: `'''(transaction:foo AND release:abc) OR (transaction:[bar,baz] AND release:def)'''`",
        "examples": ["environment:production", "error.type:TypeError", "transaction:my.transaction.name"],
        "title": "Query",
        "type": "string"
      },
      "sort": {
        "description": "Enumeration of fields for sorting release-related data.",
        "enum": ["crash_free_sessions", "crash_free_users", "date", "sessions", "users"],
        "examples": ["date", "sessions", "users", "crash_free_sessions", "crash_free_users"],
        "title": "SortEnm",
        "type": "string"
      },
      "status": {
        "description": "Enumeration of release statuses.",
        "enum": ["archived", "open"],
        "examples": ["open", "archived"],
        "title": "StatusEnm",
        "type": "string"
      },
      "summaryStatsPeriod": {
        "description": "Enumeration of time periods for release summary statistics.",
        "enum": ["14d", "1d", "1h", "24h", "2d", "30d", "48h", "7d", "90d"],
        "examples": ["1h", "1d", "24h", "2d", "7d", "14d", "30d", "48h", "90d"],
        "title": "SummarystatsperiodEnm",
        "type": "string"
      },
      "version": {
        "description": "The unique version identifier of the release. This can be a semantic version (e.g., '1.2.3'), a commit hash, or any string used to identify the release (e.g., 'backend@1.0.0-alpha').",
        "examples": ["1.2.3", "backend@1.0.0-alpha", "abc123def456", "sentry-app@21.5.0"],
        "title": "Version",
        "type": "string"
      }
    },
    "required": ["organization_id_or_slug", "version"],
    "title": "GetOrganizationReleaseVersionRequest",
    "type": "object"
  },
