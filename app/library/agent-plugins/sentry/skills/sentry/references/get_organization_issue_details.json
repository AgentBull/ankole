  "description": "Retrieves detailed information for a specific issue within a Sentry organization. Accepts both numeric issue IDs (e.g., '7159174717') and short IDs displayed in the Sentry UI (e.g., 'PROJECT-123', 'SENTRY-4V'). Short IDs are automatically resolved to numeric IDs before fetching issue details.",
  "inputSchema": {
    "description": "Request schema for retrieving detailed information about a specific issue within an organization.",
    "properties": {
      "issue_id": {
        "description": "The issue ID. Can be either a numeric ID (e.g., '7159174717') or a short ID displayed in the Sentry UI (e.g., 'PROJECT-123', 'SENTRY-4V'). Short IDs will be automatically resolved to numeric IDs.",
        "examples": ["7159174717", "PROJECT-123", "SENTRY-4V"],
        "title": "Issue Id",
        "type": "string"
      },
      "organization_id_or_slug": {
        "description": "The unique identifier (ID) or URL-friendly slug of the Sentry organization to which the issue belongs.",
        "examples": ["my-organization-slug", "1234567890"],
        "title": "Organization Id Or Slug",
        "type": "string"
      }
    },
    "required": ["organization_id_or_slug", "issue_id"],
    "title": "GetOrganizationIssueDetailsRequest",
    "type": "object"
  },
  "name": "get_organization_issue_details",
