  "description": "Retrieves a list of Sentry projects for a specific team within an organization, supporting pagination via a cursor.",
  "inputSchema": {
    "description": "Request schema for retrieving a list of projects associated with a Sentry team.",
    "properties": {
      "cursor": {
        "description": "Pagination cursor for navigating through project lists; if omitted, the first page is returned.",
        "examples": ["cD0yMDIxLTAxLTE1VDAwJTNBMDElM0EwMC4wMDBaJm89DESCJnA9MTA"],
        "title": "Cursor",
        "type": "string"
      },
      "organization_id_or_slug": {
        "description": "The ID or slug of the Sentry organization.",
        "examples": ["my-organization-slug", "acme-corp", "1234567"],
        "title": "Organization Id Or Slug",
        "type": "string"
      },
      "team_id_or_slug": {
        "description": "The ID or slug of the Sentry team.",
        "examples": ["my-team-slug", "frontend-developers", "9876543"],
        "title": "Team Id Or Slug",
        "type": "string"
      }
    },
    "required": ["organization_id_or_slug", "team_id_or_slug"],
    "title": "RetrieveTeamProjectsRequest",
    "type": "object"
  },
