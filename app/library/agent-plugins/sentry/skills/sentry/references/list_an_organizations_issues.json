{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "Returns a list of issues (error groups) for an organization. Use when you need to retrieve and analyze error patterns, track unresolved issues, or monitor issue trends. Default query applies 'is:unresolved issue.priority:[high,medium]'.",
  "inputSchema": {
    "description": "Request schema for listing issues within a Sentry organization.",
    "properties": {
      "collapse": {
        "description": "Fields to exclude from the response. Valid choices: base, filtered, lifetime, stats, unhandled.",
        "examples": [["stats"], ["base", "stats"]],
        "items": {
          "type": "string"
        },
        "title": "Collapse",
        "type": "array"
      },
      "cursor": {
        "description": "Pagination cursor to retrieve next or previous results. Iterate using Link response headers until exhausted to retrieve all results.",
        "examples": ["0:0:1", "0:100:0"],
        "title": "Cursor",
        "type": "string"
      },
      "end": {
        "description": "Query period end time in ISO-8601 format (e.g., 2001-12-14T12:34:56.7890).",
        "examples": ["2024-12-31T23:59:59.999Z"],
        "title": "End",
        "type": "string"
      },
      "environment": {
        "description": "Filter issues by environment names. Pass multiple environment names to filter by multiple environments.",
        "examples": [["production"], ["staging", "production"]],
        "items": {
          "type": "string"
        },
        "title": "Environment",
        "type": "array"
      },
      "expand": {
        "description": "Additional data to include in the response. Valid choices: inbox, integrationIssues, latestEventHasAttachments, owners, pluginActions, pluginIssues, sentryAppIssues, sessions.",
        "examples": [["owners"], ["inbox", "owners"]],
        "items": {
          "type": "string"
        },
        "title": "Expand",
        "type": "array"
      },
      "groupStatsPeriod": {
        "description": "Stats timeline period.",
        "enum": ["14d", "24h", "auto"],
        "examples": ["24h", "14d", "auto"],
        "title": "Group Stats Period",
        "type": "string"
      },
      "limit": {
        "description": "Maximum number of issues to return. Default: 100, Maximum: 100.",
        "examples": [10, 25, 50, 100],
        "title": "Limit",
        "type": "integer"
      },
      "organization_id_or_slug": {
        "description": "The ID or slug of the organization to retrieve issues from.",
        "examples": ["example", "my-organization"],
        "title": "Organization Id Or Slug",
        "type": "string"
      },
      "project": {
        "description": "Filter issues by project IDs. Use -1 to include all available projects.",
        "examples": [[1234567], [123, 456, 789], [-1]],
        "items": {
          "type": "integer"
        },
        "title": "Project",
        "type": "array"
      },
      "query": {
        "description": "Search query for filtering issues. Defaults to 'is:unresolved issue.priority:[high,medium]'. Use an empty string to return all results. Must follow Sentry search syntax; malformed or overly narrow queries silently return empty results.",
        "examples": ["is:unresolved", "is:resolved", "assigned:me", ""],
        "title": "Query",
        "type": "string"
      },
      "shortIdLookup": {
        "description": "Parse query for short IDs when set to 1.",
        "enum": ["0", "1"],
        "examples": ["1", "0"],
        "title": "Short Id Lookup",
        "type": "string"
      },
      "sort": {
        "description": "Sort order for issues.",
        "enum": ["date", "freq", "inbox", "new", "trends", "user"],
        "examples": ["date", "freq", "new", "trends", "user"],
        "title": "Sort",
        "type": "string"
      },
      "start": {
        "description": "Query period start time in ISO-8601 format (e.g., 2001-12-14T12:34:56.7890).",
        "examples": ["2024-01-01T00:00:00.000Z"],
        "title": "Start",
        "type": "string"
      },
      "statsPeriod": {
        "description": "Time period for the query (e.g., 24h, 7d, 14d). Supports d (days), h (hours), m (minutes), s (seconds), w (weeks) suffixes. Overrides start and end parameters. Affects stats display only, not which issues are returned; use start/end or filter on dateCreated/lastSeen for precise time-bounded issue sets.",
        "examples": ["24h", "7d", "14d"],
        "title": "Stats Period",
        "type": "string"
      },
      "viewId": {
        "description": "View ID to apply custom query and filters.",
        "examples": ["1234567890"],
        "title": "View Id",
        "type": "string"
      }
    },
    "required": ["organization_id_or_slug"],
    "title": "ListAnOrganizationsIssuesRequest",
    "type": "object"
  },
