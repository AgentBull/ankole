  "description": "Retrieves the 'latest', 'oldest', or 'recommended' event for a Sentry issue within an organization, optionally filtered by environment(s).",
  "inputSchema": {
    "description": "Parameters for fetching a specific event ('latest', 'oldest', or 'recommended') for a Sentry issue within an organization.",
    "properties": {
      "environment": {
        "description": "Filter by environment names; if omitted, events from all environments are considered.",
        "examples": [["production"], ["staging", "development"]],
        "items": {
          "type": "string"
        },
        "title": "Environment",
        "type": "array"
      },
      "event_id": {
        "description": "The event to retrieve. Use 'latest' for most recent, 'oldest' for first, 'recommended' for Sentry's recommended event, or a specific event ID.",
        "examples": ["latest", "oldest", "recommended", "abc123def456"],
        "title": "Event Id",
        "type": "string"
      },
      "issue_id": {
        "description": "The unique numerical ID of the Sentry issue for which to fetch an event.",
        "examples": [123456789, 987654321],
        "title": "Issue Id",
        "type": "integer"
      },
      "organization_id_or_slug": {
        "description": "The ID or slug of the organization the issue belongs to.",
        "examples": ["my-organization", "example", "1234567890"],
        "title": "Organization Id Or Slug",
        "type": "string"
      }
    },
    "required": ["organization_id_or_slug", "issue_id", "event_id"],
    "title": "FetchIssueEventByIdRequest",
    "type": "object"
  },
