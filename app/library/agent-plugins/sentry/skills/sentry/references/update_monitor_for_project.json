{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Updates a monitor for a project. Use when you need to modify monitor name, schedule, check-in margin, max runtime, timezone, status, owner, or alert thresholds for a project-level monitor.",
  "inputSchema": {
    "description": "Request schema for updating a monitor for a project.",
    "properties": {
      "config": {
        "additionalProperties": false,
        "description": "The configuration for the monitor including schedule, thresholds, and alert settings.",
        "properties": {
          "checkin_margin": {
            "description": "Grace period in minutes before a monitor is marked as missed if check-in is late.",
            "examples": [10, 15, 30],
            "title": "Checkin Margin",
            "type": "integer"
          },
          "failure_issue_threshold": {
            "description": "Number of consecutive failures before creating an incident.",
            "examples": [1, 3, 5],
            "title": "Failure Issue Threshold",
            "type": "integer"
          },
          "max_runtime": {
            "description": "Maximum expected execution time in minutes. Check-ins running longer will be marked as failed.",
            "examples": [30, 60, 120],
            "title": "Max Runtime",
            "type": "integer"
          },
          "recovery_threshold": {
            "description": "Number of consecutive successful check-ins required to resolve an incident.",
            "examples": [1, 2, 3],
            "title": "Recovery Threshold",
            "type": "integer"
          },
          "schedule": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "type": "array"
              }
            ],
            "description": "Schedule definition. For crontab: a cron expression string (e.g., '0 */6 * * *'). For interval: array with [value, unit] (e.g., [5, 'minute']).",
            "examples": ["0 */6 * * *", "0 0 * * *"],
            "title": "Schedule"
          },
          "schedule_type": {
            "description": "Type of schedule: 'crontab' for cron expressions or 'interval' for fixed intervals.",
            "enum": ["crontab", "interval"],
            "examples": ["crontab", "interval"],
            "title": "ScheduleTypeEnum",
            "type": "string"
          },
          "timezone": {
            "description": "IANA timezone identifier for the schedule (e.g., 'UTC', 'America/New_York').",
            "examples": ["UTC", "America/New_York", "Europe/London"],
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": ["schedule"],
        "title": "Config",
        "type": "object"
      },
      "is_muted": {
        "description": "Disable creation of monitor incidents. Set to true to suppress alerts.",
        "examples": [true, false],
        "title": "Is Muted",
        "type": "boolean"
      },
      "monitor_id_or_slug": {
        "description": "The ID or slug of the monitor to update.",
        "examples": ["daily-health-check-monitor", "my-monitor", "abcdef123"],
        "title": "Monitor Id Or Slug",
        "type": "string"
      },
      "name": {
        "description": "Name of the monitor. Used for notifications. Required field.",
        "examples": ["Daily Health Check", "Backup Job Monitor", "Data Sync Task"],
        "title": "Name",
        "type": "string"
      },
      "organization_id_or_slug": {
        "description": "The ID or slug of the organization the resource belongs to.",
        "examples": ["my-org", "example", "1234567"],
        "title": "Organization Id Or Slug",
        "type": "string"
      },
      "owner": {
        "description": "The ID of the team or user that owns the monitor. Format: 'user:51' or 'team:6'.",
        "examples": ["user:51", "team:6", "user:12345"],
        "title": "Owner",
        "type": "string"
      },
      "project": {
        "description": "The project slug to associate the monitor to. Required field.",
        "examples": ["my-project", "backend-api", "frontend-app"],
        "title": "Project",
        "type": "string"
      },
      "project_id_or_slug": {
        "description": "The ID or slug of the project the resource belongs to.",
        "examples": ["my-project", "backend-api", "9876543"],
        "title": "Project Id Or Slug",
        "type": "string"
      },
      "slug": {
        "description": "Uniquely identifies your monitor within your organization. Changing this slug will require updates to any instrumented check-in calls. Must start with a lowercase letter and contain only lowercase letters, numbers, underscores, or hyphens.",
        "examples": ["daily-health-check", "backup-monitor-v2"],
        "pattern": "^[a-z][a-z0-9_\\-]*$",
        "title": "Slug",
        "type": "string"
      },
      "status": {
        "description": "Status of the monitor. Disabled monitors will not accept events and will not count towards the monitor quota.",
        "enum": ["active", "disabled"],
        "examples": ["active", "disabled"],
        "title": "StatusEnum",
        "type": "string"
      }
    },
    "required": ["organization_id_or_slug", "project_id_or_slug", "monitor_id_or_slug", "name", "project", "config"],
    "title": "UpdateMonitorForProjectRequest",
    "type": "object"
  },
