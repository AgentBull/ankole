  "description": "Retrieves detailed information for a Sentry project, given its existing organization and project ID or slug.",
  "inputSchema": {
    "description": "Request to retrieve detailed information for a Sentry project.",
    "properties": {
      "organization_id_or_slug": {
        "description": "ID or slug of the Sentry organization to which the project belongs.",
        "examples": ["sentry-sdks", "my-organization", "99-apples"],
        "title": "Organization Id Or Slug",
        "type": "string"
      },
      "project_id_or_slug": {
        "description": "ID or slug of the Sentry project.",
        "examples": ["sentry-python", "my-web-app"],
        "title": "Project Id Or Slug",
        "type": "string"
      }
    },
    "required": ["organization_id_or_slug", "project_id_or_slug"],
    "title": "AccessProjectInformationRequest",
    "type": "object"
  },
  "name": "access_project_information",
