{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Updates a Sentry project's settings (e.g., name, slug, platform, bookmark status); `isBookmarked` can be updated with `project:read` permission, other fields typically require `project:write` or `project:admin` permissions.",
  "inputSchema": {
    "description": "Parameters to update a Sentry project.",
    "properties": {
      "highlightContext": {
        "additionalProperties": true,
        "description": "A JSON object mapping context types (e.g., 'user', 'device') to a list of their keys to be highlighted in Sentry's UI for issues within this project. For example: `{\"user\": [\"id\", \"email\"], \"device\": [\"model\"]}`.",
        "examples": [
          {
            "device": ["family", "model"],
            "user": ["id", "email", "username"]
          }
        ],
        "title": "Highlight Context",
        "type": "object"
      },
      "highlightTags": {
        "description": "A list of tag keys (e.g., 'release', 'environment') to highlight on this project's issues in Sentry's UI. For example: `[\"release\", \"environment\", \"server_name\"]`.",
        "examples": [["release", "environment"], ["customer-id"]],
        "items": {
          "type": "string"
        },
        "title": "Highlight Tags",
        "type": "array"
      },
      "isBookmarked": {
        "description": "Toggles whether the project is starred (bookmarked) in the Sentry UI.",
        "examples": [true, false],
        "title": "Is Bookmarked",
        "type": "boolean"
      },
      "name": {
        "description": "The new name for the project.",
        "examples": ["My Awesome Project v2"],
        "title": "Name",
        "type": "string"
      },
      "organization_id_or_slug": {
        "description": "The ID or slug of the Sentry organization to which the project belongs.",
        "examples": ["my-organization", "acme-corp"],
        "title": "Organization Id Or Slug",
        "type": "string"
      },
      "platform": {
        "description": "The new platform for the project (e.g., `python`, `javascript`, `java`). This helps Sentry categorize and process errors.",
        "examples": [
          "python",
          "javascript",
          "java",
          "ruby",
          "go",
          "php",
          "node",
          "elixir",
          "csharp",
          "cocoa",
          "android",
          "flutter",
          "dart"
        ],
        "title": "Platform",
        "type": "string"
      },
      "project_id_or_slug": {
        "description": "The ID or slug of the Sentry project to be updated.",
        "examples": ["internal-project", "frontend-app"],
        "title": "Project Id Or Slug",
        "type": "string"
      },
      "resolveAge": {
        "description": "The duration in hours after which an issue is automatically resolved if it hasn't been seen. Set to `0` to disable auto-resolution. ",
        "examples": [0, 24, 168],
        "title": "Resolve Age",
        "type": "integer"
      },
      "slug": {
        "description": "The new unique identifier (slug) for the project, used in URLs and the Sentry interface.",
        "examples": ["new-project-slug"],
        "pattern": "^[a-z][a-z0-9_\\-]*$",
        "title": "Slug",
        "type": "string"
      },
      "subjectPrefix": {
        "description": "Custom prefix for the subject line of notification emails sent from this project.",
        "examples": ["[ProjectX Alerts]", "[Urgent]"],
        "title": "Subject Prefix",
        "type": "string"
      },
      "subjectTemplate": {
        "description": "The template for the email subject (excluding the prefix) for individual issue alerts. Available variables: `$title`, `$shortID`, `$projectID`, `$orgID`, and `${tag:key}` (e.g., `${tag:environment}`, `${tag:release}`).",
        "examples": ["Error in $projectID: $title", "Issue $shortID - $title (${tag:environment})"],
        "title": "Subject Template",
        "type": "string"
      }
    },
    "required": ["organization_id_or_slug", "project_id_or_slug"],
    "title": "UpdateProjectDetailsRequest",
    "type": "object"
  },
