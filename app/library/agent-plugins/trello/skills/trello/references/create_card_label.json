  "description": "Adds a label to an existing Trello card (specified by `idCard`), defining the label by `name` and either `color` or the overriding `value` (which specifies color by name); a new label is created on the board if a matching one (by name/color combination) doesn't already exist.",
  "inputSchema": {
    "description": "Request for adding a label to a Trello card.",
    "properties": {
      "color": {
        "description": "Label color name. Valid colors: green, yellow, orange, red, purple, blue, sky, lime, pink, black, or null for no color. Used if 'value' is not provided.",
        "examples": ["green", "red", "blue", "yellow", "purple", "orange"],
        "title": "Color",
        "type": "string"
      },
      "idCard": {
        "description": "ID or shortlink of the card.",
        "examples": ["5abbe4b7ddc1b351ef961414", "cardShortLink123"],
        "title": "Id Card",
        "type": "string"
      },
      "name": {
        "description": "Name for the label (0-16384 chars). If a label with this name exists on the board, it will be reused; otherwise, a new label with this name and specified color is created and added to the card.",
        "examples": ["High Priority", "Bug", "Feature Request"],
        "title": "Name",
        "type": "string"
      },
      "value": {
        "description": "Alternative way to specify label color by name. When using 'all', adds all default board labels to the card. Overrides 'color' parameter if both are provided.",
        "examples": ["yellow", "all"],
        "title": "Value",
        "type": "string"
      }
    },
    "required": ["idCard"],
    "title": "CreateCardLabelRequest",
    "type": "object"
  },
  "name": "create_card_label",
  "outputSchema": {
    "$defs": {
