  "description": "Retrieves the history of actions (e.g., comments, updates, moves) for a Trello card specified by `idCard`; the card must exist and very old actions might not be available.",
  "inputSchema": {
    "description": "Request schema for `GetCardsActionsByIdCard`",
    "properties": {
      "before": {
        "description": "A date in ISO 8601 format (e.g., '2023-12-31T23:59:59Z'), or 'null'. Returns actions that occurred before this date.",
        "examples": ["2023-12-31T23:59:59Z"],
