  "description": "Updates an existing Trello member's profile information, preferences, or username.",
  "inputSchema": {
    "description": "Request schema for `UpdateMembersByIdMember`",
    "properties": {
      "avatarSource": {
        "description": "Source for the member's avatar. Valid values: 'gravatar', 'none', 'upload'.",
        "examples": ["gravatar", "none", "upload"],
        "title": "Avatar Source",
        "type": "string"
      },
      "bio": {
        "description": "Biography (0-16384 characters).",
        "examples": ["Software developer passionate about Trello.", "Currently seeking new opportunities."],
        "title": "Bio",
        "type": "string"
      },
      "fullName": {
        "description": "Full name (at least 1 character; no leading/trailing spaces).",
        "examples": ["John Doe", "Jane A. Smith"],
        "title": "Full Name",
        "type": "string"
      },
      "idMember": {
        "description": "The ID or username of the Trello member to update.",
        "examples": ["65f089b29142572f51b73816", "john_doe_123"],
        "title": "Id Member",
        "type": "string"
      },
      "initials": {
        "description": "Initials (1-4 characters; no leading/trailing spaces).",
        "examples": ["JD", "JAS"],
        "title": "Initials",
        "type": "string"
      },
      "prefs__colorBlind": {
        "description": "Toggle color blind mode. Valid values: 'true', 'false'.",
        "examples": ["true", "false"],
        "title": "Prefs  Color Blind",
        "type": "string"
      },
      "prefs__locale": {
        "description": "Preferred locale (0-255 characters).",
        "examples": ["en-US", "fr-FR", "es"],
        "title": "Prefs  Locale",
        "type": "string"
      },
      "prefs__minutesBetweenSummaries": {
        "description": "Time between email summaries. Valid values: '-1' (disabled), '1' (every minute), '60' (every hour).",
        "examples": ["-1", "1", "60"],
        "title": "Prefs  Minutes Between Summaries",
        "type": "string"
      },
      "username": {
        "description": "Desired username (at least 3 characters; lowercase letters, underscores, numbers only; must be unique).",
        "examples": ["new_username_123", "jane_developer"],
        "title": "Username",
        "type": "string"
      }
    },
    "required": ["idMember"],
    "title": "UpdateMembersByIdMemberRequest",
    "type": "object"
  },
