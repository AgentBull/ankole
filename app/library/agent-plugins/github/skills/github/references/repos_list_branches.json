            },
            "protected": {
              "type": "boolean"
            },
            "protection": {
              "properties": {
                "allow_deletions": {
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "allow_force_pushes": {
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "allow_fork_syncing": {
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "block_creations": {
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "enabled": {
                  "type": "boolean"
                },
                "enforce_admins": {
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": ["url", "enabled"],
                  "type": "object"
                },
                "lock_branch": {
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "name": {
                  "type": "string"
                },
                "protection_url": {
                  "type": "string"
                },
                "required_conversation_resolution": {
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "required_linear_history": {
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "required_pull_request_reviews": {
                  "properties": {
                    "bypass_pull_request_allowances": {
                      "type": "object"
                    },
                    "dismiss_stale_reviews": {
                      "type": "boolean"
                    },
                    "dismissal_restrictions": {
                      "type": "object"
                    },
                    "require_code_owner_reviews": {
                      "type": "boolean"
                    },
                    "require_last_push_approval": {
                      "type": "boolean"
                    },
                    "required_approving_review_count": {
                      "maximum": 6,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": ["dismiss_stale_reviews", "require_code_owner_reviews"],
                  "type": "object"
                },
                "required_signatures": {
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": ["url", "enabled"],
                  "type": "object"
                },
                "required_status_checks": {
                  "properties": {
                    "checks": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "contexts": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "contexts_url": {
                      "type": "string"
                    },
                    "enforcement_level": {
                      "type": "string"
