{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "List branches",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "owner": {
        "type": "string"
      },
      "page": {
        "type": "integer"
      },
      "per_page": {
        "type": "integer"
      },
      "protected": {
        "type": "boolean"
      },
      "repo": {
        "type": "string"
      }
    },
    "required": ["owner", "repo"],
    "type": "object"
  },
  "name": "repos_list_branches",
