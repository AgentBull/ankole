                    "apps": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "apps_url": {
                      "type": "string"
                    },
                    "teams": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "teams_url": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "users": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "users_url": {
                      "type": "string"
                    }
                  },
                  "required": ["url", "users_url", "teams_url", "apps_url", "users", "teams", "apps"],
                  "type": "object"
                },
                "url": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "protection_url": {
              "type": "string"
