{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Download an artifact",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "archive_format": {
        "type": "string"
      },
      "artifact_id": {
        "type": "integer"
      },
      "destination": {
        "additionalProperties": false,
        "properties": {
          "base_object_id": {
            "type": ["string", "null"]
          },
          "content_type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "page_id": {
            "type": "string"
          },
          "role": {
            "enum": ["file", "asset", "attachment"],
            "type": "string"
          }
        },
        "required": ["page_id", "role", "name"],
        "type": "object"
      },
      "owner": {
        "type": "string"
      },
      "repo": {
        "type": "string"
      }
    },
    "required": ["owner", "repo", "artifact_id", "destination"],
    "type": "object"
  },
  "name": "actions_download_artifact",
  "outputSchema": {
    "properties": {
      "content_type": {
        "type": ["string", "null"]
      },
      "file_ref": {
        "type": "string"
      },
      "size": {
        "type": "integer"
      }
    },
    "required": ["file_ref"],
    "type": "object"
  }
}
