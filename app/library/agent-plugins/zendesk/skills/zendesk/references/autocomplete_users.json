          }
        },
        "required": ["name"],
        "title": "AutocompleteUserItem",
        "type": "object"
      },
      "AutocompleteUsersResponse": {
        "description": "Response containing autocomplete user suggestions.",
        "properties": {
          "users": {
            "description": "Array of users matching the autocomplete query",
            "items": {
              "$ref": "#/$defs/AutocompleteUserItem"
            },
