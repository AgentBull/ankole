{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "Find Zendesk users using autocomplete by name prefix, phone, or lookup relationship, with optional filters. Name or phone searches cannot be combined with lookup relationship parameters.",
  "inputSchema": {
    "description": "Request body for autocomplete users search.\n\nname/phone (name-prefix search) and field_id/source (lookup-relationship\nsearch) are two separate, mutually exclusive autocomplete modes. Zendesk\ndoes not document this explicitly, but combining name with field_id/source\nreturns a 400 'Parameter source must be a valid type is required' error.",
    "properties": {
      "field_id": {
        "description": "Field ID for lookup relationship autocomplete. If source is also provided, it must be a recognized type string — an unrecognized value 400s with \"Parameter source must be a valid type is required\". field_id alone (with no source) is accepted and simply returns no matches. Cannot be combined with name/phone.",
        "examples": [12345],
        "title": "Field Id",
        "type": "integer"
      },
      "filter": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "description": "Filter options for autocomplete results.",
            "properties": {
              "dynamic_values": {
                "anyOf": [
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": "null",
                "description": "Dynamic values filter object for lookup relationship autocomplete",
                "title": "Dynamic Values"
              }
            },
            "title": "AutocompleteUsersFilter",
            "type": "object"
          }
        ],
        "description": "Filter to apply to autocomplete results. Common values: 'assignable', 'requester', or 'dynamic_values' object.",
        "examples": ["assignable", "requester"],
        "title": "Filter"
      },
      "name": {
        "description": "The name to search for matching users. Returns users whose name starts with the provided value. Cannot be combined with field_id/source.",
        "examples": ["gil", "john doe"],
        "title": "Name",
        "type": "string"
      },
      "phone": {
        "description": "The phone number to search for matching users. Cannot be combined with field_id/source.",
        "examples": ["+14155551234"],
        "title": "Phone",
        "type": "string"
      },
      "source": {
        "description": "The type of the object referenced by field_id. When provided, must be one of the recognized values: 'zen:user', 'zen:organization', 'zen:ticket', or 'zen:custom_object:CUSTOM_OBJECT_KEY' (also 'zen:article'/'zen:brand' for lookup fields defined on a custom object) — any other value 400s with \"Parameter source must be a valid type is required\".",
        "examples": ["zen:user"],
        "title": "Source",
        "type": "string"
      }
    },
    "title": "AutocompleteUsersRequest",
    "type": "object"
  },
  "name": "autocomplete_users",
  "outputSchema": {
    "$defs": {
      "AutocompleteUserItem": {
