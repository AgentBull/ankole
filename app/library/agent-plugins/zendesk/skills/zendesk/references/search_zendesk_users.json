{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "Search for Zendesk users by query or external ID. Supports flexible user search criteria using Zendesk search syntax, including names, email, notes, and phone numbers.",
  "inputSchema": {
    "description": "Request parameters for searching Zendesk users via the Users Search API.",
    "properties": {
      "external_id": {
        "description": "The `external_id` parameter does not support the search syntax. It only accepts exact ID values.",
        "examples": ["abc124"],
        "title": "External Id",
        "type": "string"
      },
      "include": {
        "description": "A comma-separated list of sideloads to include in the response.",
        "examples": ["organizations"],
        "title": "Include",
        "type": "string"
      },
      "page": {
        "description": "Page number for offset-based pagination (non-negative integer).",
        "examples": [1],
        "minimum": 1,
        "title": "Page",
        "type": "integer"
      },
      "per_page": {
        "description": "Number of records to return per page. Default and maximum values vary by endpoint.",
        "examples": [25],
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      },
      "query": {
        "description": "The `query` parameter supports the Zendesk search syntax for more advanced user searches. It can specify a partial or full value of any user property, including name, email address, notes, or phone. Example: `query='jdoe'`. See the [Search API](/api-reference/ticketing/ticket-management/search/).",
        "examples": ["jdoe"],
        "title": "Query",
        "type": "string"
      }
    },
    "title": "SearchZendeskUsersRequest",
    "type": "object"
  },
  "name": "search_zendesk_users",
  "outputSchema": {
    "$defs": {
      "SearchZendeskUsersResponse": {
        "description": "Response containing search results for Zendesk users.",
        "properties": {
          "count": {
            "description": "Total count of users matching the query",
            "title": "Count",
            "type": "integer"
          },
          "next_page": {
            "description": "URL for the next page of results",
            "title": "Next Page",
            "type": "string"
          },
          "previous_page": {
            "description": "URL for the previous page of results",
            "title": "Previous Page",
            "type": "string"
          },
          "users": {
            "description": "List of users matching the search criteria",
            "items": {
              "$ref": "#/$defs/ZendeskSearchUser"
            },
            "title": "Users",
            "type": "array"
          }
        },
        "required": ["users"],
        "title": "SearchZendeskUsersResponse",
        "type": "object"
      },
      "UserPhoto": {
        "description": "User photo object.",
        "properties": {
          "content_type": {
            "description": "MIME type (e.g., image/png)",
            "title": "Content Type",
            "type": "string"
          },
          "content_url": {
            "description": "URL where the photo can be downloaded",
            "title": "Content Url",
            "type": "string"
          },
          "deleted": {
            "description": "True if attachment is deleted",
            "title": "Deleted",
            "type": "boolean"
          },
          "file_name": {
            "description": "Photo filename",
            "title": "File Name",
            "type": "string"
          },
          "height": {
            "description": "Image height in pixels",
            "title": "Height",
            "type": "integer"
          },
          "id": {
            "description": "Photo attachment ID",
            "title": "Id",
            "type": "integer"
          },
          "inline": {
            "description": "True if inline attachment",
            "title": "Inline",
            "type": "boolean"
          },
          "mapped_content_url": {
            "description": "Mapped URL for the photo",
            "title": "Mapped Content Url",
            "type": "string"
          },
          "size": {
            "description": "File size in bytes",
            "title": "Size",
            "type": "integer"
          },
          "url": {
            "description": "API URL to access attachment details",
            "title": "Url",
            "type": "string"
          },
          "width": {
            "description": "Image width in pixels",
            "title": "Width",
            "type": "integer"
          }
        },
        "title": "UserPhoto",
        "type": "object"
      },
      "ZendeskSearchUser": {
        "description": "Zendesk user object returned from search results.",
        "properties": {
          "locale": {
            "description": "User locale",
            "title": "Locale",
            "type": "string"
          },
          "remote_photo_url": {
            "description": "Remote photo URL",
            "title": "Remote Photo Url",
            "type": "string"
          },
          "url": {
            "description": "API URL of the user",
            "title": "Url",
            "type": "string"
          },
          "notes": {
            "description": "Notes on the user profile",
            "title": "Notes",
            "type": "string"
          },
          "role_type": {
            "description": "Role type ID",
            "title": "Role Type",
            "type": "integer"
          },
          "external_id": {
            "description": "External system ID",
            "title": "External Id",
            "type": "string"
          },
          "updated_at": {
            "description": "Timestamp when the user was last updated",
            "title": "Updated At",
            "type": "string"
          },
          "iana_time_zone": {
            "description": "IANA timezone",
            "title": "Iana Time Zone",
            "type": "string"
          },
          "two_factor_auth_enabled": {
            "description": "True if 2FA is enabled",
            "title": "Two Factor Auth Enabled",
            "type": "boolean"
          },
          "agent_brand_ids": {
            "description": "Agent brand IDs",
            "items": {
              "type": "integer"
            },
            "title": "Agent Brand Ids",
            "type": "array"
          },
          "details": {
            "description": "User details",
            "title": "Details",
            "type": "string"
          },
          "only_private_comments": {
            "description": "True if user can only make private comments",
            "title": "Only Private Comments",
            "type": "boolean"
          },
          "tags": {
            "description": "List of user tags",
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "created_at": {
            "description": "Timestamp when the user was created",
            "title": "Created At",
            "type": "string"
          },
          "phone": {
            "description": "User phone number",
            "title": "Phone",
            "type": "string"
          },
          "locale_id": {
            "description": "Locale ID",
            "title": "Locale Id",
            "type": "integer"
          },
          "name": {
            "description": "User's full name",
            "title": "Name",
            "type": "string"
          },
          "email": {
            "description": "User's primary email address",
            "title": "Email",
            "type": "string"
          },
          "alias": {
            "description": "User alias",
            "title": "Alias",
            "type": "string"
          },
          "shared_agent": {
            "description": "True if agent is shared",
            "title": "Shared Agent",
            "type": "boolean"
          },
          "custom_role_id": {
            "description": "Custom role ID",
            "title": "Custom Role Id",
            "type": "integer"
          },
          "restricted_agent": {
            "description": "True if agent is restricted",
            "title": "Restricted Agent",
            "type": "boolean"
          },
          "moderator": {
            "description": "True if user is a moderator",
            "title": "Moderator",
            "type": "boolean"
          },
          "role": {
            "description": "User role (end-user, agent, admin)",
            "title": "Role",
            "type": "string"
          },
          "report_csv": {
            "description": "True if user can access CSV reports",
            "title": "Report Csv",
            "type": "boolean"
          },
          "last_login_at": {
            "description": "Timestamp of last login",
            "title": "Last Login At",
            "type": "string"
          },
          "signature": {
            "description": "User signature",
            "title": "Signature",
            "type": "string"
          },
          "verified": {
            "description": "True if user is verified",
            "title": "Verified",
            "type": "boolean"
          },
          "suspended": {
            "description": "True if user is suspended",
            "title": "Suspended",
            "type": "boolean"
          },
          "user_fields": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "description": "Custom user fields with admin-defined keys and dynamic values",
            "title": "User Fields",
            "type": "object"
          },
          "active": {
            "description": "True if the user is active",
            "title": "Active",
            "type": "boolean"
          },
          "photo": {
            "$ref": "#/$defs/UserPhoto",
            "description": "User photo object",
            "title": "Photo"
          },
          "ticket_restriction": {
            "description": "Ticket restriction level",
            "title": "Ticket Restriction",
            "type": "string"
          },
          "time_zone": {
            "description": "User timezone",
            "title": "Time Zone",
            "type": "string"
          },
          "id": {
            "description": "User ID",
            "title": "Id",
            "type": "integer"
          },
          "shared_phone_number": {
            "description": "True if phone number is shared",
            "title": "Shared Phone Number",
            "type": "boolean"
          },
          "shared": {
            "description": "True if user is shared",
            "title": "Shared",
            "type": "boolean"
          },
          "chat_only": {
            "description": "True if user is chat-only (Zendesk Chat)",
            "title": "Chat Only",
            "type": "boolean"
          },
          "default_group_id": {
            "description": "Default group ID",
            "title": "Default Group Id",
            "type": "integer"
          },
          "organization_id": {
            "description": "Organization ID",
            "title": "Organization Id",
            "type": "integer"
          }
        },
        "required": ["id", "name"],
        "title": "ZendeskSearchUser",
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "$ref": "#/$defs/SearchZendeskUsersResponse",
        "description": "Data from the action execution",
        "title": "Data"
      }
    },
    "required": ["result"],
    "type": "object"
  }
}
