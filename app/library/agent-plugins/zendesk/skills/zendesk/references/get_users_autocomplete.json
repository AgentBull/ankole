{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "Autocomplete users by name or phone number. Use when you need to find users based on a partial name or phone number for ticket creation or user lookup scenarios. At least one of 'name' or 'phone' must be provided.",
  "inputSchema": {
    "description": "Request parameters for autocompleting Zendesk users.",
    "properties": {
      "field_id": {
        "description": "The ID of a lookup relationship field. The type of field is determined by the 'source' parameter.",
        "examples": ["12345"],
        "title": "Field Id",
        "type": "string"
      },
      "filter": {
        "description": "Filter values for autocomplete results.",
        "enum": ["assignable", "requester"],
        "examples": ["assignable"],
        "title": "GetUsersAutocompleteFilter",
        "type": "string"
      },
      "include": {
        "description": "Sideloads to include in the response. Accepts a comma-separated list of values. See Sideloading for available options.",
        "examples": ["roles,organizations"],
        "title": "Include",
        "type": "string"
      },
      "name": {
        "description": "The name to search for the user. You must specify either 'name' or 'phone'.",
        "examples": ["gil"],
        "title": "Name",
        "type": "string"
      },
      "per_page": {
        "description": "Number of results to return (max 100).",
        "examples": [25],
        "maximum": 100,
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      },
      "phone": {
        "description": "The phone number to search for the user. You must specify either 'name' or 'phone'.",
        "examples": ["+1234567890"],
        "title": "Phone",
        "type": "string"
      },
      "source": {
        "description": "If a 'field_id' is provided, this specifies the type of the field. For example, if the field is on a 'zen:user', it references a field on a user.",
        "examples": ["zen:user"],
        "title": "Source",
        "type": "string"
      }
    },
    "title": "GetUsersAutocompleteRequest",
    "type": "object"
  },
  "name": "get_users_autocomplete",
  "outputSchema": {
    "$defs": {
      "GetUsersAutocompleteResponse": {
        "description": "Response containing autocomplete user suggestions.",
        "properties": {
          "users": {
            "description": "An array of users whose name starts with the provided search term. Returns users matching either 'name' or 'phone' parameter.",
            "items": {
              "$ref": "#/$defs/ZendeskAutocompleteUser"
            },
            "title": "Users",
            "type": "array"
          }
        },
        "required": ["users"],
        "title": "GetUsersAutocompleteResponse",
        "type": "object"
      },
      "UserPhotoAttachment": {
