  "description": "Retrieve multiple Zendesk users by their numeric IDs or external IDs. Use when you have a list of user IDs (from ticket payloads, search results, etc.) and need to fetch full user details for multiple users at once. Accepts up to 100 IDs per request. Provide either `ids` or `external_ids`, not both.",
  "inputSchema": {
    "description": "Request parameters for showing multiple users by ID or external ID.",
    "properties": {
      "external_ids": {
        "description": "Comma-separated list of up to 100 external IDs to retrieve users by. Provide either ids or external_ids, not both.",
        "examples": ["abc,def"],
        "human_parameter_description": "Enter the external IDs you want to retrieve users by, separated by commas (e.g., abc,def). You can specify up to 100 external IDs at once.",
        "human_parameter_name": "External IDs",
        "title": "External Ids",
        "type": "string"
      },
      "ids": {
        "description": "Comma-separated list of up to 100 user IDs to retrieve (e.g., '1,2,3'). Provide either ids or external_ids, not both.",
        "examples": ["1,2,3"],
        "human_parameter_description": "Enter the user IDs you want to retrieve, separated by commas (e.g., 1,2,3). You can specify up to 100 IDs at once.",
        "human_parameter_name": "User IDs",
        "title": "Ids",
        "type": "string"
      },
      "include": {
        "description": "A comma-separated list of sideloads to include. Available sideloads: 'roles', 'organizations', 'fields', 'photo'. See Zendesk docs for sideloading details.",
        "examples": ["roles,organizations"],
        "human_parameter_description": "Choose related data to include with each user, such as roles or organizations. Separate multiple with commas.",
        "human_parameter_name": "Include Sideloads",
        "title": "Include",
        "type": "string"
      },
      "include_deleted": {
        "description": "If true, returns inactive or deleted users in the response.",
        "examples": [false],
        "human_parameter_description": "Enable this option to include inactive or deleted users in the results.",
        "human_parameter_name": "Include Deleted",
        "title": "Include Deleted",
        "type": "boolean"
      }
    },
    "title": "ShowManyUsersRequest",
    "type": "object"
  },
