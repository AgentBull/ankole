  "description": "Export users incrementally using cursor-based pagination. Use when you need to export all users from Zendesk in a reliable, paginated manner. The start_time parameter is required for the initial request to define the time range. Subsequent requests use the cursor returned in previous responses to fetch the next batch of records. This action is ideal for: - Full user data synchronization to external systems - Regular incremental backups of user data - Building user directories with pagination support Note: Data from the most recent minute is not included to ensure consistency.",
  "inputSchema": {
    "description": "Request parameters for incremental user export with cursor-based pagination.",
    "properties": {
      "cursor": {
        "description": "The cursor pointer to work with for all subsequent exports after the initial request. Use the cursor returned in the previous response to paginate through all records.",
        "examples": ["MTU3NjYxMzUzOS4wfHw0Njd8"],
        "human_parameter_description": "Cursor value returned in previous response for pagination.",
        "human_parameter_name": "Cursor",
        "title": "Cursor",
        "type": "string"
      },
      "per_page": {
        "description": "The number of records to return per page (max 100).",
        "examples": [25],
        "human_parameter_description": "How many user records to return per page. Maximum is 100.",
        "human_parameter_name": "Records Per Page",
        "maximum": 100,
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      },
      "start_time": {
        "description": "The time to start the incremental export from. Must be at least one minute in the past. Data isn't provided for the most recent minute. Required on the initial export request; not required on subsequent cursor-based pagination requests.",
        "examples": [1332034771],
        "human_parameter_description": "Unix timestamp to start the incremental export from. Must be at least one minute in the past.",
        "human_parameter_name": "Start Time",
        "title": "Start Time",
        "type": "integer"
      }
    },
    "title": "GetIncrementalUsersCursorRequest",
    "type": "object"
  },
