{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "List users associated with a specific Zendesk organization. Supports filtering by role, permission set, or external ID, and pagination by page number.",
  "inputSchema": {
    "description": "Request parameters for listing organization users with pagination and filtering.",
    "properties": {
      "external_id": {
        "description": "Filter by external ID. Must be unique per user under the same account.",
        "examples": ["abc"],
        "title": "External Id",
        "type": "string"
      },
      "organization_id": {
        "description": "The numeric ID of the organization to list users from. Must be a non-null positive integer.",
        "examples": [16],
        "minimum": 1,
        "title": "Organization Id",
        "type": "integer"
      },
      "page": {
        "description": "Page number for offset pagination (starts at 1). Cannot be used with cursor pagination (page[size] and page[after]/page[before]).",
        "examples": [1],
        "minimum": 1,
        "title": "Page",
        "type": "integer"
      },
      "per_page": {
        "description": "Number of users to return per page.",
        "examples": [50],
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      },
      "permission_set": {
        "description": "Filter by custom role ID. For Enterprise plan and above. Only one role ID per request.",
        "examples": [123],
        "title": "Permission Set",
        "type": "integer"
      },
      "role": {
        "description": "Filter results by a single role. Use 'end-user', 'agent', or 'admin'.",
        "enum": ["end-user", "agent", "admin"],
        "examples": ["agent"],
        "title": "Role",
        "type": "string"
      },
      "role_list": {
        "description": "Filter results by multiple roles. Provide a list of roles to include users matching any of them.",
        "examples": [["agent", "admin"]],
        "items": {
          "enum": ["end-user", "agent", "admin"],
          "type": "string"
        },
        "title": "Role List",
        "type": "array"
      },
      "sort_by": {
        "description": "The field to sort users by. Defaults to natural order if not specified.",
        "enum": ["id", "name", "created_at", "updated_at"],
        "examples": ["name"],
        "title": "Sort By",
        "type": "string"
      },
      "sort_order": {
        "description": "The sort order for results. Defaults to 'asc' if not specified.",
        "enum": ["asc", "desc"],
        "examples": ["asc"],
        "title": "Sort Order",
        "type": "string"
      }
    },
    "required": ["organization_id"],
    "title": "GetOrganizationUsersRequest",
    "type": "object"
  },
  "name": "get_organization_users",
  "outputSchema": {
