        "examples": [123456],
        "human_parameter_description": "Enter the numeric ID of the organization you want to look up in Zendesk. You can copy this from the organization's page or from a previous search or list.",
        "human_parameter_name": "Organization ID",
        "minimum": 1,
        "title": "Organization Id",
        "type": "integer"
      }
    },
    "required": ["organization_id"],
    "title": "GetZendeskOrganizationRequest",
    "type": "object"
  },
