        },
        "title": "TicketAudit",
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "$ref": "#/$defs/GetTicketAuditByIdResponse",
        "description": "Data from the action execution",
        "title": "Data"
      }
    },
    "required": ["result"],
    "type": "object"
  }
