            "type": "string"
          },
          "id": {
            "description": "Unique identifier of the event",
            "title": "Id",
            "type": "integer"
          },
          "public": {
            "description": "Whether the event is public",
            "title": "Public",
            "type": "boolean"
          },
          "subject": {
            "description": "Subject of the event (for Notification type)",
            "title": "Subject",
            "type": "string"
          },
          "type": {
            "description": "Type of the event (e.g., Comment, Notification)",
            "title": "Type",
            "type": "string"
          }
        },
        "title": "AuditEvent",
        "type": "object"
      },
      "AuditMetadata": {
        "description": "Metadata object for a ticket audit.",
        "properties": {
          "custom": {
            "$ref": "#/$defs/AuditMetadataCustom",
            "description": "Custom metadata fields",
            "title": "Custom"
          },
          "system": {
            "$ref": "#/$defs/AuditMetadataSystem",
            "description": "System-generated metadata",
            "title": "System"
          }
        },
        "title": "AuditMetadata",
        "type": "object"
      },
      "AuditMetadataCustom": {
        "description": "Custom metadata for an audit.",
        "properties": {
          "time_spent": {
            "description": "Time spent on the ticket (e.g., '3m22s')",
            "title": "Time Spent",
            "type": "string"
          }
        },
        "title": "AuditMetadataCustom",
        "type": "object"
      },
      "AuditMetadataSystem": {
        "description": "System metadata for an audit.",
        "properties": {
          "ip_address": {
            "description": "IP address of the client",
            "title": "Ip Address",
            "type": "string"
          }
        },
        "title": "AuditMetadataSystem",
        "type": "object"
      },
      "AuditViaChannel": {
        "description": "Via channel object.",
        "properties": {
          "channel": {
            "description": "How the audit was created (e.g., web, email, api)",
            "title": "Channel",
            "type": "string"
          },
          "source": {
            "additionalProperties": true,
            "description": "Additional source information",
            "title": "Source",
            "type": "object"
          }
        },
        "title": "AuditViaChannel",
        "type": "object"
      },
      "GetTicketAuditByIdResponse": {
        "description": "Response containing a single ticket audit.",
        "properties": {
          "audit": {
            "$ref": "#/$defs/TicketAudit",
