{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "Retrieve a specific Zendesk ticket audit by ticket ID and audit ID. Returns its events and selected audit details and metadata.",
  "inputSchema": {
    "description": "Request parameters for retrieving a specific ticket audit by ID.",
    "properties": {
      "ticket_audit_id": {
        "description": "The ID of the ticket audit",
        "examples": [26943293434908],
        "human_parameter_description": "The numeric ID of the specific audit record you want to view.",
        "human_parameter_name": "Audit ID",
        "minimum": 1,
        "title": "Ticket Audit Id",
        "type": "integer"
      },
      "ticket_id": {
        "description": "The ID of the ticket",
        "examples": [123456],
        "human_parameter_description": "The numeric ID of the Zendesk ticket containing the audit you want to retrieve.",
        "human_parameter_name": "Ticket ID",
        "minimum": 1,
        "title": "Ticket Id",
        "type": "integer"
      }
    },
    "required": ["ticket_id", "ticket_audit_id"],
    "title": "GetTicketAuditByIdRequest",
    "type": "object"
  },
  "name": "get_ticket_audit_by_id",
