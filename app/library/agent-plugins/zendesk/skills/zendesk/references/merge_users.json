  "description": "Merges two Zendesk end users together. The user specified in the path parameter (user_id) is the primary user (target) that will be kept. The user specified in the request body (id) is the source user that will be deleted and its data transferred to the primary user. Use when you need to consolidate duplicate end-user accounts in Zendesk. This action is irreversible — the source user and all their associated data (tickets, comments, etc.) will be merged into the primary user and the source user cannot be recovered.",
  "inputSchema": {
    "description": "Request model for merging two Zendesk end users.",
    "properties": {
      "user": {
        "additionalProperties": false,
        "description": "User object containing the ID of the user to merge from. The 'id' field is mandatory - the source user will be deleted. The 'name' field is optional to rename the primary user.",
        "properties": {
          "id": {
            "description": "The ID of the user to merge from (source user that will be deleted)",
            "examples": [26924495299996],
            "human_parameter_description": "The ID of the user to merge from (source user that will be deleted)",
            "human_parameter_name": "Source User ID",
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "description": "New name for the primary user after merge (optional)",
            "examples": ["Merged User"],
            "human_parameter_description": "Optional new name for the primary user after merge",
            "human_parameter_name": "Name",
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["id"],
        "title": "User",
        "type": "object"
      },
      "user_id": {
        "description": "The numeric ID of the primary user (target) to merge another user into",
        "examples": [26924294027548],
        "human_parameter_description": "The ID of the primary user to merge into",
        "human_parameter_name": "User ID",
        "title": "User Id",
        "type": "integer"
      }
    },
    "required": ["user_id", "user"],
    "title": "MergeUsersRequest",
    "type": "object"
  },
