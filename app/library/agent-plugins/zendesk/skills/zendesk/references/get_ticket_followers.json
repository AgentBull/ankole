        "title": "Page",
        "type": "integer"
      },
      "per_page": {
        "description": "Number of followers per page (max 100).",
        "examples": [25],
        "maximum": 100,
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      },
      "ticket_id": {
