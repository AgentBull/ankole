            "title": "Group"
          },
          "sort": {
            "$ref": "#/$defs/ViewExecutionSort",
            "description": "Sort configuration",
            "title": "Sort"
          }
        },
        "title": "ViewExecution",
        "type": "object"
      },
      "ViewExecutionGroup": {
        "description": "Grouping configuration for view execution.",
        "properties": {
          "id": {
            "description": "Field ID to group by",
            "title": "Id",
            "type": "string"
          },
          "order": {
            "description": "Sort order",
            "title": "Order",
            "type": "string"
          },
          "title": {
            "description": "Display title",
            "title": "Title",
            "type": "string"
          }
        },
        "title": "ViewExecutionGroup",
        "type": "object"
      },
      "ViewExecutionSort": {
        "description": "Sort configuration for view execution.",
        "properties": {
          "id": {
            "description": "Field ID to sort by",
            "title": "Id",
            "type": "string"
          },
          "order": {
            "description": "Sort order",
            "title": "Order",
            "type": "string"
          },
          "title": {
            "description": "Display title",
            "title": "Title",
            "type": "string"
          }
        },
        "title": "ViewExecutionSort",
        "type": "object"
      },
      "ViewRestriction": {
        "description": "Restriction settings for view access.",
        "properties": {
          "id": {
            "description": "Restriction ID",
            "title": "Id",
            "type": "integer"
          },
          "type": {
            "description": "Type of restriction (e.g., User)",
            "title": "Type",
            "type": "string"
          }
        },
        "title": "ViewRestriction",
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "$ref": "#/$defs/GetViewsCompactResponse",
        "description": "Data from the action execution",
        "title": "Data"
      }
    },
    "required": ["result"],
    "type": "object"
  }
