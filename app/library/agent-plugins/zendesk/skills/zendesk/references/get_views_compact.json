            },
            "title": "All",
            "type": "array"
          },
          "any": {
            "description": "Conditions where any one must be true for the view to match",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Any",
            "type": "array"
          }
        },
        "title": "ViewCondition",
        "type": "object"
      },
