            "title": "Execution"
          },
          "id": {
            "description": "Unique view ID",
            "title": "Id",
            "type": "integer"
          },
          "position": {
            "description": "Position in the view order",
            "title": "Position",
            "type": "integer"
          },
          "restriction": {
            "$ref": "#/$defs/ViewRestriction",
            "description": "Access restrictions for the view",
            "title": "Restriction"
          },
          "title": {
            "description": "View title",
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "description": "Timestamp when the view was last updated",
            "title": "Updated At",
            "type": "string"
          }
        },
        "title": "ViewCompact",
        "type": "object"
      },
      "ViewCondition": {
        "description": "Condition object for view rules.",
