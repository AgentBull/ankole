        "properties": {
          "count": {
            "description": "Total number of views",
            "title": "Count",
            "type": "integer"
          },
          "next_page": {
            "description": "URL for next page of results",
            "title": "Next Page",
            "type": "string"
          },
          "previous_page": {
            "description": "URL for previous page of results",
            "title": "Previous Page",
            "type": "string"
          },
          "views": {
            "description": "List of views in compact format returned by the API",
            "items": {
              "$ref": "#/$defs/ViewCompact"
            },
            "title": "Views",
            "type": "array"
          }
        },
        "required": ["views"],
        "title": "GetViewsCompactResponse",
        "type": "object"
      },
      "ViewColumn": {
        "description": "Column definition for view display.",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Column identifier",
            "title": "Id"
          },
          "title": {
            "description": "Column title",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "Column type",
            "title": "Type",
            "type": "string"
          },
          "url": {
            "description": "API URL for the column",
            "title": "Url",
            "type": "string"
          }
        },
        "title": "ViewColumn",
        "type": "object"
      },
      "ViewCompact": {
        "description": "Compact view object with essential fields only.",
        "properties": {
          "active": {
            "description": "Whether the view is active",
            "title": "Active",
            "type": "boolean"
          },
          "conditions": {
            "$ref": "#/$defs/ViewCondition",
            "description": "Conditions that define when the view applies",
            "title": "Conditions"
          },
          "created_at": {
            "description": "Timestamp when the view was created",
            "title": "Created At",
            "type": "string"
          },
          "default": {
            "description": "Whether the view is a default view",
            "title": "Default",
            "type": "boolean"
          },
          "description": {
            "description": "View description",
            "title": "Description",
            "type": "string"
          },
          "execution": {
