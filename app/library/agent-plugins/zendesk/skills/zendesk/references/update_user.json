  "description": "Update selected core fields on one Zendesk user by numeric user ID.",
  "inputSchema": {
    "description": "Request to update one Zendesk user.",
    "properties": {
      "user": {
        "additionalProperties": false,
        "description": "Core user fields to update. At least one field is required.",
        "properties": {
          "active": {
            "description": "Whether the user is active",
            "examples": [true],
            "human_parameter_description": "Set to false to deactivate the user.",
            "human_parameter_name": "Active",
            "title": "Active",
            "type": "boolean"
          },
          "alias": {
            "description": "Alias displayed to end users",
            "human_parameter_description": "Optional alias shown to end users.",
            "human_parameter_name": "Alias",
            "title": "Alias",
            "type": "string"
          },
          "custom_role_id": {
            "description": "Agent-only: ID of a custom agent role",
            "examples": [123],
            "human_parameter_description": "Custom agent role ID when role is 'agent'.",
            "human_parameter_name": "Custom Role ID",
            "title": "Custom Role Id",
            "type": "integer"
          },
          "default_group_id": {
            "description": "ID of the user's default group",
            "examples": [100],
            "human_parameter_description": "Numeric ID of the default group.",
            "human_parameter_name": "Default Group ID",
            "title": "Default Group Id",
            "type": "integer"
          },
          "details": {
            "description": "Free-form details about the user",
            "human_parameter_description": "Optional free-form details.",
            "human_parameter_name": "Details",
            "title": "Details",
            "type": "string"
          },
          "email": {
            "description": "Primary email address of the user",
            "examples": ["john.doe@example.com"],
            "human_parameter_description": "Email address to set on the users.",
            "human_parameter_name": "Email",
            "title": "Email",
            "type": "string"
          },
          "locale": {
            "description": "User's locale (BCP-47 format)",
            "examples": ["en-US"],
            "human_parameter_description": "Locale tag for the user (e.g., en-US).",
            "human_parameter_name": "Locale",
            "title": "Locale",
            "type": "string"
          },
          "locale_id": {
            "description": "User's locale ID",
            "examples": [1],
            "human_parameter_description": "Numeric locale ID.",
            "human_parameter_name": "Locale ID",
            "title": "Locale Id",
            "type": "integer"
          },
          "moderator": {
            "description": "Whether the user is a moderator",
            "examples": [false],
            "human_parameter_description": "Set to true to make the user a moderator.",
            "human_parameter_name": "Moderator",
            "title": "Moderator",
            "type": "boolean"
          },
          "name": {
            "description": "Full name for the user",
            "examples": ["John Doe"],
            "human_parameter_description": "Full name to set on the users.",
            "human_parameter_name": "Name",
            "title": "Name",
            "type": "string"
          },
          "notes": {
            "description": "Notes about the user",
            "human_parameter_description": "Optional notes about the user.",
            "human_parameter_name": "Notes",
            "title": "Notes",
            "type": "string"
          },
          "organization_id": {
            "description": "ID of the user's default organization",
            "examples": [12345],
            "human_parameter_description": "Numeric ID of the default organization.",
            "human_parameter_name": "Organization ID",
            "title": "Organization Id",
            "type": "integer"
          },
          "phone": {
            "description": "Phone number of the user in E.164 format",
            "examples": ["+14155551234"],
            "human_parameter_description": "Phone number in international format.",
            "human_parameter_name": "Phone",
            "title": "Phone",
            "type": "string"
          },
          "role": {
            "description": "User role. Allowed values: end-user, agent, admin.",
            "enum": ["end-user", "agent", "admin"],
            "examples": ["agent"],
            "human_parameter_description": "Role to assign: end-user, agent, or admin.",
            "human_parameter_name": "Role",
            "title": "Role",
            "type": "string"
          },
          "signature": {
            "description": "Agent or admin's signature",
            "human_parameter_description": "Agent or admin signature.",
            "human_parameter_name": "Signature",
            "title": "Signature",
            "type": "string"
          },
          "suspended": {
            "description": "Whether the user is suspended",
            "examples": [false],
            "human_parameter_description": "Set to true to suspend the user.",
            "human_parameter_name": "Suspended",
            "title": "Suspended",
            "type": "boolean"
          },
          "tags": {
            "description": "Array of tags for the user",
            "examples": [["vip", "beta"]],
            "human_parameter_description": "Tags to assign to the users.",
            "human_parameter_name": "Tags",
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "ticket_restriction": {
            "description": "User's ticket visibility restriction",
            "enum": ["organization", "groups", "assigned", "requested"],
            "human_parameter_description": "Ticket access restriction setting.",
            "human_parameter_name": "Ticket Restriction",
            "title": "Ticket Restriction",
            "type": "string"
          },
          "time_zone": {
            "description": "User's time zone",
            "examples": ["Pacific Time (US & Canada)"],
            "human_parameter_description": "User's time zone.",
            "human_parameter_name": "Time Zone",
            "title": "Time Zone",
            "type": "string"
          },
          "user_fields": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Key-value map of custom user fields",
            "human_parameter_description": "Custom user field values.",
            "human_parameter_name": "User Fields",
            "title": "User Fields",
            "type": "object"
          },
          "verified": {
            "description": "Whether the user's email has been verified",
            "examples": [true],
            "human_parameter_description": "Set to true if the user's email is verified.",
            "human_parameter_name": "Verified",
            "title": "Verified",
            "type": "boolean"
          }
        },
        "title": "User",
        "type": "object"
      },
      "user_id": {
        "description": "ID of the Zendesk user to update, as a string.",
        "examples": ["123456789"],
        "title": "User Id",
        "type": "string"
      }
    },
    "required": ["user_id", "user"],
    "title": "UpdateUserRequest",
    "type": "object"
  },
