  "description": "List a page of users belonging to a specific Zendesk group, with optional filtering by user role, permission set, or external ID. This is a read-only operation.",
  "inputSchema": {
    "description": "Request parameters for listing users in a Zendesk group.",
    "properties": {
      "external_id": {
        "description": "Filter by external ID. Must be unique per user under the same account.",
        "examples": ["abc"],
        "title": "External Id",
        "type": "string"
      },
      "group_id": {
        "description": "The numeric ID of the group. Users belonging to this group will be returned.",
        "examples": [26923118304412],
        "title": "Group Id",
        "type": "integer"
      },
      "page": {
        "description": "Pagination parameter. Supports both traditional offset and cursor-based pagination: traditional uses `?page=2` (integer page number); cursor uses `?page[size]=50&page[after]=cursor` (deepObject with size, after, before). These are mutually exclusive.",
        "examples": ["2"],
        "title": "Page",
        "type": "string"
      },
      "per_page": {
        "description": "Number of records to return per page. Maximum is 100 records per page for the group users endpoint.",
        "examples": [50],
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      },
      "permission_set": {
        "description": "Filter by custom role ID (Enterprise plan only). Only one role ID per request.",
        "examples": [123],
        "title": "Permission Set",
        "type": "integer"
      },
      "role": {
        "description": "Filter results by a single role. Use 'end-user', 'agent', or 'admin'.",
        "enum": ["end-user", "agent", "admin"],
        "examples": ["agent"],
        "title": "Role",
        "type": "string"
      },
      "role_list": {
        "description": "Filter results by multiple roles. Provide a list of roles to include users matching any of them.",
        "examples": [["agent", "admin"]],
        "items": {
          "type": "string"
        },
        "title": "Role List",
        "type": "array"
      }
    },
    "required": ["group_id"],
    "title": "GetGroupUsersRequest",
    "type": "object"
  },
