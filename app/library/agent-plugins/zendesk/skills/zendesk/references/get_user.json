        "description": "The numeric ID of the Zendesk user to retrieve. This is the user ID found in ticket payloads (requester_id, submitter_id, assignee_id, author_id).",
        "examples": [123456789],
        "title": "User Id",
        "type": "integer"
      }
    },
    "required": ["user_id"],
    "title": "GetUserRequest",
    "type": "object"
  },
