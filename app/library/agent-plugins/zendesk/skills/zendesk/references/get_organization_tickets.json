        "human_parameter_description": "The unique ID of the Zendesk organization. Find this in the organization's URL or via ZENDESK_GET_ALL_ZENDESK_ORGANIZATIONS.",
        "human_parameter_name": "Organization ID",
        "title": "Organization Id",
        "type": "integer"
      },
      "page": {
        "description": "Page number for pagination (1-100). Limited to first 100 pages or 10,000 records total.",
