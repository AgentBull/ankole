              "properties": {
                "type": {
                  "description": "Identity type (e.g., 'email', 'phone')",
                  "examples": ["email"],
                  "title": "Type",
                  "type": "string"
                },
                "value": {
                  "description": "Identity value corresponding to the type",
                  "examples": ["jdoe@example.com"],
                  "title": "Value",
                  "type": "string"
                }
              },
              "required": ["type", "value"],
              "title": "Identity",
              "type": "object"
            },
            "title": "Identities",
            "type": "array"
          },
          "locale": {
            "description": "BCP-47 locale; overrides locale_id",
            "examples": ["en-US"],
            "human_parameter_description": "Optional locale tag for the user",
            "human_parameter_name": "Locale",
            "title": "Locale",
            "type": "string"
          },
          "locale_id": {
            "description": "Language locale ID for user",
