            "title": "Locale Id",
            "type": "integer"
          },
          "name": {
            "description": "Full name for the new user",
            "examples": ["Jane Doe"],
            "human_parameter_description": "Full name of the user to create in Zendesk",
            "human_parameter_name": "Name",
            "title": "Name",
            "type": "string"
          },
          "organization_id": {
            "description": "ID of default organization",
            "examples": [123456],
