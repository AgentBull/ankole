            "human_parameter_name": "Organization ID",
            "title": "Organization Id",
            "type": "integer"
          },
          "phone": {
            "description": "Direct line phone number in E.164 format",
            "examples": ["+14155551234"],
            "human_parameter_description": "Optional direct phone number in international format",
            "human_parameter_name": "Phone",
            "title": "Phone",
            "type": "string"
          },
          "role": {
            "description": "User role; defaults to 'end-user' if omitted",
            "enum": ["end-user", "agent", "admin"],
            "examples": ["agent"],
            "human_parameter_description": "Role for the user: end-user, agent, or admin",
            "human_parameter_name": "Role",
            "title": "Role",
            "type": "string"
          },
          "signature": {
            "description": "Agent/Admin signature",
            "human_parameter_description": "Optional agent/admin signature text",
            "human_parameter_name": "Signature",
            "title": "Signature",
            "type": "string"
          },
          "suspended": {
            "description": "True to suspend the account",
            "examples": [false],
            "human_parameter_description": "Set to true to suspend this user",
            "human_parameter_name": "Suspended",
            "title": "Suspended",
            "type": "boolean"
          },
          "tags": {
            "description": "List of user tags",
            "examples": [["support", "beta-user"]],
            "human_parameter_description": "Optional tags to assign to the user",
            "human_parameter_name": "Tags",
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "ticket_restriction": {
            "description": "Ticket access restriction; 'groups'/'assigned' only valid for agents",
            "enum": ["organization", "groups", "assigned", "requested"],
            "human_parameter_description": "Optional ticket access restriction setting",
            "human_parameter_name": "Ticket Restriction",
            "title": "Ticket Restriction",
            "type": "string"
          },
          "time_zone": {
            "description": "User's time zone",
            "examples": ["Pacific Time (US & Canada)"],
            "human_parameter_description": "Optional user time zone",
            "human_parameter_name": "Time Zone",
            "title": "Time Zone",
            "type": "string"
          },
          "user_fields": {
            "additionalProperties": true,
            "description": "Key-value map of custom user fields",
            "human_parameter_description": "Optional custom user field values",
            "human_parameter_name": "User Fields",
            "title": "User Fields",
            "type": "object"
          }
        },
        "required": ["name"],
        "title": "User",
        "type": "object"
      }
    },
    "required": ["user"],
    "title": "CreateZendeskUserRequest",
    "type": "object"
  },
