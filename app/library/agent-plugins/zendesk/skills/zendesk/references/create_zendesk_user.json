  "description": "Tool to create a new user in Zendesk. Search for existing users first to avoid duplicate accounts with the same email. Use when you need to onboard a user with specific details.",
  "inputSchema": {
    "description": "Request model for creating a new Zendesk user.",
    "properties": {
      "skip_verify_email": {
        "description": "If true, do not send a verification email upon creation. Passed as a URL query parameter.",
        "examples": [true],
        "human_parameter_description": "If true, skip sending verification email to the user",
        "human_parameter_name": "Skip Verify Email",
        "title": "Skip Verify Email",
        "type": "boolean"
      },
      "user": {
        "additionalProperties": false,
        "description": "User object containing all attributes to create `name` is mandatory; omitting it causes a validation error. `role` must be one of: 'end-user', 'agent', or 'admin'. `organization_id` must be a numeric ID of an existing organization — not a name string. Only include fields supported by the Zendesk user schema; unsupported or incorrectly typed fields trigger validation errors.",
        "properties": {
          "agent_brand_ids": {
            "description": "Brand IDs to assign to an agent",
            "examples": [[1001, 1002]],
            "human_parameter_description": "Brand IDs to associate with an agent",
            "human_parameter_name": "Agent Brand IDs",
            "items": {
              "type": "integer"
            },
            "title": "Agent Brand Ids",
            "type": "array"
          },
          "alias": {
            "description": "Alias displayed to end users",
            "human_parameter_description": "Optional alias shown to end users",
            "human_parameter_name": "Alias",
            "title": "Alias",
            "type": "string"
          },
          "custom_role_id": {
            "description": "Agent-only: ID of a custom agent role",
            "examples": [987654],
            "human_parameter_description": "Custom agent role ID when role is 'agent'",
            "human_parameter_name": "Custom Role ID",
            "title": "Custom Role Id",
            "type": "integer"
          },
          "default_group_id": {
            "description": "Default group ID for the user",
            "examples": [200],
            "human_parameter_description": "Optional default group for the user",
            "human_parameter_name": "Default Group ID",
            "title": "Default Group Id",
            "type": "integer"
          },
          "details": {
            "description": "Free-form details about the user",
            "human_parameter_description": "Optional free-form user details",
            "human_parameter_name": "Details",
            "title": "Details",
            "type": "string"
          },
          "email": {
            "description": "Primary email address",
            "examples": ["jane@example.com"],
            "human_parameter_description": "Primary email address for the user (optional)",
            "human_parameter_name": "Email",
            "title": "Email",
            "type": "string"
          },
          "external_id": {
            "description": "External system ID (case-insensitive)",
            "human_parameter_description": "Optional unique identifier from another system",
            "human_parameter_name": "External ID",
            "title": "External Id",
            "type": "string"
          },
          "identities": {
            "description": "List of additional identities (type and value)",
            "human_parameter_description": "Additional user identities to create",
            "human_parameter_name": "Identities",
