  "description": "Tool to list/enumerate Zendesk users via the Users API. Use when you need to export or iterate through the user directory without a specific name/email filter. Supports both cursor and offset pagination.",
  "inputSchema": {
    "description": "Request parameters for listing Zendesk users with pagination and filtering.",
    "properties": {
      "external_id": {
        "description": "Filter by external ID. Must be unique per user under the same account.",
        "examples": ["abc"],
        "title": "External Id",
        "type": "string"
      },
      "page": {
        "description": "Page number for offset pagination (starts at 1). Cannot be used with cursor pagination.",
        "examples": [1],
        "minimum": 1,
        "title": "Page",
        "type": "integer"
      },
      "page_after": {
        "description": "Cursor for fetching next page in cursor pagination. Use with page_size. Cannot be used with offset pagination.",
        "examples": ["<cursor_token_from_previous_response>"],
        "title": "Page After",
        "type": "string"
      },
      "page_size": {
        "description": "Number of users per page for cursor pagination (max 100). Use with page_after. Cannot be used with offset pagination.",
        "examples": [25],
        "maximum": 100,
        "minimum": 1,
        "title": "Page Size",
        "type": "integer"
      },
      "per_page": {
        "description": "Number of users per page for offset pagination (max 100). Cannot be used with cursor pagination.",
        "examples": [25],
        "maximum": 100,
        "minimum": 1,
        "title": "Per Page",
        "type": "integer"
      },
      "permission_set": {
        "description": "Filter by custom role ID (Enterprise plan only). Only one role ID per request.",
        "examples": [123],
        "title": "Permission Set",
        "type": "integer"
      },
      "role": {
        "description": "Filter results by a single role. Use 'end-user', 'agent', or 'admin'.",
        "enum": ["end-user", "agent", "admin"],
        "examples": ["agent"],
        "title": "Role",
        "type": "string"
      },
      "role_list": {
        "description": "Filter results by multiple roles. Provide a list of roles to include users matching any of them.",
        "examples": [["agent", "admin"]],
        "items": {
          "enum": ["end-user", "agent", "admin"],
          "type": "string"
        },
        "title": "Role List",
        "type": "array"
      }
    },
    "title": "ListZendeskUsersRequest",
    "type": "object"
  },
