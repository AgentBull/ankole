{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "List a page of workspaces in a Typeform account, optionally searching by name. Results include IDs and names and may include form counts and members.",
  "inputSchema": {
    "properties": {
      "page": {
        "description": "Page number for pagination. Default is 1.",
        "examples": [1, 2],
        "minimum": 1,
        "title": "Page",
        "type": "integer"
      },
      "page_size": {
        "description": "Number of items per page. Default is 10, maximum is 200.",
        "examples": [10, 50, 200],
        "maximum": 200,
        "minimum": 1,
        "title": "Page Size",
        "type": "integer"
      },
      "search": {
        "description": "Search term to filter workspaces by name. Only workspaces matching this search term will be returned.",
        "examples": ["Marketing", "Sales Team"],
        "title": "Search",
        "type": "string"
      }
    },
    "title": "TypeformListWorkspacesRequest",
    "type": "object"
  },
  "name": "list_workspaces",
  "outputSchema": {
    "$defs": {
      "TypeformListWorkspacesResponse": {
        "properties": {
          "workspaces": {
            "description": "List of workspaces in the Typeform account",
            "items": {
              "$ref": "#/$defs/WorkspaceItem"
            },
            "title": "Workspaces",
            "type": "array"
          }
        },
        "required": ["workspaces"],
        "title": "TypeformListWorkspacesResponse",
        "type": "object"
      },
      "WorkspaceFormsInfo": {
        "properties": {
          "count": {
            "description": "Number of forms in this workspace",
            "title": "Count",
            "type": "integer"
          }
        },
        "title": "WorkspaceFormsInfo",
        "type": "object"
      },
      "WorkspaceItem": {
        "properties": {
          "forms": {
            "$ref": "#/$defs/WorkspaceFormsInfo",
            "description": "Information about forms in this workspace",
            "title": "Forms"
          },
          "href": {
            "description": "API URL for accessing this workspace",
            "title": "Href",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier for the workspace",
            "title": "Id",
            "type": "string"
          },
          "members": {
            "description": "List of members in this workspace",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Members",
            "type": "array"
          },
          "name": {
            "description": "Name of the workspace",
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["id", "name"],
        "title": "WorkspaceItem",
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "$ref": "#/$defs/TypeformListWorkspacesResponse",
        "description": "Data from the action execution",
        "title": "Data"
      }
    },
    "required": ["result"],
    "type": "object"
  }
}
