{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Tool to update a Stripe Checkout Session dynamically. Use when you need to modify customer information, line items, or shipping options on an existing checkout session. Line item updates require retransmitting the entire array.",
  "inputSchema": {
    "properties": {
      "collected_information": {
        "additionalProperties": false,
        "description": "Customer data collected within the session. Only applies to embedded or custom checkout sessions.",
        "properties": {
          "shipping_details": {
            "additionalProperties": false,
            "description": "Shipping details collected from the customer. Only applicable for embedded or custom checkout sessions.",
            "properties": {
              "address": {
                "additionalProperties": false,
                "description": "Shipping address for the customer.",
                "properties": {
                  "city": {
                    "description": "City, town, district, or village.",
                    "examples": ["San Francisco", "New York"],
                    "title": "City",
                    "type": "string"
                  },
                  "country": {
                    "description": "Two-letter ISO 3166-1 country code.",
                    "examples": ["US", "CA", "GB"],
                    "title": "Country",
                    "type": "string"
                  },
                  "line1": {
                    "description": "Street, PO Box, or company name.",
                    "examples": ["123 Main St", "PO Box 456"],
                    "title": "Line1",
                    "type": "string"
                  },
                  "line2": {
                    "description": "Apartment, suite, unit, or building number.",
                    "examples": ["Apt 4B", "Suite 200"],
                    "title": "Line2",
                    "type": "string"
                  },
                  "postal_code": {
                    "description": "ZIP or postal code.",
                    "examples": ["94102", "10001"],
                    "title": "Postal Code",
                    "type": "string"
                  },
                  "state": {
                    "description": "State, county, province, or region per ISO 3166-2.",
                    "examples": ["CA", "NY"],
                    "title": "State",
                    "type": "string"
                  }
                },
                "required": ["country", "line1"],
                "title": "Address",
                "type": "object"
              },
              "name": {
                "description": "Customer name (maximum 255 characters).",
                "examples": ["John Doe", "Jane Smith"],
                "title": "Name",
                "type": "string"
              }
            },
            "required": ["address", "name"],
            "title": "ShippingDetails",
            "type": "object"
          }
        },
        "title": "CollectedInformation",
        "type": "object"
      },
      "line_items": {
        "description": "List of purchased items. Must retransmit the entire array when updating. Items can be retained (by ID), updated (ID + new values), added (price/price_data), or removed (omit ID).",
        "items": {
          "properties": {
            "adjustable_quantity": {
              "additionalProperties": false,
              "description": "Settings to allow customer to adjust the quantity.",
              "properties": {
                "enabled": {
                  "description": "Whether customer can adjust the quantity.",
                  "title": "Enabled",
                  "type": "boolean"
                },
                "maximum": {
                  "description": "Maximum purchasable quantity (default 99, max 999999).",
                  "examples": [10, 100],
                  "title": "Maximum",
                  "type": "integer"
                },
                "minimum": {
                  "description": "Minimum quantity required (default 0).",
                  "examples": [1, 5],
                  "title": "Minimum",
                  "type": "integer"
                }
              },
              "required": ["enabled"],
              "title": "LineItemAdjustableQuantity",
              "type": "object"
            },
            "id": {
              "description": "Existing line item ID for updates or retention. Required to update or retain an existing line item.",
              "title": "Id",
              "type": "string"
            },
            "metadata": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Key-value pairs for storing structured information.",
              "title": "Metadata",
              "type": "object"
            },
            "price": {
              "description": "Price ID for existing prices. Required if price_data is not provided.",
              "title": "Price",
              "type": "string"
            },
            "price_data": {
              "additionalProperties": false,
              "description": "Inline price data. Required if price is not provided.",
              "properties": {
                "currency": {
                  "description": "Three-letter ISO currency code (lowercase).",
                  "examples": ["usd", "eur", "gbp"],
                  "title": "Currency",
                  "type": "string"
                },
                "product": {
                  "description": "Product ID for existing products.",
                  "title": "Product",
                  "type": "string"
                },
                "product_data": {
                  "additionalProperties": false,
                  "description": "Product data for creating a new product inline.",
                  "properties": {
                    "description": {
                      "description": "Customer-facing description of the product.",
                      "title": "Description",
                      "type": "string"
                    },
                    "images": {
                      "description": "Up to 8 product image URLs.",
                      "items": {
                        "type": "string"
                      },
                      "title": "Images",
                      "type": "array"
                    },
                    "metadata": {
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Key-value pairs for additional product information.",
                      "title": "Metadata",
                      "type": "object"
                    },
                    "name": {
                      "description": "Displayable product name.",
                      "examples": ["Premium Widget", "Standard Service"],
                      "title": "Name",
                      "type": "string"
                    },
                    "tax_code": {
                      "description": "Tax category ID for this product.",
                      "title": "Tax Code",
                      "type": "string"
                    },
                    "unit_label": {
                      "description": "Units label (maximum 12 characters).",
                      "examples": ["item", "hour", "session"],
                      "title": "Unit Label",
                      "type": "string"
                    }
                  },
                  "required": ["name"],
                  "title": "LineItemPriceDataProductData",
                  "type": "object"
                },
                "recurring": {
                  "additionalProperties": false,
                  "description": "Recurring billing settings for subscriptions.",
                  "properties": {
                    "interval": {
                      "description": "Billing frequency: 'day', 'week', 'month', or 'year'.",
                      "examples": ["month", "year"],
                      "title": "Interval",
                      "type": "string"
                    },
                    "interval_count": {
                      "description": "Number of intervals between billings (maximum 3 years).",
                      "examples": [1, 3, 6, 12],
                      "title": "Interval Count",
                      "type": "integer"
                    }
                  },
                  "required": ["interval"],
                  "title": "LineItemPriceDataRecurring",
                  "type": "object"
                },
                "tax_behavior": {
                  "description": "Tax behavior: 'inclusive', 'exclusive', or 'unspecified'.",
                  "examples": ["inclusive", "exclusive"],
                  "title": "Tax Behavior",
                  "type": "string"
                },
                "unit_amount": {
                  "description": "Charge amount in smallest currency unit (e.g., cents).",
                  "examples": [1000, 2500],
                  "title": "Unit Amount",
                  "type": "integer"
                },
                "unit_amount_decimal": {
                  "description": "Charge amount in decimal cents (up to 12 decimal places).",
                  "title": "Unit Amount Decimal",
                  "type": "string"
                }
              },
              "required": ["currency"],
              "title": "LineItemPriceData",
              "type": "object"
            },
            "quantity": {
              "description": "Quantity of items being purchased.",
              "examples": [1, 2, 5],
              "title": "Quantity",
              "type": "integer"
            },
            "tax_rates": {
              "description": "List of applicable tax rate IDs.",
              "items": {
                "type": "string"
              },
              "title": "Tax Rates",
              "type": "array"
            }
          },
          "title": "LineItem",
          "type": "object"
        },
        "title": "Line Items",
        "type": "array"
      },
      "metadata": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Key-value pairs for storing additional structured information about the checkout session.",
        "title": "Metadata",
        "type": "object"
      },
      "session": {
        "description": "The ID of the Checkout Session to update.",
        "examples": ["cs_test_your_checkout_session_id_here"],
        "title": "Session",
        "type": "string"
      },
      "shipping_options": {
        "description": "Shipping rate options (maximum 5).",
        "items": {
          "properties": {
            "shipping_rate": {
              "description": "Shipping Rate ID. Required if shipping_rate_data is not provided.",
              "title": "Shipping Rate",
              "type": "string"
            },
            "shipping_rate_data": {
              "additionalProperties": false,
              "description": "Inline shipping rate data. Required if shipping_rate is not provided.",
              "properties": {
                "delivery_estimate": {
                  "additionalProperties": false,
                  "description": "Estimated delivery time range.",
                  "properties": {
                    "maximum": {
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          }
                        ]
                      },
                      "description": "Maximum delivery estimate with 'unit' and 'value'.",
                      "title": "Maximum",
                      "type": "object"
                    },
                    "minimum": {
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          }
                        ]
                      },
                      "description": "Minimum delivery estimate with 'unit' (business_day/day/hour/month/week) and 'value' (integer > 0).",
                      "title": "Minimum",
                      "type": "object"
                    }
                  },
                  "title": "DeliveryEstimate",
                  "type": "object"
                },
                "display_name": {
                  "description": "Customer-facing name (maximum 100 characters).",
                  "examples": ["Standard Shipping", "Express Delivery"],
                  "title": "Display Name",
                  "type": "string"
                },
                "fixed_amount": {
                  "additionalProperties": false,
                  "description": "Fixed amount for shipping.",
                  "properties": {
                    "amount": {
                      "description": "Shipping charge in smallest currency unit (e.g., cents).",
                      "examples": [500, 1000],
                      "title": "Amount",
                      "type": "integer"
                    },
                    "currency": {
                      "description": "Three-letter ISO currency code.",
                      "examples": ["usd", "eur"],
                      "title": "Currency",
                      "type": "string"
                    },
                    "currency_options": {
                      "additionalProperties": {
                        "additionalProperties": {
                          "type": "integer"
                        },
                        "type": "object"
                      },
                      "description": "Per-currency amount overrides.",
                      "title": "Currency Options",
                      "type": "object"
                    }
                  },
                  "required": ["amount", "currency"],
                  "title": "ShippingRateDataFixedAmount",
                  "type": "object"
                },
                "metadata": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Key-value pairs for additional information.",
                  "title": "Metadata",
                  "type": "object"
                },
                "tax_behavior": {
                  "description": "Tax behavior: 'inclusive', 'exclusive', or 'unspecified'.",
                  "examples": ["inclusive", "exclusive"],
                  "title": "Tax Behavior",
                  "type": "string"
                },
                "tax_code": {
                  "description": "Tax category ID for shipping.",
                  "title": "Tax Code",
                  "type": "string"
                },
                "type": {
                  "description": "Type of shipping rate. Must be 'fixed_amount'.",
                  "examples": ["fixed_amount"],
                  "title": "Type",
                  "type": "string"
                }
              },
              "required": ["display_name", "type"],
              "title": "ShippingRateData",
              "type": "object"
            }
          },
          "title": "ShippingOption",
          "type": "object"
        },
        "title": "Shipping Options",
        "type": "array"
      }
    },
    "required": ["session"],
    "title": "UpdateCheckoutSessionRequest",
    "type": "object"
  },
  "name": "update_checkout_session",
  "outputSchema": {
