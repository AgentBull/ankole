        "items": {
          "type": "string"
        },
        "title": "Expand",
        "type": "array"
      },
      "session": {
        "description": "The identifier of the checkout session to retrieve, typically starting with 'cs_'.",
        "examples": ["cs_test_your_session_id_here"],
        "title": "Session",
        "type": "string"
      }
    },
    "required": ["session"],
    "title": "RetrieveCheckoutSessionRequest",
    "type": "object"
  },
  "name": "retrieve_checkout_session",
