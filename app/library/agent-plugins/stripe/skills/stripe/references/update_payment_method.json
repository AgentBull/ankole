  "description": "Updates an existing PaymentMethod object in Stripe. Use when you need to modify billing details, expiration dates, or metadata for a payment method. The payment method must be attached to a customer before updates can be applied.",
  "inputSchema": {
    "description": "Request model for updating an existing payment method in Stripe.",
    "properties": {
      "allow_redisplay": {
        "description": "Controls whether the payment method displays in checkout flows. Options: always, limited, unspecified.",
        "enum": ["always", "limited", "unspecified"],
        "title": "Allow Redisplay",
        "type": "string"
      },
      "billing_details": {
        "additionalProperties": false,
        "description": "Billing information associated with the PaymentMethod.",
        "properties": {
          "address": {
            "additionalProperties": false,
            "description": "Billing address.",
            "properties": {
              "city": {
                "description": "City, district, suburb, town, or village.",
                "title": "City",
                "type": "string"
              },
              "country": {
                "description": "Two-letter country code (ISO 3166-1 alpha-2).",
                "title": "Country",
                "type": "string"
              },
              "line1": {
                "description": "Address line 1 (e.g., street, PO Box, or company name).",
                "title": "Line1",
                "type": "string"
              },
              "line2": {
                "description": "Address line 2 (e.g., apartment, suite, unit, or building).",
                "title": "Line2",
                "type": "string"
              },
              "postal_code": {
                "description": "ZIP or postal code.",
                "title": "Postal Code",
                "type": "string"
              },
              "state": {
                "description": "State, county, province, or region.",
                "title": "State",
                "type": "string"
              }
            },
            "title": "Address",
            "type": "object"
          },
          "email": {
            "description": "Email address (maximum 800 characters).",
            "examples": ["john.doe@example.com"],
            "title": "Email",
            "type": "string"
          },
          "name": {
            "description": "Full name.",
            "examples": ["John Doe"],
            "title": "Name",
            "type": "string"
          },
          "phone": {
            "description": "Billing phone number (including extension).",
            "examples": ["+15551234567"],
            "title": "Phone",
            "type": "string"
          },
          "tax_id": {
            "description": "Taxpayer identification number for LATAM-related transactions.",
            "title": "Tax Id",
            "type": "string"
          }
        },
        "title": "BillingDetails",
        "type": "object"
      },
      "card": {
        "additionalProperties": false,
        "description": "Card details for card-type payment methods.",
        "properties": {
          "exp_month": {
            "description": "Two-digit expiration month (1-12).",
            "examples": [12],
            "maximum": 12,
            "minimum": 1,
            "title": "Exp Month",
            "type": "integer"
          },
          "exp_year": {
            "description": "Four-digit expiration year.",
            "examples": [2025],
            "title": "Exp Year",
            "type": "integer"
          },
          "networks": {
            "additionalProperties": false,
