              "$ref": "#/$defs/DiscountAmount"
            },
            "title": "Discount Amounts",
            "type": "array"
          },
          "discountable": {
            "description": "Whether discounts apply to this line item.",
            "title": "Discountable",
            "type": "boolean"
          },
          "discounts": {
            "description": "Array of applied discount IDs.",
            "items": {
              "type": "string"
            },
            "title": "Discounts",
            "type": "array"
          },
          "id": {
            "description": "Unique identifier for the line item.",
            "title": "Id",
            "type": "string"
          },
          "invoice": {
            "description": "ID of the containing invoice (null for upcoming).",
            "title": "Invoice",
            "type": "string"
          },
          "invoice_item": {
            "description": "Referenced invoice item ID.",
            "title": "Invoice Item",
            "type": "string"
          },
          "livemode": {
            "description": "Live mode (true) or test mode (false).",
            "title": "Livemode",
            "type": "boolean"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Key-value pairs for structured data.",
            "title": "Metadata",
            "type": "object"
          },
          "object": {
            "description": "String representing the object's type. Always 'line_item'.",
            "title": "Object",
            "type": "string"
          },
          "period": {
            "$ref": "#/$defs/Period",
            "description": "Period covered by this line item.",
            "title": "Period"
          },
          "plan": {
            "additionalProperties": true,
            "description": "Plan information if applicable.",
            "title": "Plan",
            "type": "object"
          },
          "price": {
            "$ref": "#/$defs/Price",
            "description": "Price object with pricing details.",
            "title": "Price"
          },
          "proration": {
            "description": "Whether this line is a proration.",
            "title": "Proration",
            "type": "boolean"
          },
          "proration_details": {
            "additionalProperties": true,
            "description": "Detailed proration information.",
            "title": "Proration Details",
            "type": "object"
          },
          "quantity": {
            "description": "Number of units for subscription/proration.",
            "title": "Quantity",
            "type": "integer"
          },
          "subscription": {
            "description": "Subscription ID (null if not subscription-related).",
            "title": "Subscription",
            "type": "string"
          },
          "subscription_item": {
            "description": "Subscription item ID if applicable.",
            "title": "Subscription Item",
            "type": "string"
          },
          "tax_amounts": {
            "description": "Applied tax amounts with details per tax rate.",
            "items": {
              "$ref": "#/$defs/TaxAmount"
            },
            "title": "Tax Amounts",
            "type": "array"
          },
          "tax_rates": {
            "description": "Tax rate objects applied to line item.",
            "items": {
              "$ref": "#/$defs/TaxRate"
            },
            "title": "Tax Rates",
            "type": "array"
          },
          "type": {
            "description": "Line item type (e.g., 'invoiceitem', 'subscription').",
            "title": "Type",
            "type": "string"
          },
          "unit_amount_excluding_tax": {
            "description": "Unit amount before tax (decimal string).",
            "title": "Unit Amount Excluding Tax",
            "type": "string"
          }
        },
        "required": ["id", "object", "amount", "currency", "discountable", "livemode", "period", "proration", "type"],
        "title": "InvoiceLineItem",
        "type": "object"
      },
      "Period": {
        "properties": {
          "end": {
            "description": "Inclusive period end timestamp.",
            "title": "End",
            "type": "integer"
          },
          "start": {
            "description": "Inclusive period start timestamp.",
            "title": "Start",
            "type": "integer"
          }
        },
        "required": ["start", "end"],
        "title": "Period",
        "type": "object"
      },
      "Price": {
        "properties": {
          "active": {
            "description": "Whether the price is active.",
            "title": "Active",
            "type": "boolean"
          },
          "billing_scheme": {
            "description": "Billing scheme: per_unit or tiered.",
            "title": "Billing Scheme",
            "type": "string"
          },
          "created": {
            "description": "Time at which the object was created.",
            "title": "Created",
            "type": "integer"
          },
          "currency": {
            "description": "Three-letter ISO currency code.",
            "title": "Currency",
            "type": "string"
          },
          "custom_unit_amount": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "description": "Custom unit amount information.",
            "title": "Custom Unit Amount",
            "type": "object"
          },
          "id": {
            "description": "Unique identifier for the price.",
            "title": "Id",
            "type": "string"
          },
          "livemode": {
            "description": "True for live mode, false for test mode.",
            "title": "Livemode",
            "type": "boolean"
          },
          "lookup_key": {
            "description": "Lookup key for the price.",
            "title": "Lookup Key",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Set of key-value pairs.",
            "title": "Metadata",
            "type": "object"
          },
          "nickname": {
            "description": "Brief description of the price.",
            "title": "Nickname",
            "type": "string"
          },
          "object": {
            "description": "String representing the object's type.",
            "title": "Object",
            "type": "string"
          },
          "product": {
            "description": "Product ID this price is for.",
            "title": "Product",
            "type": "string"
          },
          "recurring": {
            "additionalProperties": true,
            "description": "Recurring pricing information.",
            "title": "Recurring",
            "type": "object"
          },
          "tax_behavior": {
            "description": "Tax behavior: inclusive, exclusive, or unspecified.",
            "title": "Tax Behavior",
            "type": "string"
          },
          "tiers_mode": {
            "description": "Tiers mode: graduated or volume.",
            "title": "Tiers Mode",
            "type": "string"
          },
          "transform_quantity": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Quantity transformation information.",
            "title": "Transform Quantity",
            "type": "object"
          },
          "type": {
            "description": "Pricing type: one_time or recurring.",
            "title": "Type",
            "type": "string"
          },
          "unit_amount": {
            "description": "Unit amount in smallest currency unit.",
            "title": "Unit Amount",
            "type": "integer"
          },
          "unit_amount_decimal": {
            "description": "Unit amount as decimal string.",
            "title": "Unit Amount Decimal",
            "type": "string"
          }
        },
        "required": ["id", "object", "currency"],
        "title": "Price",
        "type": "object"
      },
      "TaxAmount": {
        "properties": {
