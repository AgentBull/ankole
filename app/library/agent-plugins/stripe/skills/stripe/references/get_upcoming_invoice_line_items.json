{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "Tool to retrieve a paginated list of line items for an upcoming invoice preview. Use when you need to see detailed line items before an invoice is finalized.",
  "inputSchema": {
    "properties": {
      "automatic_tax": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            }
          ]
        },
        "description": "Settings for automatic tax lookup. Must include 'enabled' boolean.",
        "examples": [
          {
            "enabled": true
          }
        ],
        "title": "Automatic Tax",
        "type": "object"
      },
      "coupon": {
        "description": "Coupon ID to apply (deprecated - use discounts instead).",
        "examples": ["SUMMER2023"],
        "title": "Coupon",
        "type": "string"
      },
      "currency": {
        "description": "Three-letter ISO currency code for preview (defaults to customer's currency).",
        "examples": ["usd", "eur", "gbp"],
        "title": "Currency",
        "type": "string"
      },
      "customer": {
        "description": "Customer ID whose upcoming invoice line items to retrieve. Either customer, subscription, or schedule is required.",
        "examples": ["cus_TepioVnDiYEEbz"],
        "title": "Customer",
        "type": "string"
      },
      "discounts": {
        "description": "List of discount objects to apply. Each object must contain one of: coupon, discount, or promotion_code.",
        "examples": [
          [
            {
              "coupon": "SUMMER2023"
            }
          ]
        ],
        "items": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "title": "Discounts",
        "type": "array"
      },
      "ending_before": {
        "description": "Cursor for backward pagination; returns line items before this ID. Mutually exclusive with starting_after.",
        "examples": ["il_0987654321"],
        "title": "Ending Before",
        "type": "string"
      },
      "invoice_items": {
        "description": "Invoice items to add or update (max 250 items).",
        "items": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "type": "object"
              }
            ]
          },
          "type": "object"
        },
        "title": "Invoice Items",
        "type": "array"
      },
      "limit": {
        "description": "Maximum number of line items to return (range: 1-100, default: 10).",
        "examples": [10, 25, 100],
        "title": "Limit",
        "type": "integer"
      },
      "preview_mode": {
        "description": "Preview calculation type: 'next' for next invoice or 'recurring' for recurring totals.",
        "examples": ["next", "recurring"],
        "title": "Preview Mode",
        "type": "string"
      },
      "schedule": {
        "description": "Schedule ID for upcoming invoice line items. Cannot be used with subscription.",
        "examples": ["schedule_1234567890"],
        "title": "Schedule",
        "type": "string"
      },
      "starting_after": {
        "description": "Cursor for forward pagination; returns line items after this ID.",
        "examples": ["il_1234567890"],
        "title": "Starting After",
        "type": "string"
      },
      "subscription": {
        "description": "Subscription ID for upcoming invoice line items. Cannot be used with schedule.",
        "examples": ["sub_1234567890"],
        "title": "Subscription",
        "type": "string"
      }
    },
    "title": "GetUpcomingInvoiceLineItemsRequest",
    "type": "object"
  },
  "name": "get_upcoming_invoice_line_items",
  "outputSchema": {
    "$defs": {
      "DiscountAmount": {
        "properties": {
          "amount": {
            "description": "Discount value in smallest currency unit (cents).",
            "title": "Amount",
            "type": "integer"
          },
          "discount": {
            "description": "Applied discount identifier.",
            "title": "Discount",
            "type": "string"
          }
        },
        "required": ["amount", "discount"],
        "title": "DiscountAmount",
        "type": "object"
      },
      "GetUpcomingInvoiceLineItemsResponse": {
        "properties": {
          "data": {
            "description": "Array of Invoice Line Item objects.",
