              "$ref": "#/$defs/InvoiceLineItem"
            },
            "title": "Data",
            "type": "array"
          },
          "has_more": {
            "description": "Whether more elements are available after this set.",
            "title": "Has More",
            "type": "boolean"
          },
          "object": {
            "description": "String representing the object's type. Always 'list'.",
            "title": "Object",
            "type": "string"
          },
          "url": {
            "description": "URL for accessing this list.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": ["object", "url", "has_more", "data"],
        "title": "GetUpcomingInvoiceLineItemsResponse",
        "type": "object"
      },
      "InvoiceLineItem": {
