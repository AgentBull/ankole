            "description": "Amount in smallest currency unit (cents, etc.).",
            "title": "Amount",
            "type": "integer"
          },
          "amount_excluding_tax": {
            "description": "Amount before tax applied.",
            "title": "Amount Excluding Tax",
            "type": "integer"
          },
          "currency": {
            "description": "Three-letter ISO currency code (lowercase).",
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "description": "Line item description.",
            "title": "Description",
            "type": "string"
          },
          "discount_amounts": {
