                "description": "Subscription line item with pricing.",
                "properties": {
                  "billing_thresholds": {
                    "additionalProperties": {
                      "type": "integer"
                    },
                    "description": "Usage-based thresholds",
                    "title": "Billing Thresholds",
                    "type": "object"
