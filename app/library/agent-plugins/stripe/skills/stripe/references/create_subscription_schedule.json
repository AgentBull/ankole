                      "description": "Stackable discount specification.",
                      "properties": {
                        "coupon": {
                          "description": "Coupon ID",
                          "examples": ["coupon_xxxxxxxxxxxxxx"],
                          "title": "Coupon",
                          "type": "string"
                        },
                        "discount": {
                          "description": "Discount ID",
                          "title": "Discount",
                          "type": "string"
                        },
                        "promotion_code": {
                          "description": "Promotion code ID",
                          "examples": ["promo_xxxxxxxxxxxxxx"],
                          "title": "Promotion Code",
                          "type": "string"
                        }
                      },
                      "title": "PhaseDiscountInput",
                      "type": "object"
                    },
                    "title": "Discounts",
                    "type": "array"
                  },
                  "metadata": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Key-value pairs for this item",
                    "title": "Metadata",
                    "type": "object"
                  },
                  "price": {
                    "description": "Price ID for the subscription item",
                    "examples": ["price_1ShVuAQvM72TjFrbIPUjdtbY"],
