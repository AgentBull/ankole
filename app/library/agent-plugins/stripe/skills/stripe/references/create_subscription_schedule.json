                    "type": "string"
                  },
                  "quantity": {
                    "description": "Quantity of the plan",
                    "title": "Quantity",
                    "type": "integer"
                  },
                  "tax_rates": {
                    "description": "Item tax rates",
                    "examples": [["txr_xxxxxxxxxxxxxx"]],
