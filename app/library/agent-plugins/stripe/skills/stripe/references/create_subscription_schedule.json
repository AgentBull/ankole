{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Tool to create a new subscription schedule for managing subscription changes over time. Use when you need to schedule future subscription modifications, phase transitions, or automate subscription lifecycle management.",
  "inputSchema": {
    "description": "Request model for creating a subscription schedule.",
    "properties": {
      "billing_mode": {
        "additionalProperties": false,
        "description": "Controls prorations and invoice calculation.",
        "properties": {
          "flexible": {
            "additionalProperties": false,
            "description": "Configuration for flexible billing mode.",
            "properties": {
              "proration_discounts": {
                "description": "How proration discounts are displayed. Values: 'included' or 'itemized'",
                "examples": ["included", "itemized"],
                "title": "Proration Discounts",
                "type": "string"
              }
            },
            "required": ["proration_discounts"],
            "title": "BillingModeFlexible",
            "type": "object"
          },
          "type": {
            "description": "Billing mode type. Values: 'classic' or 'flexible' (default: 'flexible')",
            "examples": ["classic", "flexible"],
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["type"],
        "title": "BillingModeInput",
        "type": "object"
      },
      "customer": {
        "description": "Customer identifier for the schedule",
        "examples": ["cus_TepYbUrq51DL85"],
        "title": "Customer",
        "type": "string"
      },
      "customer_account": {
        "description": "Account identifier for the schedule",
        "title": "Customer Account",
        "type": "string"
      },
      "default_settings": {
        "additionalProperties": false,
        "description": "Schedule-wide defaults.",
        "properties": {
          "application_fee_percent": {
            "description": "Platform fee percentage (0-100)",
            "title": "Application Fee Percent",
            "type": "number"
          },
          "automatic_tax": {
            "additionalProperties": false,
            "description": "Automatic tax computation settings.",
            "properties": {
              "enabled": {
                "description": "Whether Stripe automatically computes tax on this subscription",
                "title": "Enabled",
                "type": "boolean"
              },
              "liability": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Account responsible for tax liabilities if automatic tax is enabled",
                "title": "Liability",
                "type": "object"
              }
            },
            "required": ["enabled"],
            "title": "AutomaticTaxInput",
            "type": "object"
          },
          "billing_cycle_anchor": {
            "description": "Billing cycle anchor. Values: 'automatic' or 'phase_start'",
            "examples": ["automatic", "phase_start"],
            "title": "Billing Cycle Anchor",
            "type": "string"
          },
          "billing_thresholds": {
            "additionalProperties": false,
            "description": "Invoice triggers and monetary amounts.",
            "properties": {
              "amount_gte": {
                "description": "Monetary threshold (in smallest currency unit) to trigger billing",
                "title": "Amount Gte",
                "type": "integer"
              },
              "reset_billing_cycle_anchor": {
                "description": "Reset the billing cycle anchor to the threshold bill date",
                "title": "Reset Billing Cycle Anchor",
                "type": "boolean"
              }
            },
            "title": "BillingThresholdsInput",
            "type": "object"
          },
          "collection_method": {
            "description": "Collection method. Values: 'charge_automatically' or 'send_invoice'",
            "examples": ["charge_automatically", "send_invoice"],
            "title": "Collection Method",
            "type": "string"
          },
          "default_payment_method": {
            "description": "Payment method identifier",
            "examples": ["pm_xxxxxxxxxxxxxx"],
            "title": "Default Payment Method",
            "type": "string"
          },
          "description": {
            "description": "Customer-facing subscription explanation (max 500 chars)",
            "title": "Description",
            "type": "string"
          },
          "invoice_settings": {
            "additionalProperties": false,
            "description": "Tax IDs, payment terms, issuer details.",
            "properties": {
              "account_tax_ids": {
                "description": "Tax IDs for invoices",
                "examples": [["txr_xxxxxxxxxxxxxx"]],
                "items": {
                  "type": "string"
                },
                "title": "Account Tax Ids",
                "type": "array"
              },
              "days_until_due": {
                "description": "Days until payment due",
                "title": "Days Until Due",
                "type": "integer"
              },
              "issuer": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Invoice issuer account configuration",
                "title": "Issuer",
                "type": "object"
              }
            },
            "title": "InvoiceSettingsInput",
            "type": "object"
          },
          "on_behalf_of": {
            "description": "Charging account identifier",
            "examples": ["acct_xxxxxxxxxxxxxx"],
            "title": "On Behalf Of",
            "type": "string"
          },
          "transfer_data": {
            "additionalProperties": false,
            "description": "Connected account transfer configuration.",
            "properties": {
              "amount_percent": {
                "description": "Transfer percentage (0-100)",
                "title": "Amount Percent",
                "type": "number"
              },
              "destination": {
                "description": "Destination account ID",
                "examples": ["acct_xxxxxxxxxxxxxx"],
                "title": "Destination",
                "type": "string"
              }
            },
            "required": ["destination"],
            "title": "TransferDataInput",
            "type": "object"
          }
        },
        "title": "DefaultSettingsInput",
        "type": "object"
      },
      "end_behavior": {
        "description": "End behavior. Values: 'release' (continue subscription) or 'cancel' (terminate)",
        "examples": ["release", "cancel"],
        "title": "End Behavior",
        "type": "string"
      },
      "from_subscription": {
        "description": "Migrate existing subscription to schedule",
        "examples": ["sub_xxxxxxxxxxxxxx"],
        "title": "From Subscription",
        "type": "string"
      },
      "metadata": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Custom key-value data",
        "title": "Metadata",
        "type": "object"
      },
      "phases": {
        "description": "Billing phase configurations",
        "items": {
          "description": "Billing phase configuration.",
          "properties": {
            "add_invoice_items": {
              "description": "Additional invoice line items (max 20)",
              "items": {
                "description": "Additional invoice line item.",
                "properties": {
                  "discounts": {
                    "description": "Discounts",
                    "items": {
                      "description": "Stackable discount specification.",
                      "properties": {
                        "coupon": {
                          "description": "Coupon ID",
                          "examples": ["coupon_xxxxxxxxxxxxxx"],
                          "title": "Coupon",
                          "type": "string"
                        },
                        "discount": {
                          "description": "Discount ID",
                          "title": "Discount",
                          "type": "string"
                        },
                        "promotion_code": {
                          "description": "Promotion code ID",
                          "examples": ["promo_xxxxxxxxxxxxxx"],
                          "title": "Promotion Code",
                          "type": "string"
                        }
                      },
                      "title": "PhaseDiscountInput",
                      "type": "object"
                    },
                    "title": "Discounts",
                    "type": "array"
                  },
                  "metadata": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Key-value pairs",
                    "title": "Metadata",
                    "type": "object"
                  },
                  "price": {
                    "description": "Price ID",
                    "examples": ["price_xxxxxxxxxxxxxx"],
                    "title": "Price",
                    "type": "string"
                  },
                  "quantity": {
                    "description": "Quantity",
                    "title": "Quantity",
                    "type": "integer"
                  },
                  "tax_rates": {
                    "description": "Tax rates",
                    "items": {
                      "type": "string"
                    },
                    "title": "Tax Rates",
                    "type": "array"
                  }
                },
                "required": ["price"],
                "title": "AddInvoiceItemInput",
                "type": "object"
              },
              "title": "Add Invoice Items",
              "type": "array"
            },
            "automatic_tax": {
              "additionalProperties": false,
              "description": "Automatic tax computation settings.",
              "properties": {
                "enabled": {
                  "description": "Whether Stripe automatically computes tax on this subscription",
                  "title": "Enabled",
                  "type": "boolean"
                },
                "liability": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Account responsible for tax liabilities if automatic tax is enabled",
                  "title": "Liability",
                  "type": "object"
                }
              },
              "required": ["enabled"],
              "title": "AutomaticTaxInput",
              "type": "object"
            },
            "billing_cycle_anchor": {
              "description": "Phase-specific billing anchor. Values: 'automatic' or 'phase_start'",
              "title": "Billing Cycle Anchor",
              "type": "string"
            },
            "billing_thresholds": {
              "additionalProperties": false,
              "description": "Invoice triggers and monetary amounts.",
              "properties": {
                "amount_gte": {
                  "description": "Monetary threshold (in smallest currency unit) to trigger billing",
                  "title": "Amount Gte",
                  "type": "integer"
                },
                "reset_billing_cycle_anchor": {
                  "description": "Reset the billing cycle anchor to the threshold bill date",
                  "title": "Reset Billing Cycle Anchor",
                  "type": "boolean"
                }
              },
              "title": "BillingThresholdsInput",
              "type": "object"
            },
            "collection_method": {
              "description": "Phase-specific collection method. Values: 'charge_automatically' or 'send_invoice'",
              "title": "Collection Method",
              "type": "string"
            },
            "currency": {
              "description": "ISO 4217 currency code",
              "examples": ["usd", "eur", "gbp"],
              "title": "Currency",
              "type": "string"
            },
            "default_payment_method": {
              "description": "Phase-specific payment method",
              "title": "Default Payment Method",
              "type": "string"
            },
            "default_tax_rates": {
              "description": "Phase-level tax rate defaults",
              "items": {
                "type": "string"
              },
              "title": "Default Tax Rates",
              "type": "array"
            },
            "description": {
              "description": "Phase-specific description",
              "title": "Description",
              "type": "string"
            },
            "discounts": {
              "description": "Stackable discount specifications",
              "items": {
                "description": "Stackable discount specification.",
                "properties": {
                  "coupon": {
                    "description": "Coupon ID",
                    "examples": ["coupon_xxxxxxxxxxxxxx"],
                    "title": "Coupon",
                    "type": "string"
                  },
                  "discount": {
                    "description": "Discount ID",
                    "title": "Discount",
                    "type": "string"
                  },
                  "promotion_code": {
                    "description": "Promotion code ID",
                    "examples": ["promo_xxxxxxxxxxxxxx"],
                    "title": "Promotion Code",
                    "type": "string"
                  }
                },
                "title": "PhaseDiscountInput",
                "type": "object"
              },
              "title": "Discounts",
              "type": "array"
            },
            "end_date": {
              "description": "Phase end time (Unix timestamp)",
              "title": "End Date",
              "type": "integer"
            },
            "invoice_settings": {
              "additionalProperties": false,
              "description": "Tax IDs, payment terms, issuer details.",
              "properties": {
                "account_tax_ids": {
                  "description": "Tax IDs for invoices",
                  "examples": [["txr_xxxxxxxxxxxxxx"]],
                  "items": {
                    "type": "string"
                  },
                  "title": "Account Tax Ids",
                  "type": "array"
                },
                "days_until_due": {
                  "description": "Days until payment due",
                  "title": "Days Until Due",
                  "type": "integer"
                },
                "issuer": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Invoice issuer account configuration",
                  "title": "Issuer",
                  "type": "object"
                }
              },
              "title": "InvoiceSettingsInput",
              "type": "object"
            },
            "items": {
              "description": "Subscription line items with pricing",
