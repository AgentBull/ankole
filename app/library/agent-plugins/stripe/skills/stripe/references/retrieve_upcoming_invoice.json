{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "description": "Tool to preview the upcoming invoice for a customer, showing all pending charges including subscription renewals and invoice items. Use when you need to preview invoice amounts before they are finalized, test the effects of subscription updates including prorations, or estimate future billing.",
  "inputSchema": {
    "description": "Request parameters for previewing an upcoming invoice.",
    "properties": {
      "automatic_tax": {
        "additionalProperties": {
          "type": "boolean"
        },
        "description": "Settings for automatic tax calculation. Must include 'enabled' boolean field.",
        "examples": [
          {
            "enabled": true
          }
        ],
        "title": "Automatic Tax",
        "type": "object"
      },
      "coupon": {
        "description": "The code of the coupon to apply to the invoice preview. If multiple discounts needed, use the discounts parameter instead.",
        "examples": ["SUMMER25", "SAVE10"],
        "title": "Coupon",
        "type": "string"
      },
      "currency": {
        "description": "The currency for the invoice preview. Three-letter ISO currency code. Defaults to customer's currency.",
        "examples": ["usd", "eur", "gbp"],
        "title": "Currency",
        "type": "string"
      },
      "customer": {
        "description": "The identifier of the customer whose upcoming invoice to retrieve. Required if subscription is not specified.",
        "examples": ["cus_NffrFeUfNV2Hib"],
        "title": "Customer",
        "type": "string"
      },
      "customer_details": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Details about the customer used for this invoice preview. Can include address, shipping, and tax information.",
        "title": "Customer Details",
        "type": "object"
      },
      "discounts": {
        "description": "List of discounts to apply. Each discount can have coupon, discount, or promotion_code.",
        "examples": [
          [
            {
              "coupon": "SUMMER25"
            },
            {
              "discount": "di_1234"
            }
          ]
        ],
        "items": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "title": "Discounts",
        "type": "array"
      },
      "invoice_items": {
        "description": "List of invoice items to add or update in the upcoming invoice preview. Maximum 250 items.",
        "items": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "type": "object"
        },
        "title": "Invoice Items",
        "type": "array"
      },
      "issuer": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "The connected account that issues the invoice. Can specify type ('self' or 'account') and account ID.",
        "examples": [
          {
            "type": "self"
          },
          {
            "account": "acct_1234",
            "type": "account"
          }
        ],
        "title": "Issuer",
        "type": "object"
      },
      "on_behalf_of": {
        "description": "The account (if any) for which the funds of the invoice payment are intended. Used with Stripe Connect.",
        "examples": ["acct_1234567890"],
        "title": "On Behalf Of",
        "type": "string"
      },
      "preview_mode": {
        "description": "Determines the preview calculation type. 'next' (default) calculates the next invoice with all items. 'recurring' estimates long-term recurring bill.",
        "examples": ["next", "recurring"],
        "title": "Preview Mode",
        "type": "string"
      },
      "schedule": {
        "description": "The identifier of the subscription schedule for which you'd like to retrieve the upcoming invoice. Cannot be combined with subscription or subscription_details parameters.",
        "examples": ["sub_sched_1234"],
        "title": "Schedule",
        "type": "string"
      },
      "schedule_details": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "type": "object"
              },
              "type": "array"
            }
          ]
        },
        "description": "Details for schedule creation or modification to preview. Include phases, end_behavior, and proration_behavior.",
        "title": "Schedule Details",
        "type": "object"
      },
      "subscription": {
        "description": "The identifier of the subscription for which you'd like to retrieve the upcoming invoice. If not specified, uses the customer's default subscription.",
        "examples": ["sub_1ShW2DQvM72TjFrb20tP6wRp"],
        "title": "Subscription",
        "type": "string"
      },
      "subscription_billing_cycle_anchor": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "For new subscriptions, billing cycle anchor. Can be 'now', 'unchanged', or a Unix timestamp.",
        "examples": ["now", "unchanged", 1609459200],
        "title": "Subscription Billing Cycle Anchor"
      },
      "subscription_cancel_at": {
        "description": "Unix timestamp at which the subscription should be canceled. Used to preview the invoice that will be generated if the subscription is canceled at this time.",
        "examples": [1735689600],
        "title": "Subscription Cancel At",
        "type": "integer"
      },
      "subscription_cancel_at_period_end": {
        "description": "Boolean indicating whether the subscription should cancel at the end of the current period.",
        "examples": [true, false],
        "title": "Subscription Cancel At Period End",
        "type": "boolean"
      },
      "subscription_cancel_now": {
        "description": "Boolean to simulate immediate cancellation of the subscription.",
        "examples": [true, false],
        "title": "Subscription Cancel Now",
        "type": "boolean"
      },
      "subscription_default_tax_rates": {
        "description": "List of tax rate IDs to apply to the subscription items in this preview.",
        "examples": [["txr_1234", "txr_5678"]],
        "items": {
          "type": "string"
        },
        "title": "Subscription Default Tax Rates",
        "type": "array"
      },
      "subscription_details": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "type": "object"
              },
              "type": "array"
            }
          ]
        },
        "description": "Subscription creation or modification parameters to preview. Can include items, proration_behavior, proration_date, billing_cycle_anchor, trial_end, etc.",
        "title": "Subscription Details",
        "type": "object"
      },
      "subscription_items": {
        "description": "List of subscription items for subscription updates. Each item can have id, deleted, price, quantity, etc.",
        "items": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "type": "object"
        },
        "title": "Subscription Items",
        "type": "array"
      },
      "subscription_proration_behavior": {
        "description": "How to handle prorations when updating subscriptions. Can be 'create_prorations', 'none', or 'always_invoice'.",
        "examples": ["create_prorations", "none", "always_invoice"],
        "title": "Subscription Proration Behavior",
        "type": "string"
      },
      "subscription_proration_date": {
        "description": "Unix timestamp to use for proration calculations. Important: Use this same value when doing the actual subscription update to ensure matching prorations.",
        "examples": [1609459200],
        "title": "Subscription Proration Date",
        "type": "integer"
      },
      "subscription_resume_at": {
        "description": "For paused subscriptions, when to resume. Can be 'now'.",
        "examples": ["now"],
        "title": "Subscription Resume At",
        "type": "string"
      },
      "subscription_start_date": {
        "description": "Unix timestamp for when the subscription should start.",
        "examples": [1609459200],
        "title": "Subscription Start Date",
        "type": "integer"
      },
      "subscription_trial_end": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "Trial end for the subscription. Can be 'now' or a Unix timestamp.",
        "examples": ["now", 1609459200],
        "title": "Subscription Trial End"
      },
      "subscription_trial_from_plan": {
        "description": "Boolean indicating if a default trial from the plan should be applied.",
        "examples": [true, false],
        "title": "Subscription Trial From Plan",
        "type": "boolean"
      }
    },
    "title": "RetrieveUpcomingInvoiceRequest",
    "type": "object"
  },
  "name": "retrieve_upcoming_invoice",
  "outputSchema": {
