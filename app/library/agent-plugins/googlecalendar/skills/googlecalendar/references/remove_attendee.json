  "description": "Removes an attendee from a specified event in a Google Calendar; the calendar and event must exist. Concurrent calls on the same event can overwrite attendee lists — apply changes sequentially per event.",
  "inputSchema": {
    "properties": {
      "attendee_email": {
        "description": "Email address of the attendee to remove. Must match an attendee email present on the event. If no match is found, the attendee was already removed or was never on the event.",
        "examples": ["john@gmail.com"],
        "format": "email",
        "human_parameter_description": "The email address of the person you want to remove from the event. Make sure it matches an attendee already on the event.",
        "human_parameter_name": "Attendee Email",
        "title": "Attendee Email",
        "type": "string"
      },
      "calendar_id": {
        "default": "primary",
        "description": "Identifier of the Google Calendar to which the event belongs; 'primary' signifies the user's main calendar.",
        "human_parameter_description": "Choose which calendar the event belongs to. Use 'primary' for your main Google Calendar, or enter another calendar's ID if the event is on a different calendar.",
        "human_parameter_name": "Calendar ID",
        "title": "Calendar Id",
        "type": "string"
      },
      "event_id": {
        "description": "Unique identifier of the event. For recurring events, target the master series ID or a specific instance ID; removing an attendee from one instance does not affect other instances in the series.",
        "human_parameter_description": "The unique ID of the event you want to edit by removing an attendee. You can copy this from a prior event creation or list/search step.",
        "human_parameter_name": "Event ID",
        "title": "Event Id",
        "type": "string"
      }
    },
    "required": ["event_id", "attendee_email"],
    "title": "RemoveAttendeeRequest",
    "type": "object"
  },
