<mjml lang="<%= @lang %>">
  <mj-head>
    <mj-title><%= @subject %></mj-title>
    <mj-preview><%= @preview %></mj-preview>
    <mj-attributes>
      <mj-all font-family='-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans", "Microsoft YaHei", "Malgun Gothic", "Helvetica Neue", Arial, sans-serif' />
      <mj-text padding="0" font-size="15px" line-height="1.6" color="#343637" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style>
      body {
        background-color: #FFFFFF;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      .ankole-card {
        border: 1px solid #E5E4E1;
        border-radius: 6px;
        box-shadow: 0 2px 24px rgba(24, 25, 26, 0.05);
        background-color: #FFFFFF;
      }
      .ankole-link {
        color: #E10059;
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .ankole-cta {
        display: inline-block;
        padding: 11px 22px;
        background-color: #E10059;
        color: #FFFFFF !important;
        border-radius: 4px;
        font-size: 15px;
        font-weight: 600;
        line-height: 1.4;
        text-decoration: none !important;
      }
      @media only screen and (max-width: 600px) {
        .ankole-outer-spacer td {
          height: 16px !important;
          line-height: 16px !important;
        }
        .ankole-card {
          border: 0 !important;
          border-radius: 0 !important;
          box-shadow: none !important;
        }
        .ankole-card > table > tbody > tr > td {
          padding: 8px 24px 24px 24px !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#FFFFFF" width="600px">
    <mj-section css-class="ankole-outer-spacer">
      <mj-column>
        <mj-spacer height="28px" />
      </mj-column>
    </mj-section>

    <mj-wrapper css-class="ankole-card" background-color="#FFFFFF" border="1px solid #E5E4E1" border-radius="6px" padding="32px 42px">
      <mj-section padding="0 0 22px 0">
        <mj-column>
          <mj-text>
            <table role="presentation" border="0" cellpadding="0" cellspacing="0">
              <tr>
                <td width="34" height="34" valign="middle" style="width:34px;height:34px;vertical-align:middle;font-size:0;line-height:0;">
                  <img src="cid:ankole-logo.png" alt="" width="34" height="34" border="0" style="display:block;width:34px;height:34px;border:0;border-radius:7.5px;" />
                </td>
                <td style="padding-left:10px;vertical-align:middle;">
                  <span style="color:#18191A;font-size:16px;font-weight:600;letter-spacing:-0.015em;line-height:1.2;">Ankole</span>
                </td>
              </tr>
            </table>
          </mj-text>
        </mj-column>
      </mj-section>

      <%= @inner_content %>

      <mj-section padding="28px 0 0 0">
        <mj-column>
          <mj-divider border-width="1px" border-style="solid" border-color="#E5E4E1" padding="0 0 18px 0" />
          <mj-text font-size="13px" line-height="1.5" color="#87898A">
            <span style="color:#636566;font-weight:500;">Ankole</span>
            <span style="color:#CBCAC7;padding:0 6px;">&middot;</span>
            <span><%= @footer %></span>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section css-class="ankole-outer-spacer">
      <mj-column>
        <mj-spacer height="28px" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
