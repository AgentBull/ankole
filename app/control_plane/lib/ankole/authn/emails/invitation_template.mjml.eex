<mj-section>
  <mj-column>
    <mj-text padding="0 0 12px 0">
      <h1 style="margin:0;font-size:22px;font-weight:600;line-height:1.3;letter-spacing:-0.015em;color:#424242;"><%= @heading %></h1>
    </mj-text>
    <mj-text padding="0 0 24px 0" font-size="15px" line-height="1.6" color="#424242">
      <p style="margin:0;"><%= @intro %></p>
    </mj-text>
    <mj-text padding="0 0 24px 0">
      <a href="<%= @url %>" class="ankole-cta" style="display:inline-block;padding:11px 22px;background-color:#FF4669;color:#FFFFFF;border-radius:4px;font-size:15px;font-weight:600;line-height:1.4;text-decoration:none;"><%= @cta %></a>
    </mj-text>
    <mj-text padding="0 0 18px 0">
      <div style="width:42px;height:1px;line-height:1px;font-size:1px;background-color:#D3D3D3;">&nbsp;</div>
    </mj-text>
    <mj-text padding="0 0 16px 0" font-size="13px" line-height="1.55" color="#5E5E5E">
      <p style="margin:0 0 4px 0;"><%= @fallback_label %></p>
      <p style="margin:0;word-break:break-all;"><a href="<%= @url %>" class="ankole-link" style="color:#FF4669;text-decoration:underline;text-underline-offset:3px;"><%= @url %></a></p>
    </mj-text>
    <mj-text padding="0" font-size="13px" line-height="1.55" color="#5E5E5E">
      <p style="margin:0;"><%= @ignore %></p>
    </mj-text>
  </mj-column>
</mj-section>
