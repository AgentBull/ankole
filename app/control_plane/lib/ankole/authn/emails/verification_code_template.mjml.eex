<mj-section>
  <mj-column>
    <mj-text padding="0 0 12px 0">
      <h1 style="margin:0;font-size:22px;font-weight:600;line-height:1.3;letter-spacing:-0.015em;color:#18191A;"><%= @heading %></h1>
    </mj-text>
    <mj-text padding="0 0 22px 0" font-size="15px" line-height="1.6" color="#343637">
      <p style="margin:0;"><%= @intro %></p>
    </mj-text>
    <mj-text padding="0 0 22px 0">
      <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="background-color:#F4F4F2;border:1px solid #E5E4E1;border-radius:6px;">
        <tr>
          <td align="center" style="padding:18px 24px;text-align:center;">
            <span style="display:inline-block;font-family:ui-monospace,SFMono-Regular,'SF Mono',Menlo,Consolas,'Liberation Mono',monospace;font-size:28px;font-weight:600;line-height:1.2;letter-spacing:0.24em;padding-left:0.24em;color:#18191A;"><%= @code %></span>
          </td>
        </tr>
      </table>
    </mj-text>
    <mj-text padding="0 0 6px 0" font-size="13px" line-height="1.55" color="#636566">
      <p style="margin:0;"><%= @expires %></p>
    </mj-text>
    <mj-text padding="0" font-size="13px" line-height="1.55" color="#636566">
      <p style="margin:0;"><%= @ignore %></p>
    </mj-text>
  </mj-column>
</mj-section>
