# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=ankole-control-plane:0.1.0

FROM ${BASE_IMAGE}

WORKDIR /app

COPY --chown=ankole:ankole internals/skills ./internals/skills
COPY --chown=ankole:ankole internals/agent-plugins ./app/library/agent-plugins

ENV ANKOLE_INTERNAL_SKILLS_ROOT=/app/internals/skills
