#!/bin/sh
# Distributed Erlang facts for one control-plane node.
#
# Every control-plane Pod runs one named node. DNSCluster joins the nodes that
# the headless Service lists, and they must share one basename and one cookie.
# The server node (start, start_iex, daemon, daemon_iex) listens on a fixed
# distribution port, so a NetworkPolicy can allow that port between Pods. A
# client node (rpc, remote, stop, restart, pid) starts in the same container
# while the server node uses that port, so the client node takes a free port.
# POD_IP comes from the Kubernetes Downward API. Without it, as in Docker
# Compose, the node name holds the loopback address. A node named for the
# loopback address answers there only, so it also binds EPMD and the
# distribution port to the loopback interface: a container that shares the
# network, such as a Worker that runs Agent-driven commands, cannot reach
# them. A routable RELEASE_NODE binds every interface, which clustering needs.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
export RELEASE_NODE="${RELEASE_NODE:-ankole@${POD_IP:-127.0.0.1}}"
export ANKOLE_DIST_PORT="${ANKOLE_DIST_PORT:-9100}"
# A large container file limit makes ERTS reserve a large port table.
# Use its normal port limit. ERL_FLAGS can override this default.
export ERL_AFLAGS="${ERL_AFLAGS:-} +Q 65536"
case "$RELEASE_NODE" in
  *@127.0.0.1)
    export ERL_EPMD_ADDRESS=127.0.0.1
    export ERL_AFLAGS="${ERL_AFLAGS:-} -kernel inet_dist_use_interface {127,0,0,1}"
    ;;
esac
case "$RELEASE_COMMAND" in
  start | start_iex | daemon | daemon_iex)
    export ERL_AFLAGS="${ERL_AFLAGS:-} -kernel inet_dist_listen_min ${ANKOLE_DIST_PORT} inet_dist_listen_max ${ANKOLE_DIST_PORT}"
    ;;
esac
