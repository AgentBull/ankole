{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "type-check": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/plugins/*/lib/**",
        "$TURBO_ROOT$/internals/plugins/*/lib/**",
        "$TURBO_ROOT$/app/kernel/{Cargo.toml,Cargo.lock,build.rs,mix.exs,mix.lock}",
        "$TURBO_ROOT$/app/kernel/{lib,src,proto}/**",
        "$TURBO_ROOT$/libs/*_openapi/mix.{exs,lock}",
        "$TURBO_ROOT$/libs/*_openapi/{lib,config}/**",
        "$TURBO_ROOT$/tools/e2e/support/**",
        "$TURBO_ROOT$/tools/fake-feishu/platform/**",
        "$TURBO_ROOT$/internals/control_plane/**",
        "$TURBO_ROOT$/internals/webapps/**",
        "$TURBO_ROOT$/internals/locales/**",
        "$TURBO_ROOT$/app/webapps/scripts/**",
        "$TURBO_ROOT$/app/webapps/entries.json"
      ],
      "env": [
        "ANKOLE_EDITION"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/plugins/*/lib/**",
        "$TURBO_ROOT$/internals/plugins/*/lib/**",
        "$TURBO_ROOT$/app/kernel/{Cargo.toml,Cargo.lock,build.rs,mix.exs,mix.lock}",
        "$TURBO_ROOT$/app/kernel/{lib,src,proto}/**",
        "$TURBO_ROOT$/libs/*_openapi/mix.{exs,lock}",
        "$TURBO_ROOT$/libs/*_openapi/{lib,config}/**",
        "$TURBO_ROOT$/tools/e2e/support/**",
        "$TURBO_ROOT$/tools/fake-feishu/platform/**",
        "$TURBO_ROOT$/app/library/**",
        "$TURBO_ROOT$/internals/control_plane/**",
        "$TURBO_ROOT$/internals/webapps/**",
        "$TURBO_ROOT$/internals/locales/**",
        "$TURBO_ROOT$/app/webapps/scripts/**",
        "$TURBO_ROOT$/app/webapps/entries.json"
      ],
      "env": [
        "ANKOLE_EDITION"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/plugins/*/lib/**",
        "$TURBO_ROOT$/internals/plugins/*/lib/**",
        "$TURBO_ROOT$/app/kernel/{Cargo.toml,Cargo.lock,build.rs,mix.exs,mix.lock}",
        "$TURBO_ROOT$/app/kernel/{lib,src,proto}/**",
        "$TURBO_ROOT$/libs/*_openapi/mix.{exs,lock}",
        "$TURBO_ROOT$/libs/*_openapi/{lib,config}/**",
        "$TURBO_ROOT$/tools/e2e/support/**",
        "$TURBO_ROOT$/tools/fake-feishu/platform/**",
        ".credo.exs",
        "credo/**",
        "$TURBO_ROOT$/internals/control_plane/**",
        "$TURBO_ROOT$/internals/webapps/**",
        "$TURBO_ROOT$/internals/locales/**",
        "$TURBO_ROOT$/app/webapps/scripts/**",
        "$TURBO_ROOT$/app/webapps/entries.json"
      ],
      "env": [
        "ANKOLE_EDITION"
      ]
    },
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/plugins/*/lib/**",
        "$TURBO_ROOT$/internals/plugins/*/lib/**",
        "$TURBO_ROOT$/app/kernel/{Cargo.toml,Cargo.lock,build.rs,mix.exs,mix.lock}",
        "$TURBO_ROOT$/app/kernel/{lib,src,proto}/**",
        "$TURBO_ROOT$/libs/*_openapi/mix.{exs,lock}",
        "$TURBO_ROOT$/libs/*_openapi/{lib,config}/**",
        "$TURBO_ROOT$/app/webapps/{auth,common,console,entrypoints,openapi,public,setup,pod}/**",
        "$TURBO_ROOT$/app/webapps/{package.json,vite.config.ts,tsconfig.json,openapi-ts.config.ts}",
        "$TURBO_ROOT$/app/webapps/.env*",
        "$TURBO_ROOT$/app/locales/**",
        "$TURBO_ROOT$/libs/{uikit,ankole-editor,applet-sdk}/src/**",
        "$TURBO_ROOT$/libs/ankole-editor/patches/**",
        "$TURBO_ROOT$/libs/{uikit,ankole-editor,applet-sdk}/{package.json,tsconfig.json}",
        "$TURBO_ROOT$/tools/openapi-client-generator/package.json",
        "$TURBO_ROOT$/internals/control_plane/**",
        "$TURBO_ROOT$/internals/webapps/**",
        "$TURBO_ROOT$/internals/locales/**",
        "$TURBO_ROOT$/app/webapps/scripts/**",
        "$TURBO_ROOT$/app/webapps/entries.json"
      ],
      "env": [
        "ANKOLE_EDITION"
      ],
      "cache": false,
      "outputs": []
    }
  }
}
