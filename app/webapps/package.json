{
  "name": "@ankole/webapps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --config vite.config.ts",
    "build": "bun run openapi:generate && bun run type-check && bun --bun vite build --config vite.config.ts",
    "test": "bun test common console setup/state auth/state",
    "type-check": "bun check -p tsconfig.json --noEmit",
    "lint": "bun check -p tsconfig.json --noEmit",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "openapi:generate": "bun run --filter @ankole/openapi-client-generator generate && oxfmt console/api/generated"
  },
  "dependencies": {
    "@agentbull/active-support": "^1.6.0",
    "@ankole/uikit": "workspace:*",
    "@formisch/react": "^1.1.0",
    "@preact/signals-react": "3.12.0",
    "@remixicon/react": "4.9.0",
    "@tanstack/react-query": "5.108.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "any-ascii": "0.3.3",
    "i18next": "27.2.1",
    "i18next-mf2": "2.1.1",
    "json-edit-react": "2.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-helmet-async": "3.1.0",
    "react-i18next": "18.0.2",
    "react-markdown": "^10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "^4.0.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
