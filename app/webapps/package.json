{
  "name": "@ankole/webapps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --config vite.config.ts",
    "build": "bun run openapi:generate && bun run type-check && bun run build:bundle",
    "build:bundle": "bun --bun vite build --config vite.config.ts",
    "test": "bun run scripts/test.ts",
    "test:browser": "bun --bun playwright test",
    "type-check": "bun run scripts/type-check.ts",
    "lint": "bun run type-check",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "openapi:generate": "bun run --filter @ankole/openapi-client-generator generate && oxfmt console/api/v2/generated console/api/v2-site/generated common/api/generated pod/api/generated && if [ \"$ANKOLE_EDITION\" = saas ]; then cd ../../internals && oxfmt webapps/api/generated webapps/pod-api/generated webapps/site-api/generated; fi",
    "test:pod": "bun --bun playwright test --config playwright.pod.config.ts"
  },
  "dependencies": {
    "@agentbull/active-support": "^1.6.0",
    "@ankole/applet-sdk": "workspace:*",
    "@ankole/block-editor": "workspace:*",
    "@ankole/uikit": "workspace:*",
    "@office-kit/pptx": "0.28.0",
    "@office-kit/pptx-preview": "0.21.0",
    "@openfeature/react-sdk": "1.4.1",
    "@openfeature/web-sdk": "1.10.0",
    "@preact/signals-react": "3.12.0",
    "@remixicon/react": "4.9.0",
    "@tanstack/db": "1.0.0-rc.1",
    "@tanstack/react-db": "1.0.0-rc.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.23",
    "any-ascii": "0.3.3",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "i18next": "26.5.11",
    "i18next-mf2": "2.1.1",
    "json-edit-react": "2.0.5",
    "katex": "0.19.1",
    "mdast-util-from-markdown": "2.1.0",
    "motion": "14.8.0",
    "pele": "1.12.0",
    "phoenix": "1.8.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-helmet-async": "3.0.0",
    "react-i18next": "17.1.9",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.5.0",
    "use-stick-to-bottom": "1.1.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/mdast": "4.0.4",
    "@types/phoenix": "^1.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "web-vitals": "6.2.3"
  }
}
