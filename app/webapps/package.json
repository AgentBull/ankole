{
  "name": "@ankole/webapps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --config vite.config.ts",
    "build": "bun run openapi:generate && bun run type-check && bun --bun vite build --config vite.config.ts",
    "test": "bun test common console/state setup/state",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "openapi:generate": "bun run --filter @ankole/openapi-client-generator generate && oxfmt console/api/generated"
  },
  "dependencies": {
    "@agentbull/active-support": "^1.6.0",
    "@ankole/uikit": "workspace:*",
    "@formisch/react": "^1.0.0-rc.0",
    "@preact/signals-react": "3.11.1",
    "@remixicon/react": "4.9.0",
    "@tanstack/react-query": "5.101.4",
    "date-fns": "^4.4.0",
    "i18next": "26.3.6",
    "i18next-mf2": "1.0.0",
    "json-edit-react": "1.30.2",
    "messageformat": "4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-helmet-async": "3.0.0",
    "react-i18next": "17.0.11",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.0",
    "remark-gfm": "^4.0.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "latest",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
