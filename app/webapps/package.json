{
  "name": "@ankole/webapps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --config vite.config.ts",
    "build": "bun run openapi:generate && bun run type-check && bun --bun vite build --config vite.config.ts",
    "test": "bun run scripts/test.ts",
    "test:browser": "bun --bun playwright test",
    "type-check": "bun run scripts/type-check.ts",
    "lint": "bun run type-check",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "openapi:generate": "bun run --filter @ankole/openapi-client-generator generate && oxfmt console/api/generated common/api/generated",
    "build:garfish": "bun run integration/garfish/build.ts",
    "test:garfish": "bun run build:garfish && bun --bun playwright test --config playwright.garfish.config.ts",
    "test:pod": "bun --bun playwright test --config playwright.pod.config.ts"
  },
  "dependencies": {
    "@agentbull/active-support": "^1.6.0",
    "@ankole/applet-sdk": "workspace:*",
    "@ankole/block-editor": "workspace:*",
    "@ankole/uikit": "workspace:*",
    "@formisch/react": "^1.1.0",
    "@garfish/browser-vm": "1.19.12",
    "@garfish/core": "1.19.12",
    "@garfish/css-scope": "1.19.12",
    "@office-kit/pptx": "0.24.1",
    "@office-kit/pptx-preview": "0.16.0",
    "@preact/signals-react": "3.12.0",
    "@remixicon/react": "4.9.0",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-virtual": "3.14.21",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "any-ascii": "0.3.3",
    "i18next": "26.4.7",
    "i18next-mf2": "1.0.0",
    "json-edit-react": "2.0.4",
    "mdast-util-from-markdown": "2.1.0",
    "phoenix": "1.8.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-helmet-async": "3.0.0",
    "react-i18next": "17.0.19",
    "react-markdown": "^10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "^4.0.1",
    "use-stick-to-bottom": "1.1.6",
    "valibot": "^1.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/mdast": "4.0.4",
    "@types/phoenix": "^1.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
