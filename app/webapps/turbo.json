{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/app/locales/**",
        "$TURBO_ROOT$/tools/openapi-client-generator/package.json",
        "$TURBO_ROOT$/internals/webapps/**",
        "$TURBO_ROOT$/internals/locales/**"
      ],
      "env": ["ANKOLE_EDITION"],
      "cache": false
    },
    "type-check": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/app/locales/**",
        "$TURBO_ROOT$/internals/webapps/**",
        "$TURBO_ROOT$/internals/locales/**"
      ],
      "env": ["ANKOLE_EDITION"]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/app/locales/**",
        "$TURBO_ROOT$/internals/webapps/**",
        "$TURBO_ROOT$/internals/locales/**"
      ],
      "env": ["ANKOLE_EDITION"]
    },
    "lint": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/app/locales/**",
        "$TURBO_ROOT$/internals/webapps/**",
        "$TURBO_ROOT$/internals/locales/**"
      ],
      "env": ["ANKOLE_EDITION"]
    }
  }
}
